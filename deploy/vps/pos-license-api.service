[Unit]
Description=BalanzaPro POS License API
After=network.target

[Service]
Type=exec
User=pos-license-api
Group=pos-license-api
WorkingDirectory=/var/lib/pos-license-api
EnvironmentFile=/etc/pos-license-api/pos-license-api.env
ExecStart=/opt/pos-license-api/current/Pos.Licensing.Vps
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/pos-license-api

[Install]
WantedBy=multi-user.target
