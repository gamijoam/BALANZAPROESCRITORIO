<Window Language="es-VE" x:Class="Pos.Desktop.CloseCashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arqueo y cierre de caja" Width="600" Height="560" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#F1F4F8">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="ARQUEO Y CIERRE DE CAJA" Foreground="#173F78" FontSize="23" FontWeight="Bold"/><TextBlock Text="Compara el efectivo contado con el esperado antes de cerrar." Foreground="#63758B" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="DÓLARES · USD" Foreground="#173F78" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Efectivo esperado" Foreground="#63758B" FontSize="12" Margin="0,12,0,2"/>
                    <TextBlock x:Name="ExpectedUsdLabel" FontSize="20" FontWeight="Bold" Foreground="#172B45"/>
                    <TextBlock Text="Efectivo contado" Foreground="#63758B" FontSize="12" Margin="0,12,0,4"/>
                    <TextBox x:Name="CountedUsdBox" Text="0,00" Height="42" Padding="9" FontSize="18"/>
                    <TextBlock x:Name="DifferenceUsdLabel" Foreground="#52677F" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8" Padding="15" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="BOLÍVARES · VES" Foreground="#173F78" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Efectivo esperado" Foreground="#63758B" FontSize="12" Margin="0,12,0,2"/>
                    <TextBlock x:Name="ExpectedVesLabel" FontSize="20" FontWeight="Bold" Foreground="#172B45"/>
                    <TextBlock Text="Efectivo contado" Foreground="#63758B" FontSize="12" Margin="0,12,0,4"/>
                    <TextBox x:Name="CountedVesBox" Text="0,00" Height="42" Padding="9" FontSize="18"/>
                    <TextBlock x:Name="DifferenceVesLabel" Foreground="#52677F" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="ErrorLabel" Grid.Row="2" Foreground="#B43B42" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="95" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Cerrar turno" Width="125" Height="40" Background="#B43B42" Foreground="White" FontWeight="Bold" Click="Close_Click"/></StackPanel>
    </Grid>
</Window>

