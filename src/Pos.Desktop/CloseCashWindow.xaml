<Window Language="es-VE" x:Class="Pos.Desktop.CloseCashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arqueo y cierre de caja" Width="470" Height="410" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F1F4F8">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="ARQUEO Y CIERRE DE CAJA" Foreground="#173F78" FontSize="23" FontWeight="Bold"/><TextBlock Text="Cuenta el efectivo disponible en cada moneda por separado." Foreground="#63758B" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Efectivo contado en dólares (USD)" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="CountedUsdBox" Text="0,00" Height="42" Padding="9" FontSize="18"/>
            <TextBlock Text="Efectivo contado en bolívares (VES)" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBox x:Name="CountedVesBox" Text="0,00" Height="42" Padding="9" FontSize="18"/>
            <TextBlock x:Name="ErrorLabel" Foreground="#B43B42" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="95" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Cerrar turno" Width="125" Height="40" Background="#B43B42" Foreground="White" FontWeight="Bold" Click="Close_Click"/></StackPanel>
    </Grid>
</Window>

