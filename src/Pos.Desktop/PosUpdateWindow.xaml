<Window x:Class="Pos.Desktop.PosUpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizar POS · BalanzaPro" Language="es-VE" Width="780" Height="560" MinWidth="650" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}">
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top" Background="#102D50" CornerRadius="9" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Actualizar punto de venta" Foreground="White" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="Elige una versión en Internet o usa un ZIP oficial guardado en este equipo." Foreground="#D7E3F2" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D2DEEC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Consulta las versiones disponibles o elige un archivo local." Foreground="#344B67" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="CheckButton" Content="Buscar actualizaciones" Padding="14,8" Margin="0,0,8,0" Click="Check_Click"/>
                    <Button x:Name="LocalButton" Content="Elegir ZIP sin Internet" Padding="14,8" Margin="0,0,8,0" Click="Local_Click"/>
                    <Button x:Name="InstallButton" Content="Preparar actualización" Padding="14,8" Margin="0,0,8,0" Background="#0867D5" Foreground="White" IsEnabled="False" Click="Install_Click"/>
                    <Button Content="Cerrar" Padding="14,8" Click="Close_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="CurrentVersionText" FontSize="16" FontWeight="SemiBold" Foreground="#102D50" Margin="2,2,0,12"/>
            <ListBox x:Name="VersionsList" Grid.Row="1" Height="120" SelectionChanged="VersionsList_SelectionChanged" DisplayMemberPath="Title"/>
            <Border Grid.Row="2" Background="White" BorderBrush="#D2DEEC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="NotesText" Foreground="#344B67" TextWrapping="Wrap" Text="Selecciona una versión para ver sus cambios."/></ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
