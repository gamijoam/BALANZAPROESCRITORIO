<Window x:Class="Pos.Desktop.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BalanzaPro" Width="500" Height="440" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" AllowsTransparency="True"
        Background="Transparent" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#102D50" CornerRadius="18" Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="250"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="BALANZAPRO" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Punto de venta" Foreground="#D7E3F2" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
            <Grid x:Name="LogoStage" Grid.Row="1" Width="250" Height="250" ClipToBounds="True" HorizontalAlignment="Center">
                <Image x:Name="ScalePart" Width="250" Height="125" VerticalAlignment="Top" Stretch="Fill" Opacity="0">
                    <Image.RenderTransform><TranslateTransform x:Name="ScaleTransform" Y="-150"/></Image.RenderTransform>
                </Image>
                <Image x:Name="RegisterPart" Width="250" Height="125" VerticalAlignment="Bottom" Stretch="Fill" Opacity="0">
                    <Image.RenderTransform><TranslateTransform x:Name="RegisterTransform" Y="150"/></Image.RenderTransform>
                </Image>
            </Grid>
            <TextBlock x:Name="StartupStatus" Grid.Row="2" Text="Preparando el punto de venta…" Foreground="#D7E3F2"
                       FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,7,0,14"/>
            <ProgressBar Grid.Row="3" Width="220" Height="7" HorizontalAlignment="Center" IsIndeterminate="True"
                         Background="#294A70" Foreground="#39A6FF" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
