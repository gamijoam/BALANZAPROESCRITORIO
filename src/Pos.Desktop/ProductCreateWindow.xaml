<Window Language="es-VE" x:Class="Pos.Desktop.ProductCreateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear producto" Width="1500" Height="900" MinWidth="1000" MinHeight="680" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="18,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ficha del nuevo producto" Foreground="White" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Registra la información, los precios, la existencia inicial y la foto en una sola pantalla." Foreground="#D7E3F2" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1B416D" CornerRadius="7" Padding="12,8" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="NUEVO PRODUCTO" Foreground="#D7E3F2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="Datos iniciales" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock Text="Datos del producto" Foreground="#132D4F" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Identifica el artículo y define cómo se cuentan sus existencias." Foreground="#52677F" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,12">
                            <TextBlock Text="SKU / código" FontWeight="SemiBold"/>
                            <TextBox x:Name="SkuBox" Height="40" Padding="9" Margin="0,4,0,0" AutomationProperties.Name="Código SKU del producto"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Nombre del producto" FontWeight="SemiBold"/>
                            <TextBox x:Name="NameBox" Height="40" Padding="9" Margin="0,4,0,0" AutomationProperties.Name="Nombre del producto"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Unidad base del inventario" FontWeight="SemiBold"/>
                                <ComboBox x:Name="BaseUnitBox" Height="40" Margin="0,4,0,0" DisplayMemberPath="DisplayLabel" SelectionChanged="BaseUnitBox_SelectionChanged" AutomationProperties.Name="Unidad base del producto"/>
                                <TextBlock Text="El inventario se contará en esta unidad. Las formas de venta, como par o caja, se configuran después en la ficha." Foreground="#52677F" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Agregar tipo" Height="40" Padding="13,4" Margin="10,22,0,0" VerticalAlignment="Top" Click="CreateUnit_Click" ToolTip="Crear una nueva unidad base para el inventario"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1" Grid.Column="1" Background="#F4F7FB" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Foto del producto" FontWeight="SemiBold" Foreground="#132D4F" Margin="0,0,0,8"/>
                            <Border Grid.Row="1" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="6" MinHeight="115" Padding="8">
                                <Grid>
                                    <Image x:Name="ProductImagePreview" Stretch="Uniform" MaxHeight="190" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock x:Name="ImagePlaceholder" Text="Sin foto seleccionada" Foreground="#52677F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Seleccionar foto" Height="38" Padding="12,4" Click="SelectImage_Click" Style="{StaticResource PosWindow.PrimaryButton}"/>
                                <TextBlock x:Name="ImageNameLabel" Grid.Column="1" Text="Sin foto" Foreground="#52677F" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Precios e impuestos" Foreground="#132D4F" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Precio 1 es el precio principal. Los precios 2 y 3 son opcionales." Foreground="#52677F" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Precio 1 · principal" FontWeight="SemiBold"/>
                            <TextBox x:Name="PriceBox" Height="40" Padding="9" Margin="0,4,0,0" AutomationProperties.Name="Precio 1 del producto"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0">
                            <TextBlock Text="Precio 2 · opcional" FontWeight="SemiBold"/>
                            <TextBox x:Name="Price2Box" Height="40" Padding="9" Margin="0,4,0,0" AutomationProperties.Name="Precio 2 del producto"/>
                            <TextBlock Text="Puedes configurarlo después." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0">
                            <TextBlock Text="Precio 3 · opcional" FontWeight="SemiBold"/>
                            <TextBox x:Name="Price3Box" Height="40" Padding="9" Margin="0,4,0,0" AutomationProperties.Name="Precio 3 del producto"/>
                            <TextBlock Text="Puedes configurarlo después." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="10,0,0,0">
                            <TextBlock Text="Moneda de los precios" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CurrencyBox" Height="40" SelectedIndex="0" Margin="0,4,0,0" AutomationProperties.Name="Moneda del precio">
                                <ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/>
                            </ComboBox>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Tratamiento de impuesto" FontWeight="SemiBold"/>
                                <ComboBox x:Name="TaxTreatmentBox" Height="40" Margin="0,4,0,0" AutomationProperties.Name="Tratamiento de impuesto del producto">
                                    <ComboBoxItem Content="Selecciona cómo se aplica el impuesto" Tag=""/>
                                    <ComboBoxItem Content="Gravado 16 %" Tag="Taxable16"/>
                                    <ComboBoxItem Content="Gravado 8 %" Tag="Taxable8"/>
                                    <ComboBoxItem Content="Gravado 0 %" Tag="Taxable0"/>
                                    <ComboBoxItem Content="Exento" Tag="Exempt"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="“Gravado 0 %” y “Exento” se guardan por separado. El impuesto se calcula al vender." Foreground="#52677F" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,10,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Inventario inicial" Foreground="#132D4F" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Si todavía no tienes existencias, deja la cantidad en cero." Foreground="#52677F" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock x:Name="InitialStockLabel" Text="Existencia inicial" FontWeight="SemiBold"/>
                            <TextBox x:Name="StockBox" Text="0" Height="40" Padding="9" Margin="0,4,0,0" AutomationProperties.Name="Existencia inicial del producto"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock x:Name="MinimumStockLabel" Text="Avisar cuando queden" FontWeight="SemiBold"/>
                            <TextBox x:Name="MinimumStockBox" Text="0" Height="40" Padding="9" Margin="0,4,0,0" AutomationProperties.Name="Cantidad mínima de inventario"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#F4F7FB" CornerRadius="6" Padding="12" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="El aviso de bajo inventario se mide en la unidad base. Usa 0 si no quieres recibir avisos para este producto." Foreground="#52677F" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorLabel" Foreground="#B43B42" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Width="110" Height="42" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Crear producto" Width="160" Height="42" IsDefault="True" Click="Create_Click" AutomationProperties.Name="Crear producto" Style="{StaticResource PosWindow.PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
