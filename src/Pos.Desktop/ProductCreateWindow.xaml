<Window Language="es-VE" x:Class="Pos.Desktop.ProductCreateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear producto" Width="480" Height="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F1F4F8">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="NUEVO PRODUCTO" Foreground="#173F78" FontSize="23" FontWeight="Bold"/><TextBlock Text="La existencia inicial se registra en el historial." Foreground="#63758B" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="SKU" FontWeight="SemiBold"/><TextBox x:Name="SkuBox" Height="36" Padding="7" Margin="0,4,0,10"/>
            <TextBlock Text="Nombre" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="36" Padding="7" Margin="0,4,0,10"/>
            <TextBlock Text="Precio" FontWeight="SemiBold"/><TextBox x:Name="PriceBox" Text="0,00" Height="36" Padding="7" Margin="0,4,0,10"/>
            <TextBlock Text="Moneda" FontWeight="SemiBold"/><ComboBox x:Name="CurrencyBox" Height="34" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox>
            <TextBlock Text="Existencia inicial" FontWeight="SemiBold"/><TextBox x:Name="StockBox" Text="0" Height="36" Padding="7" Margin="0,4,0,0"/>
            <DockPanel Margin="0,12,0,0"><Button Content="Seleccionar foto" Padding="12,7" Click="SelectImage_Click"/><TextBlock x:Name="ImageNameLabel" Text="Sin foto" Foreground="#63758B" VerticalAlignment="Center" Margin="10,0,0,0"/></DockPanel>
            <Image x:Name="ProductImagePreview" Height="90" Margin="0,6,0,0" Stretch="Uniform" Visibility="Collapsed"/>
            <TextBlock x:Name="ErrorLabel" Foreground="#B43B42" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="95" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Crear producto" Width="135" Height="40" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Create_Click"/></StackPanel>
    </Grid>
</Window>

