<Window Language="es-VE" x:Class="Pos.Desktop.ProductCreateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear producto" Width="700" Height="730" MinWidth="610" MinHeight="560" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Nuevo producto" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Completa los datos básicos. Luego podrás cambiar precios, foto y formas de venta desde la ficha." Foreground="#D7E3F2" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,10,12"><TextBlock Text="SKU / código" FontWeight="SemiBold"/><TextBox x:Name="SkuBox" Height="38" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="Código SKU del producto"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Nombre del producto" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="38" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="Nombre del producto"/></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,10,12"><TextBlock Text="Precio 1 (principal)" FontWeight="SemiBold"/><TextBox x:Name="PriceBox" Height="38" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="Precio 1 del producto"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Moneda de los precios" FontWeight="SemiBold"/><ComboBox x:Name="CurrencyBox" Height="38" SelectedIndex="0" Margin="0,4,0,0" AutomationProperties.Name="Moneda del precio"><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,10,12"><TextBlock Text="Precio 2 (opcional)" FontWeight="SemiBold"/><TextBox x:Name="Price2Box" Height="38" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="Precio 2 del producto"/><TextBlock Text="Puedes configurarlo después." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Precio 3 (opcional)" FontWeight="SemiBold"/><TextBox x:Name="Price3Box" Height="38" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="Precio 3 del producto"/><TextBlock Text="Puedes configurarlo después." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12"><TextBlock Text="Tratamiento de impuesto del producto" FontWeight="SemiBold"/><ComboBox x:Name="TaxTreatmentBox" Height="40" Margin="0,4,0,0" AutomationProperties.Name="Tratamiento de impuesto del producto">
                    <ComboBoxItem Content="Selecciona una regla antes de crear" Tag=""/>
                    <ComboBoxItem Content="Gravado 16 %" Tag="Taxable16"/><ComboBoxItem Content="Gravado 8 %" Tag="Taxable8"/>
                    <ComboBoxItem Content="Gravado 0 %" Tag="Taxable0"/><ComboBoxItem Content="Exento" Tag="Exempt"/>
                </ComboBox><TextBlock Text="“Gravado 0 %” y “Exento” se guardan por separado. La tasa se calcula al vender." Foreground="#52677F" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Inventario contado por" FontWeight="SemiBold"/><ComboBox x:Name="BaseUnitBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayLabel" SelectionChanged="BaseUnitBox_SelectionChanged" AutomationProperties.Name="Unidad base del producto"/><TextBlock Text="Elige cómo cuentas las existencias de este producto." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="Agregar tipo" Height="42" Padding="12,4" Margin="10,22,0,0" VerticalAlignment="Top" Click="CreateUnit_Click"/>
                </Grid>
                <StackPanel Grid.Row="5" Margin="0,0,10,12"><TextBlock x:Name="InitialStockLabel" Text="Existencia inicial" FontWeight="SemiBold"/><TextBox x:Name="StockBox" Text="0" Height="38" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="Existencia inicial del producto"/><TextBlock Text="Ingresa 0 si todavía no tienes existencia." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="10,0,0,12" VerticalAlignment="Bottom">
                    <DockPanel><Button Content="Seleccionar foto" Padding="10,7" Click="SelectImage_Click"/><TextBlock x:Name="ImageNameLabel" Text="Sin foto" Foreground="#52677F" VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis"/></DockPanel>
                    <Image x:Name="ProductImagePreview" Height="92" Margin="0,7,0,0" Stretch="Uniform" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Margin="0,0,10,12"><TextBlock x:Name="MinimumStockLabel" Text="Avisar cuando queden" FontWeight="SemiBold"/><TextBox x:Name="MinimumStockBox" Text="0" Height="38" Padding="8" Margin="0,4,0,0" AutomationProperties.Name="Cantidad mínima de inventario"/><TextBlock Text="0 desactiva el aviso para este producto." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            </Grid>
        </ScrollViewer>
        <TextBlock x:Name="ErrorLabel" Grid.Row="2" Foreground="#B43B42" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Width="105" Height="42" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/><Button Content="Crear producto" Width="145" Height="42" IsDefault="True" Click="Create_Click" AutomationProperties.Name="Crear producto" Style="{StaticResource PosWindow.PrimaryButton}"/></StackPanel>
    </Grid>
</Window>
