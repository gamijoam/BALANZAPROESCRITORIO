<Window Language="es-VE" x:Class="Pos.Desktop.OpeningBalanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar saldo inicial" Width="520" Height="390" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#EEF2F7">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SALDO INICIAL DEL CLIENTE" FontSize="22" FontWeight="Bold" Foreground="#173F78"/>
            <TextBlock Text="Indica lo que el cliente ya debía al momento de iniciar el sistema." FontSize="14" Foreground="#52677F" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Saldo pendiente en USD (hasta 4 decimales)" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,5"/>
        <TextBox x:Name="AmountBox" Grid.Row="2" Height="44" Padding="9" FontSize="18" MaxLength="32" VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Motivo o fecha de corte" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ReasonBox" Height="44" Padding="9" FontSize="15" MaxLength="250" VerticalContentAlignment="Center"/>
            <TextBlock Text="Este registro aparecerá en el historial y quedará asociado al operador que lo cargue." FontSize="12" Foreground="#63758B" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,18,0,0">
            <TextBlock x:Name="StatusLabel" DockPanel.Dock="Left" Foreground="#B43B42" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Width="100" Height="40" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button DockPanel.Dock="Right" Content="Guardar saldo" Width="140" Height="40" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
        </DockPanel>
    </Grid>
</Window>
