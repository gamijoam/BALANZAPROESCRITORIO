<Window Language="es-VE" x:Class="Pos.Desktop.ProductPriceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar precio" Width="470" Height="410" MinWidth="430" MinHeight="380" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="#F1F4F8">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="CAMBIAR PRECIO" Foreground="#173F78" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="ProductLabel" Foreground="#63758B" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Nivel del catálogo" FontWeight="SemiBold"/><ComboBox x:Name="PriceTierBox" Height="38" Margin="0,5,0,10" SelectionChanged="PriceTier_SelectionChanged" AutomationProperties.Name="Nivel de precio que se va a cambiar"/>
            <TextBlock x:Name="CurrentPriceLabel" Foreground="#63758B" Margin="0,0,0,7" TextWrapping="Wrap"/>
            <TextBlock Text="Nuevo precio" FontWeight="SemiBold"/><TextBox x:Name="PriceBox" Height="38" Padding="8" Margin="0,5,0,10" AutomationProperties.Name="Nuevo precio de catálogo"/>
            <TextBlock Text="Motivo del cambio" FontWeight="SemiBold"/><TextBox x:Name="ReasonBox" Height="38" Padding="8" Margin="0,5,0,0" AutomationProperties.Name="Motivo del cambio de precio"/><TextBlock x:Name="ErrorLabel" Foreground="#B43B42" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="100" Height="40" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/><Button Content="Guardar nivel" Width="130" Height="40" Background="#2858A2" Foreground="White" FontWeight="Bold" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
