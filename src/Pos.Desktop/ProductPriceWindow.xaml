<Window Language="es-VE" x:Class="Pos.Desktop.ProductPriceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar precio" Width="430" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F1F4F8">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="CAMBIAR PRECIO" Foreground="#173F78" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="ProductLabel" Foreground="#63758B" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Nuevo precio" FontWeight="SemiBold"/><TextBox x:Name="PriceBox" Height="38" Padding="8" Margin="0,5,0,12"/><TextBlock Text="Motivo" FontWeight="SemiBold"/><TextBox x:Name="ReasonBox" Height="38" Padding="8" Margin="0,5,0,0"/><TextBlock x:Name="ErrorLabel" Foreground="#B43B42" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="95" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Guardar precio" Width="125" Height="40" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>

