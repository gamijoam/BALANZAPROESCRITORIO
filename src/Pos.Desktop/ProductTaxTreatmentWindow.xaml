<Window Language="es-VE" x:Class="Pos.Desktop.ProductTaxTreatmentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clasificar impuesto" Width="500" Height="380" MinWidth="450" MinHeight="340" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12"><StackPanel><TextBlock Text="Impuesto del producto" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="ProductLabel" Foreground="#D7E3F2" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Regla de este producto" FontWeight="SemiBold"/><ComboBox x:Name="TaxTreatmentBox" Height="42" Margin="0,6,0,0" AutomationProperties.Name="Regla de impuesto para el producto">
                <ComboBoxItem Content="Selecciona una regla" Tag=""/><ComboBoxItem Content="Gravado 16 %" Tag="Taxable16"/><ComboBoxItem Content="Gravado 8 %" Tag="Taxable8"/><ComboBoxItem Content="Gravado 0 %" Tag="Taxable0"/><ComboBoxItem Content="Exento" Tag="Exempt"/>
            </ComboBox>
            <TextBlock Text="Gravado 0 % y Exento son opciones distintas. Si no estás seguro, confirma cuál aplica al artículo antes de guardarlo. Mientras siga pendiente, no se podrá vender." Foreground="#52677F" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock x:Name="ErrorLabel" Foreground="#B43B42" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="La selección quedará registrada en la auditoría del POS." Foreground="#52677F" FontSize="11" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Cancelar" Width="100" Height="42" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/><Button Content="Guardar" Width="130" Height="42" Style="{StaticResource PosWindow.PrimaryButton}" IsDefault="True" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
