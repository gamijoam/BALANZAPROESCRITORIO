<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pos.Desktop"
        Title="BalanzaPro · Punto de venta" Language="es-VE"
        Icon="pack://application:,,,/Pos.Desktop;component/Assets/balanzapro.ico"
        Height="900" Width="1536" MinHeight="500" MinWidth="800"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PosWindow.Background}" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="Pos.Navy" Color="#102D50"/>
        <SolidColorBrush x:Key="Pos.Primary" Color="#0867D5"/>
        <SolidColorBrush x:Key="Pos.PrimaryHover" Color="#0755A6"/>
        <SolidColorBrush x:Key="Pos.Success" Color="#15803D"/>
        <SolidColorBrush x:Key="Pos.SuccessHover" Color="#116B34"/>
        <SolidColorBrush x:Key="Pos.Danger" Color="#B91C1C"/>
        <SolidColorBrush x:Key="Pos.Background" Color="#F2F5F9"/>
        <SolidColorBrush x:Key="Pos.Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Pos.Text" Color="#132D4F"/>
        <SolidColorBrush x:Key="Pos.TextMuted" Color="#52677F"/>
        <SolidColorBrush x:Key="Pos.Border" Color="#D5DFEB"/>
        <SolidColorBrush x:Key="Pos.Selected" Color="#E6F1FF"/>

        <Style x:Key="Pos.Button" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Pos.Text}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Pos.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Pos.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Pos.Primary}"/>
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E9EEF4"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#CFD8E3"/>
                                <Setter Property="Foreground" Value="#526174"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pos.HeaderButton" TargetType="Button" BasedOn="{StaticResource Pos.Button}">
            <Setter Property="Background" Value="#174982"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2B5C95"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style x:Key="Pos.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Pos.Button}">
            <Setter Property="Background" Value="{StaticResource Pos.Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Pos.Primary}"/>
        </Style>
        <Style x:Key="Pos.SuccessButton" TargetType="Button" BasedOn="{StaticResource Pos.Button}">
            <Setter Property="Background" Value="{StaticResource Pos.Success}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Pos.Success}"/>
        </Style>
        <Style x:Key="Pos.DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource Pos.Button}">
            <Setter Property="Foreground" Value="{StaticResource Pos.Danger}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F0C8C8"/>
        </Style>
        <Style x:Key="Pos.MenuButton" TargetType="Button" BasedOn="{StaticResource Pos.Button}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource Pos.Text}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Pos.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="Pos.RightAlignedColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Pos.CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="Pos.CartRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="88"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Pos.Text}"/>
            <Setter Property="BorderBrush" Value="#E4EAF1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FBFCFE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Pos.Selected}"/>
                    <Setter Property="Foreground" Value="{StaticResource Pos.Text}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Pos.Primary}"/>
                    <Setter Property="BorderThickness" Value="4,0,0,1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pos.CartCompactRow" TargetType="DataGridRow" BasedOn="{StaticResource Pos.CartRow}">
            <Setter Property="MinHeight" Value="72"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Pos.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Pos.Navy}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="48" Height="48" Stretch="Uniform"
                           Source="pack://application:,,,/Pos.Desktop;component/Assets/balanzapro-logo.png"
                           AutomationProperties.Name="BalanzaPro"/>
                    <Border Width="1" Height="42" Background="#55708F" Margin="12,0"/>
                    <TextBlock Text="Punto de venta" Foreground="White" FontSize="24" FontWeight="Bold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#D97706"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CashSession.IsActiveForCurrentOperator}" Value="True">
                                            <Setter Property="Fill" Value="#22C55E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CashSession}" Value="{x:Null}">
                                            <Setter Property="Fill" Value="#EF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding CashStatus}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CashStatus}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="22,3,0,0">
                        <TextBlock Text="{Binding OperatorName}" Foreground="#D7E3F2" FontSize="13"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OperatorName}"/>
                        <TextBlock Text="  ·  LOCAL  ·  " Foreground="#AFC3DC" FontSize="13"/>
                        <TextBlock x:Name="ClockLabel" Foreground="#AFC3DC" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PausedSalesButton" Style="{StaticResource Pos.HeaderButton}"
                            Content="Ventas pausadas · F7" Click="PausedSales_Click"
                            IsEnabled="{Binding CanViewPausedSales}"
                            AutomationProperties.Name="Ver ventas pausadas, tecla F7"
                            ToolTip="Ver, retomar o descartar ventas de esta terminal (F7)"/>
                    <Button x:Name="MenuButton" Style="{StaticResource Pos.HeaderButton}" Margin="10,0,0,0"
                            Content="☰  Menú" Click="MenuButton_Click"
                            AutomationProperties.Name="Abrir menú de secciones"
                            AutomationProperties.AutomationId="OpenPosMenu"/>
                    <Button x:Name="ExitButton" Style="{StaticResource Pos.HeaderButton}" Margin="10,0,0,0"
                            Content="Salir" Background="{StaticResource Pos.Danger}" BorderBrush="{StaticResource Pos.Danger}"
                            Click="ExitButton_Click" ToolTip="Cerrar BalanzaPro"
                            AutomationProperties.Name="Salir del punto de venta" AutomationProperties.AutomationId="ExitPos"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LicenseNoticeBanner" Grid.Row="1" Visibility="Collapsed"
                Background="#FFF4D6" BorderBrush="#E4BD59" BorderThickness="0,0,0,1" Padding="16,8">
            <TextBlock x:Name="LicenseNoticeText" Foreground="#654B12" FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <Grid x:Name="MainBodyGrid" Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SummaryGapColumn" Width="16"/>
                <ColumnDefinition x:Name="SummaryColumn" Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="SaleWorkspaceGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="SelectedProductRow" Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Pos.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="14,9" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="#F0F4F8" CornerRadius="7" Width="44" Height="44" VerticalAlignment="Center">
                            <Grid>
                                <Ellipse Width="14" Height="14" Fill="#132D4F" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                <Border Width="24" Height="12" CornerRadius="7,7,4,4" Background="#132D4F"
                                        VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                            <TextBlock Text="Cliente" Foreground="{StaticResource Pos.TextMuted}" FontSize="14"/>
                            <TextBlock Text="{Binding SelectedCustomer.Name, TargetNullValue=Venta general, FallbackValue=Venta general}"
                                       Foreground="{StaticResource Pos.Text}" FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedCustomer.Name, TargetNullValue=Venta general}"/>
                            <TextBlock Text="{Binding SelectedCustomer.DocumentNumber, TargetNullValue=Sin cliente asignado, FallbackValue=Sin cliente asignado}"
                                       Foreground="{StaticResource Pos.TextMuted}" FontSize="14" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedCustomer.DocumentNumber, TargetNullValue=Sin cliente asignado}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Pos.PrimaryButton}" Content="Cambiar · F1"
                                Click="Customer_Click" ToolTip="Asignar o cambiar el cliente (F1)"
                                AutomationProperties.Name="Cambiar cliente, tecla F1"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="166"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource Pos.Primary}"
                            BorderThickness="1.5" CornerRadius="8" Padding="10,4"/>
                    <Grid Grid.Column="0" Margin="12,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="34" Height="30" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="23" Fill="{StaticResource Pos.Navy}" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                            <Rectangle Width="2" Height="27" Fill="{StaticResource Pos.Navy}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                            <Rectangle Width="4" Height="22" Fill="{StaticResource Pos.Navy}" HorizontalAlignment="Left" Margin="11,0,0,0"/>
                            <Rectangle Width="2" Height="27" Fill="{StaticResource Pos.Navy}" HorizontalAlignment="Left" Margin="18,0,0,0"/>
                            <Rectangle Width="3" Height="24" Fill="{StaticResource Pos.Navy}" HorizontalAlignment="Left" Margin="23,0,0,0"/>
                            <Rectangle Width="2" Height="28" Fill="{StaticResource Pos.Navy}" HorizontalAlignment="Left" Margin="29,0,0,0"/>
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchBox_KeyDown" FontSize="20" Padding="6,7" VerticalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent" ToolTip="Escanea un código o escribe el nombre y presiona Enter"
                                     AutomationProperties.Name="Escanear o buscar un producto"/>
                            <TextBlock Text="Escanea un código o busca un producto" Foreground="{StaticResource Pos.TextMuted}"
                                       FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource Pos.PrimaryButton}" Content="Buscar · F2"
                            Click="Search_Click" AutomationProperties.Name="Buscar producto, tecla F2"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Productos de la venta" Foreground="{StaticResource Pos.Text}" FontSize="20"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#E8EEF5" CornerRadius="15" Padding="12,5" Margin="12,0,0,0">
                        <TextBlock Text="{Binding CartLines.Count, StringFormat={}{0} líneas}" Foreground="{StaticResource Pos.Text}"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Pos.Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="CartGrid" ItemsSource="{Binding CartLines}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                                  IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="None" AlternationCount="2"
                                  Background="White" BorderThickness="0" SelectionMode="Single" SelectionUnit="FullRow"
                                  SelectedItem="{Binding SelectedCartLine, Mode=TwoWay}" RowHeaderWidth="0" FontSize="15"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  RowStyle="{StaticResource Pos.CartRow}"
                                  SelectionChanged="CartGrid_SelectionChanged" LoadingRow="CartGrid_LoadingRow"
                                  AutomationProperties.Name="Artículos de la venta"
                                  ToolTip="Usa + o − en la fila; F8 abre el editor de cantidad; Supr quita el artículo seleccionado.">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Producto" Width="*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,4,10,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#DCE5EF" BorderThickness="1"
                                                        CornerRadius="7" Width="58" Height="58" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="IMG" Foreground="{StaticResource Pos.TextMuted}" FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Stretch="Uniform" Margin="2" Tag="{Binding Product.Id}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Product.Name}" Foreground="{StaticResource Pos.Text}"
                                                               FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Product.Name}"/>
                                                    <TextBlock Foreground="{StaticResource Pos.TextMuted}" FontSize="13" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Product.Sku, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SaleUnitLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Precio unit." Width="170" IsReadOnly="True"
                                                        HeaderStyle="{StaticResource Pos.RightAlignedColumnHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SettlementCurrency}" Foreground="{StaticResource Pos.TextMuted}"
                                                           FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2}}" Foreground="{StaticResource Pos.Text}"
                                                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cantidad" Width="188" IsReadOnly="True"
                                                        HeaderStyle="{StaticResource Pos.CenteredColumnHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="−" Width="38" Height="40" Padding="0" FontSize="23"
                                                        Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        AutomationProperties.Name="Disminuir cantidad"/>
                                                <Border MinWidth="50" Height="40" Margin="5,0" BorderBrush="{StaticResource Pos.Border}"
                                                        BorderThickness="1" CornerRadius="5" Background="White">
                                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###}}" Foreground="{StaticResource Pos.Text}"
                                                               FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Content="+" Width="38" Height="40" Padding="0" FontSize="21"
                                                        Style="{StaticResource Pos.PrimaryButton}"
                                                        Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        AutomationProperties.Name="Aumentar cantidad"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Importe" Width="170" IsReadOnly="True"
                                                        HeaderStyle="{StaticResource Pos.RightAlignedColumnHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SettlementCurrency}" Foreground="{StaticResource Pos.TextMuted}"
                                                           FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2}}" Foreground="{StaticResource Pos.Text}"
                                                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Acciones" Width="124" IsReadOnly="True"
                                                        HeaderStyle="{StaticResource Pos.CenteredColumnHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="Editar" FontSize="12" MinWidth="56" MinHeight="42" Padding="6,4"
                                                        Style="{StaticResource Pos.PrimaryButton}"
                                                        IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Click="EditCartLine_Click"
                                                        ToolTip="La edición aparece en esta pantalla, sin abrir otra ventana."
                                                        AutomationProperties.Name="Editar la presentación, cantidad o precio de esta línea"/>
                                                <Button Content="×" FontSize="23" Width="42" Height="42" Padding="0" Margin="4,0,0,0"
                                                        Style="{StaticResource Pos.DangerOutlineButton}"
                                                        IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Click="RemoveCartLine_Click" AutomationProperties.Name="Quitar artículo de esta fila"
                                                        ToolTip="Quitar este artículo del carrito."/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Escanea o busca un producto para comenzar" Foreground="{StaticResource Pos.TextMuted}"
                                   FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CartLines.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Border x:Name="ProductPreviewPanel" Background="White" BorderBrush="{StaticResource Pos.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="7"
                                    Width="60" Height="60" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="ProductPreviewPlaceholder" Text="IMG" Foreground="{StaticResource Pos.TextMuted}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ProductPreviewImage" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                <TextBlock Text="Producto seleccionado" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"/>
                                <TextBlock x:Name="ProductPreviewName" Text="Selecciona un producto" Foreground="{StaticResource Pos.Text}"
                                           FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, ElementName=ProductPreviewName}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ProductPreviewSku" Foreground="{StaticResource Pos.TextMuted}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=ProductPreviewSku}"/>
                                    <TextBlock x:Name="ProductPreviewPrice" Foreground="{StaticResource Pos.Primary}" FontSize="15"
                                               FontWeight="Bold" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ChangeQuantityButton" Style="{StaticResource Pos.MenuButton}" Content="Cantidad · F8"
                                        Click="ChangeSelectedQuantity_Click" IsEnabled="{Binding CanEditSelectedLine}"
                                        AutomationProperties.Name="Editar cantidad en la pantalla, tecla F8"/>
                                <Button x:Name="RemoveSelectedLineButton" Style="{StaticResource Pos.DangerOutlineButton}" Content="Quitar · Supr"
                                        Margin="6,0,0,0" Click="RemoveSelectedCartLine_Click" IsEnabled="{Binding CanEditSelectedLine}"
                                        AutomationProperties.Name="Quitar la línea seleccionada, tecla Suprimir"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CartLineEditorPanel" Visibility="Collapsed" Background="White"
                            BorderBrush="{StaticResource Pos.Primary}" BorderThickness="1.5" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Editar producto en la venta" Foreground="{StaticResource Pos.Text}"
                                               FontSize="17" FontWeight="Bold"/>
                                    <TextBlock x:Name="CartLineEditorProductLabel" Foreground="{StaticResource Pos.TextMuted}"
                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Cancelar" MinWidth="100" Height="40" Click="CancelCartLineEdit_Click"
                                            AutomationProperties.Name="Cancelar edición del artículo"/>
                                    <Button x:Name="SaveCartLineEditButton" Grid.Column="1" Content="Guardar" MinWidth="120" Height="40"
                                            Margin="8,0,0,0" Style="{StaticResource Pos.PrimaryButton}"
                                            IsDefault="True" Click="SaveCartLineEdit_Click"
                                            AutomationProperties.Name="Guardar cambios del artículo"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="-8,10,-8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="8,0">
                                    <TextBlock Text="Forma de venta" Foreground="{StaticResource Pos.TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CartLineSaleUnitBox" Height="38" DisplayMemberPath="DisplayLabel"
                                              SelectionChanged="CartLineSaleUnit_SelectionChanged"
                                              AutomationProperties.Name="Forma de venta del artículo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="Cantidad" Foreground="{StaticResource Pos.TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="CartLineQuantityBox" Height="38" Padding="8,5" FontSize="16"
                                             VerticalContentAlignment="Center" AutomationProperties.Name="Cantidad del artículo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="Nivel de precio" Foreground="{StaticResource Pos.TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CartLinePriceTierBox" Height="38" SelectionChanged="CartLinePriceTier_SelectionChanged"
                                              AutomationProperties.Name="Nivel de precio del artículo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="8,0">
                                    <TextBlock Text="Precio por presentación" Foreground="{StaticResource Pos.TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="CartLinePriceBox" Height="38" Padding="8,5" FontSize="16"
                                             VerticalContentAlignment="Center" AutomationProperties.Name="Precio por presentación"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2.8*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Motivo del precio especial (si cambias el precio)" Foreground="{StaticResource Pos.TextMuted}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="CartLinePriceReasonBox" Height="38" Padding="8,5" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Motivo del precio especial"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="CartLineUnitHintLabel" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CartLineCatalogPriceLabel" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="CartLineTaxLabel" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="Un precio distinto al catálogo requiere autorización del administrador al cobrar."
                                               Foreground="{StaticResource Pos.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="CartLineEditErrorLabel" Grid.Row="3" Foreground="{StaticResource Pos.Danger}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="5" Background="#EAF0F6" CornerRadius="6" Padding="10,4" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CartWorkspaceStatusLabel" Text="{Binding CartWorkspaceStatus}"
                                   Foreground="{StaticResource Pos.TextMuted}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="Estado del guardado del carrito en el servidor"/>
                        <Button x:Name="AcceptCartValuesButton" Grid.Column="1" Content="Aceptar valores actuales"
                                Visibility="Collapsed" Click="AcceptCartValues_Click" MinHeight="28" Padding="8,2"
                                Background="#FFF4D6" Foreground="#714C00" BorderBrush="#E8C66B" FontSize="12"
                                FontWeight="SemiBold" ToolTip="Confirma los precios, impuestos y moneda actuales antes de continuar"/>
                    </Grid>
                </Border>

                <Border x:Name="CompactSummaryPanel" Grid.Row="6" Background="White" BorderBrush="{StaticResource Pos.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CartLines.Count, StringFormat={}{0} líneas en la venta}"
                                       Foreground="{StaticResource Pos.TextMuted}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Currency}" Foreground="{StaticResource Pos.Text}" FontSize="17" FontWeight="Bold" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}" Foreground="{StaticResource Pos.Navy}"
                                           FontSize="30" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReferenceTotalLabel}" Foreground="{StaticResource Pos.TextMuted}"
                                           FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Pos.SuccessButton}" Content="Cobrar · F4"
                                Command="{Binding ChargeCommand}" IsEnabled="{Binding CanCharge}" MinWidth="168" MinHeight="64"
                                AutomationProperties.Name="Cobrar venta, tecla F4" AutomationProperties.AutomationId="ChargeSale"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Pos.Button}" Content="Pausar · F6"
                                IsEnabled="{Binding CanPauseSale}" Click="PauseSale_Click" MinWidth="120" MinHeight="64" Margin="8,0,0,0"
                                ToolTip="Guardar esta venta y comenzar otra (F6)" AutomationProperties.Name="Pausar venta, tecla F6"/>
                        <Expander Grid.Row="1" Grid.ColumnSpan="3" Header="Ver subtotal e impuestos incluidos" FontSize="12"
                                  Foreground="{StaticResource Pos.TextMuted}" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Margin="4,4,0,0">
                                <TextBlock Text="Subtotal: " Foreground="{StaticResource Pos.TextMuted}"/>
                                <TextBlock Text="{Binding Currency}" Foreground="{StaticResource Pos.Text}"/>
                                <TextBlock Text="  "/>
                                <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}" Foreground="{StaticResource Pos.Text}"/>
                                <TextBlock Text="   Impuestos: " Foreground="{StaticResource Pos.TextMuted}"/>
                                <TextBlock Text="{Binding Currency}" Foreground="{StaticResource Pos.Text}"/>
                                <TextBlock Text="  "/>
                                <TextBlock Text="{Binding TaxTotal, StringFormat={}{0:N2}}" Foreground="{StaticResource Pos.Text}"/>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="WideSummaryPanel" Grid.Column="2" Background="White" BorderBrush="{StaticResource Pos.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▤" Foreground="{StaticResource Pos.Primary}" FontSize="24" FontWeight="Bold" Margin="0,0,12,0"/>
                        <TextBlock Text="Resumen de venta" Foreground="{StaticResource Pos.Navy}" FontSize="23" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding CartLines.Count, StringFormat={}{0} líneas}"
                               Foreground="{StaticResource Pos.TextMuted}" FontSize="16" Margin="0,8,0,20"/>
                    <Grid Grid.Row="2" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Subtotal" Foreground="{StaticResource Pos.Text}" FontSize="16"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Currency}" Foreground="{StaticResource Pos.TextMuted}" FontSize="14" Margin="0,1,5,0"/>
                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}" Foreground="{StaticResource Pos.Text}"
                                       FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Impuestos incluidos" Foreground="{StaticResource Pos.TextMuted}" FontSize="14"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Currency}" Foreground="{StaticResource Pos.TextMuted}" FontSize="13" Margin="0,1,5,0"/>
                            <TextBlock Text="{Binding TaxTotal, StringFormat={}{0:N2}}" Foreground="{StaticResource Pos.TextMuted}"
                                       FontSize="14"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="4" Height="1" Background="{StaticResource Pos.Border}"/>
                    <Border Grid.Row="5" Background="{StaticResource Pos.Navy}" CornerRadius="8" Padding="18,18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="TOTAL A PAGAR" Foreground="#C8D9EE" FontSize="15" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Currency}" Foreground="White" FontSize="19" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}" Foreground="White" FontSize="40"
                                           FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ReferenceTotalLabel}" Foreground="#E0EAF5" FontSize="17" Margin="0,0,0,12"/>
                            <Border Height="1" Background="#7590B0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="18" Height="18" Fill="#69B7FF" VerticalAlignment="Top" Margin="0,2,9,0"/>
                                <TextBlock Text="El total usa los precios y la tasa vigentes de esta venta."
                                           Foreground="#E0EAF5" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="WideChargeButton" Grid.Row="6" Style="{StaticResource Pos.SuccessButton}"
                            Command="{Binding ChargeCommand}" IsEnabled="{Binding CanCharge}" MinHeight="78" Margin="0,0,0,10"
                            AutomationProperties.Name="Cobrar venta, tecla F4" AutomationProperties.AutomationId="ChargeSaleWide">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▣" Foreground="White" FontSize="22" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Cobrar venta · F4" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="Elegir forma de pago" Foreground="White" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="7" Style="{StaticResource Pos.Button}" Content="Pausar venta · F6"
                            IsEnabled="{Binding CanPauseSale}" Click="PauseSale_Click" MinHeight="62"
                            ToolTip="Guardar esta venta y comenzar otra (F6)" AutomationProperties.Name="Pausar venta, tecla F6"/>
                    <TextBlock Grid.Row="8" Text="Elige una línea para editar su presentación, cantidad o precio."
                               Foreground="{StaticResource Pos.TextMuted}" FontSize="13" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" Margin="0,18,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#E5ECF4" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#16A34A" Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#344B67" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                </StackPanel>
                <TextBlock x:Name="ShortcutHints" Grid.Column="1"
                           Text="F1 Cliente   ·   F2 Buscar   ·   F4 Cobrar   ·   F6 Pausar   ·   F8 Cantidad   ·   F12 Caja"
                           Foreground="#344B67" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="F1 cliente; F2 buscar o escanear; F4 cobrar; F6 pausar; F8 cantidad; flechas arriba/abajo cambiar artículo; Supr quitar artículo; F12 caja."/>
            </Grid>
        </Border>

        <Popup x:Name="MainMenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom"
               HorizontalOffset="-250" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="360" Background="White" BorderBrush="{StaticResource Pos.Border}" BorderThickness="1"
                    CornerRadius="9" Padding="14">
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Operación" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"
                                   FontWeight="Bold" Margin="2,0,0,6"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="FirstNavigationButton" Style="{StaticResource Pos.MenuButton}" Content="Historial de ventas"
                                    Tag="Historial" Click="NavigationMenu_Click" AutomationProperties.Name="Historial de ventas" AutomationProperties.AutomationId="NavigateSalesHistory"/>
                            <Button Style="{StaticResource Pos.MenuButton}" Content="Caja · F12"
                                    Tag="Caja" Click="NavigationMenu_Click" AutomationProperties.Name="Caja" AutomationProperties.AutomationId="NavigateCash"/>
                            <Button Style="{StaticResource Pos.MenuButton}" Content="Clientes"
                                    Tag="Clientes" Click="NavigationMenu_Click" AutomationProperties.Name="Clientes" AutomationProperties.AutomationId="NavigateCustomers"/>
                            <Button Style="{StaticResource Pos.MenuButton}" Content="{Binding OperatorSessionActionLabel}"
                                    Tag="Sesion" Click="NavigationMenu_Click" IsEnabled="{Binding IsAuthenticated}"
                                    ToolTip="{Binding OperatorSessionActionToolTip}"
                                    AutomationProperties.Name="{Binding OperatorSessionActionLabel}" AutomationProperties.AutomationId="OperatorSessionAction"/>
                        </UniformGrid>
                        <TextBlock Text="Productos" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"
                                   FontWeight="Bold" Margin="2,12,0,6"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Pos.MenuButton}" Content="Inventario"
                                    Tag="Inventario" Click="NavigationMenu_Click" AutomationProperties.Name="Inventario" AutomationProperties.AutomationId="NavigateInventory"/>
                        </UniformGrid>
                        <TextBlock Text="Administración" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"
                                   FontWeight="Bold" Margin="2,12,0,6"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Pos.MenuButton}" Content="Administración"
                                    Tag="Administración" Click="ManagementTool_Click" AutomationProperties.Name="Administración" AutomationProperties.AutomationId="OpenAdministration"/>
                            <Button x:Name="ReportsButton" Style="{StaticResource Pos.MenuButton}" Content="Reportes avanzados"
                                    Tag="Reportes" Click="NavigationMenu_Click" Visibility="Collapsed"
                                    AutomationProperties.Name="Reportes avanzados" AutomationProperties.AutomationId="OpenAdvancedReports"/>
                        </UniformGrid>
                        <TextBlock Text="Sistema" Foreground="{StaticResource Pos.TextMuted}" FontSize="12"
                                   FontWeight="Bold" Margin="2,12,0,6"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Pos.MenuButton}" Content="Actualizar POS"
                                    Tag="Actualizar POS" Click="NavigationMenu_Click" AutomationProperties.Name="Actualizar POS"/>
                            <Button x:Name="ModulesButton" Style="{StaticResource Pos.MenuButton}" Content="Extensiones"
                                    Visibility="Collapsed"
                                    Click="ModulesButton_Click" AutomationProperties.Name="Extensiones"
                                    AutomationProperties.AutomationId="OpenExtensions" ToolTip="Abre las funciones adicionales instaladas">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ModulesPopup" Placement="Bottom" StaysOpen="False" HasDropShadow="True"
                                                 Opened="ModulesPopup_Opened" PreviewKeyDown="ModulesPopup_PreviewKeyDown"
                                                 AutomationProperties.Name="Funciones adicionales">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Padding" Value="14,8"/>
                                                <Setter Property="Foreground" Value="#172B45"/>
                                                <Setter Property="MinWidth" Value="220"/>
                                            </Style>
                                        </ContextMenu.Resources>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
