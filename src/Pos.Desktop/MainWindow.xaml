<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pos.Desktop"
        Title="Punto de venta" Language="es-VE" Height="900" Width="1536" MinHeight="720" MinWidth="1180"
        WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#EEF2F7" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#173F78"/>
        <SolidColorBrush x:Key="Blue" Color="#2E64B7"/>
        <SolidColorBrush x:Key="TextDark" Color="#172B45"/>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#214F91"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToolButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3971C5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToolButtonBorder" Property="BorderBrush" Value="#F3C969"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#435F83"/>
                                <Setter Property="Foreground" Value="#D4DEED"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChargeButton" TargetType="Button">
            <Setter Property="Background" Value="#D94D52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChargeBorder" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChargeBorder" Property="Background" Value="#C83F45"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChargeBorder" Property="Background" Value="#64758A"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#152B45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#172B45"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5EAF1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F5F7FA"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCE9FF"/><Setter Property="Foreground" Value="#173F78"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#102B4D" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.0*"/><ColumnDefinition Width="2.1*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PUNTO DE VENTA" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock x:Name="ClockLabel" Foreground="#C6D7EF" FontSize="13"/>
                        <TextBlock Text="  ·  " Foreground="#718EAF"/>
                        <TextBlock Text="LOCAL" Foreground="#A8E8C5" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="  ·  " Foreground="#718EAF"/>
                        <TextBlock Text="{Binding CashStatus}" Foreground="#DDE8F6" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#54B85D" CornerRadius="8" Padding="12,8" Margin="4">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PRECIO/U · REF" Foreground="#E8F7E9" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ReferenceCurrentPriceLabel}" Foreground="White" FontSize="25" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#E9AD27" CornerRadius="8" Padding="12,8" Margin="4">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ARTÍCULOS" Foreground="#FFF5D7" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ItemCount, StringFormat={}{0:0.###}}" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="TotalCard" Grid.Column="3" Background="#E74D54" CornerRadius="8" Padding="14,6" Margin="4">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid x:Name="TotalCardLabels" Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL A PAGAR" Foreground="#FFE8E8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ReferenceTotalLabel}" Foreground="#FFE8E8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Currency}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}" Foreground="White" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#2858A2" Padding="15">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="VENTA ACTUAL" Foreground="#BFD2F0" FontSize="12" FontWeight="Bold" Margin="2,5,0,10"/>
                    <Border Background="#3569B5" CornerRadius="8" Padding="13" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="F1  ·  CLIENTE" Foreground="#FFE279" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedCustomer.Name, TargetNullValue=Venta general}" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding SelectedCustomer.DocumentNumber, TargetNullValue=Sin cliente asignado}" Foreground="#D4E1F5" FontSize="13"/>
                            <Button Content="Asignar cliente a la venta" Margin="0,12,0,0" Padding="8" Background="#214B8A" Foreground="White" BorderThickness="0" Click="Customer_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#3569B5" CornerRadius="8" Padding="13" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="OPERADOR" Foreground="#FFE279" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding OperatorName}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding CashStatus}" Foreground="#D4E1F5" FontSize="13" Margin="0,2,0,0"/>
                            <Button Content="{Binding OperatorSessionActionLabel}" IsEnabled="{Binding CanUseSessionAction}"
                                    Margin="0,9,0,0" Padding="8,6" Background="#214B8A" Foreground="White" BorderThickness="0"
                                    AutomationProperties.Name="Cambiar operador o cerrar sesión"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding OperatorSessionActionToolTip}" Click="OperatorSessionAction_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" Background="#214B8A" CornerRadius="8" Margin="0,0,0,2" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="ProductPreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        <StackPanel x:Name="ProductPreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15">
                            <TextBlock Text="FOTO DEL PRODUCTO" Foreground="#BFD2F0" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Al agregar un artículo\naparecerá aquí su imagen" Foreground="White" FontSize="15" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Border VerticalAlignment="Bottom" Background="#D9172B4A" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="ProductPreviewName" Text="Sin producto seleccionado" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock x:Name="ProductPreviewSku" Foreground="#C6D7EF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="  ·  " Foreground="#718EAF"/>
                                    <TextBlock x:Name="ProductPreviewPrice" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="12,10,10,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" Height="54" FontSize="22" Padding="14,8" VerticalContentAlignment="Center"
                         BorderBrush="#8BA6C9" BorderThickness="2" ToolTip="Escanea un código o escribe el nombre y presiona Enter"/>
                <Button Grid.Column="1" Content="Buscar" Margin="8,0,0,0" FontSize="17" FontWeight="Bold" Background="#2E64B7" Foreground="White" BorderThickness="0" Click="Search_Click"/>
            </Grid>
            <Border x:Name="CurrentProductSummary" Grid.Row="1" Margin="0,0,0,8" Padding="12,7" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="PRODUCTO AGREGADO" Foreground="#63758B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock x:Name="ProductSummaryCode" Grid.Column="1" Foreground="#2858A2" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ProductSummaryName" Grid.Column="2" Foreground="#172B45" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <TextBlock x:Name="ProductSummaryPrice" Grid.Column="3" Foreground="#173F78" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataGrid x:Name="CartGrid" Grid.Row="2" Margin="0,0,0,0" ItemsSource="{Binding CartLines}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      HeadersVisibility="Column" GridLinesVisibility="None" AlternationCount="2" Background="White" BorderBrush="#D7DFEA"
                      SelectionMode="Single" SelectionUnit="FullRow" SelectedItem="{Binding SelectedCartLine, Mode=TwoWay}" RowHeaderWidth="0" FontSize="14"
                      PreviewKeyDown="CartGrid_PreviewKeyDown" AutomationProperties.Name="Artículos de la venta"
                      ToolTip="F8 va a la cantidad; flechas arriba/abajo cambian de artículo; Supr elimina la fila.">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Product.Sku}" Width="135" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Precio unitario" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="155" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Cantidad" Width="95">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Quantity" UpdateSourceTrigger="LostFocus" StringFormat="{}{0:0.###}" ValidatesOnExceptions="True" NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <local:CartQuantityValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="125" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Acciones" Width="95" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Quitar" MinWidth="76" Height="30" Padding="6,2" Background="#A52F3B" Foreground="White"
                                            IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Click="RemoveCartLine_Click" AutomationProperties.Name="Eliminar artículo de esta fila"
                                            ToolTip="Quitar este artículo del carrito."/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Background="#173F78" Padding="13">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SECCIONES" Foreground="#BFD2F0" FontSize="12" FontWeight="Bold" Margin="4,6,0,9"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button Style="{StaticResource ToolButton}" Content="▣   _Venta" Click="SaleTool_Click" AutomationProperties.Name="Venta" AutomationProperties.AutomationId="NavigateSale"/>
                    <Button Style="{StaticResource ToolButton}" Content="▤   _Historial de ventas" Click="SalesHistoryTool_Click" AutomationProperties.Name="Historial de ventas" AutomationProperties.AutomationId="NavigateSalesHistory"/>
                    <Button Style="{StaticResource ToolButton}" Content="▤   _Caja" Click="CashTool_Click" AutomationProperties.Name="Caja" AutomationProperties.AutomationId="NavigateCash"/>
                    <Button Style="{StaticResource ToolButton}" Content="♙   C_lientes" Click="Customer_Click" AutomationProperties.Name="Clientes" AutomationProperties.AutomationId="NavigateCustomers"/>
                    <Button Style="{StaticResource ToolButton}" Content="▦   _Inventario" Click="InventoryTool_Click" AutomationProperties.Name="Inventario" AutomationProperties.AutomationId="NavigateInventory"/>
                    <StackPanel x:Name="ModuleMenuHost"/>
                    <Button Style="{StaticResource ToolButton}" Content="＄   Precios y _tasa" Tag="Tasa" Click="ManagementTool_Click" AutomationProperties.Name="Precios y tasa" AutomationProperties.AutomationId="NavigateExchangeRate"/>
                    <Button Style="{StaticResource ToolButton}" Content="◷   _Auditoría" Tag="Auditoría" Click="ManagementTool_Click" AutomationProperties.Name="Auditoría" AutomationProperties.AutomationId="NavigateAudit"/>
                    <Button Style="{StaticResource ToolButton}" Content="▥   _Reportes" Tag="Reportes" Click="ManagementTool_Click" AutomationProperties.Name="Reportes" AutomationProperties.AutomationId="NavigateReports"/>
                    <Button Style="{StaticResource ToolButton}" Content="⚙   _Operadores" Tag="Operadores" Click="ManagementTool_Click" AutomationProperties.Name="Operadores" AutomationProperties.AutomationId="NavigateOperators"/>
                    <Button Style="{StaticResource ToolButton}" Content="▣   _Módulos" Tag="Módulos" Click="ManagementTool_Click" AutomationProperties.Name="Módulos" AutomationProperties.AutomationId="NavigateModules"/>
                </StackPanel>
                </ScrollViewer>
                    <Button Grid.Row="2" Style="{StaticResource ChargeButton}" Command="{Binding ChargeCommand}" Height="72" MinWidth="218" HorizontalAlignment="Stretch" Margin="0,12,0,2" ToolTip="Abre los medios de pago para confirmar la venta" AutomationProperties.Name="Cobrar venta. Atajo F4" AutomationProperties.AutomationId="ChargeSale">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Cobrar venta" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="F4 · elegir forma de pago" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#DCE4EF" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#344B67" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                <TextBlock Grid.Column="1" Text="F1 Cliente   ·   F2 Buscar / escanear   ·   F4 Cobrar venta   ·   F8 Editar cantidad   ·   ↑/↓ Artículo   ·   Supr Quitar   ·   F12 Caja"
                           Foreground="#344B67" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           ToolTip="Atajos: F1 cliente; F2 buscar/escanear; F4 cobrar; F8 editar cantidad en el carrito; flechas arriba/abajo cambiar artículo; Supr quitar artículo; F12 caja."/>
            </Grid>
        </Border>
    </Grid>
</Window>
