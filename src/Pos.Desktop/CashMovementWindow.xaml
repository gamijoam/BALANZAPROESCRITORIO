<Window Language="es-VE" x:Class="Pos.Desktop.CashMovementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimiento de caja" Width="450" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12"><StackPanel><TextBlock Text="Movimiento de caja" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="CurrencyLabel" Foreground="#D7E3F2" Margin="0,5,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Tipo" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="DirectionBox" Height="36" SelectedIndex="0"><ComboBoxItem Content="Entrada"/><ComboBoxItem Content="Salida"/></ComboBox>
            <TextBlock Text="Moneda" FontWeight="SemiBold" Margin="0,10,0,5"/><ComboBox x:Name="CurrencyBox" Height="36"><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox>
            <TextBlock Text="Monto" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBox x:Name="AmountBox" Text="0,00" Height="38" Padding="8" FontSize="17"/>
            <TextBlock Text="Motivo" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBox x:Name="ReasonBox" Height="38" Padding="8"/>
            <TextBlock x:Name="ErrorLabel" Foreground="#B43B42" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="95" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Guardar movimiento" Width="180" Height="42" Style="{StaticResource PosWindow.PrimaryButton}" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>

