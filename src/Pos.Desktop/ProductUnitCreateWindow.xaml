<Window Language="es-VE" x:Class="Pos.Desktop.ProductUnitCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar tipo de unidad" Width="440" Height="300" MinWidth="400" MinHeight="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F2F5F9" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Agregar unidad" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Escribe un nombre sencillo, por ejemplo: Huevo, Cartón o Caja." Foreground="#D7E3F2" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Nombre" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Height="36" Padding="8" Margin="0,4,0,0"/>
        </StackPanel>
        <Expander Grid.Row="2" Header="¿Se puede vender por fracción?" Margin="0,0,0,8">
            <StackPanel Margin="0,6,0,0">
                <CheckBox x:Name="FractionalBox" Content="Permitir cantidades decimales" IsChecked="False"/>
                <TextBlock Text="Actívalo para peso o medidas, como 0,5 kg." Foreground="#63758B" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </Expander>
        <TextBlock x:Name="ErrorLabel" Grid.Row="3" Foreground="#A33232" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Height="42" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Agregar unidad" Width="145" Height="42" Style="{StaticResource PosWindow.PrimaryButton}" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
