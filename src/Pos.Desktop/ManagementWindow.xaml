<Window x:Class="Pos.Desktop.ManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administración del punto de venta" Language="es-VE" Width="1080" Height="740" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="ADMINISTRACIÓN" Foreground="#173F78" FontSize="24" FontWeight="Bold"/><TextBlock Text="Configura la tasa, consulta reportes, administra operadores y revisa auditorías." Foreground="#63758B" Margin="0,4,0,0"/></StackPanel>
        <TabControl x:Name="ManagementTabs">
            <TabItem Header="Precios y tasa">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="RatesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Moneda base" Binding="{Binding FromCurrency}" Width="110"/><DataGridTextColumn Header="Moneda destino" Binding="{Binding ToCurrency}" Width="130"/><DataGridTextColumn Header="Tasa" Binding="{Binding Rate, StringFormat={}{0:N2}}" Width="140"/><DataGridTextColumn Header="Vigente desde" Binding="{Binding EffectiveAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="190"/><DataGridTextColumn Header="Referencia" Binding="{Binding Source}" Width="*"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Row="1" Background="White" Padding="12" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Moneda base" Margin="0,0,0,5"/><TextBlock Grid.Column="1" Text="Moneda destino" Margin="0,0,0,5"/><TextBlock Grid.Column="2" Text="Tasa de cambio" Margin="0,0,0,5"/><TextBlock Grid.Column="3" Text="Origen o referencia" Margin="0,0,0,5"/>
                        <ComboBox x:Name="FromCurrencyBox" Grid.Row="1" Width="90" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="USD"/><ComboBoxItem Content="VES"/></ComboBox><ComboBox x:Name="ToCurrencyBox" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" SelectedIndex="1"><ComboBoxItem Content="USD"/><ComboBoxItem Content="VES"/></ComboBox><TextBox x:Name="RateBox" Grid.Row="1" Grid.Column="2" Height="36" Padding="7" ToolTip="Ejemplo: 36,50"/><TextBox x:Name="RateSourceBox" Grid.Row="1" Grid.Column="3" Height="36" Padding="7" Margin="8,0" ToolTip="Ejemplo: referencia del Banco Central"/><Button Grid.Row="1" Grid.Column="4" Content="Guardar tasa" Height="36" Click="SetRate_Click"/>
                    </Grid></Border>
                    <TextBlock x:Name="RateStatus" Grid.Row="2" Foreground="#52677F" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Reportes">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="Período" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="FromDate" Width="135"/>
                        <TextBlock Text="hasta" VerticalAlignment="Center" Margin="8,0"/><DatePicker x:Name="ToDate" Width="135"/>
                        <Button Content="Hoy" Width="65" Height="32" Margin="10,0,0,0" Click="TodayRange_Click"/><Button Content="7 días" Width="75" Height="32" Margin="6,0,0,0" Click="WeekRange_Click"/><Button Content="Este mes" Width="90" Height="32" Margin="6,0,0,0" Click="MonthRange_Click"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel x:Name="CurrencyFiltersPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Moneda" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ReportCurrencyBox" Width="110" Height="34" SelectedIndex="0" SelectionChanged="ReportCurrency_SelectionChanged"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox>
                        </StackPanel>
                        <WrapPanel x:Name="SalesDetailFiltersPanel" VerticalAlignment="Center">
                            <TextBlock Text="Método de pago" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="SalesPaymentMethodBox" Width="145" Height="34" SelectedIndex="0"><ComboBoxItem Content="Todos"/><ComboBoxItem Content="Efectivo"/><ComboBoxItem Content="Punto de venta"/><ComboBoxItem Content="Transferencia"/><ComboBoxItem Content="Pago móvil"/><ComboBoxItem Content="Crédito"/></ComboBox>
                            <TextBlock Text="Responsable" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,6,0"/><TextBox x:Name="SalesOperatorBox" Width="115" Height="34" Padding="7" ToolTip="Nombre del operador"/>
                            <TextBlock Text="Estado" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,6,0"/><ComboBox x:Name="SalesStatusBox" Width="155" Height="34" SelectedIndex="0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="Confirmada"/><ComboBoxItem Content="Devuelta parcialmente"/><ComboBoxItem Content="Devuelta"/></ComboBox>
                            <TextBlock Text="Buscar venta, cliente o producto" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,6,0"/><TextBox x:Name="SalesDetailSearchBox" Width="190" Height="34" Padding="7" ToolTip="Busca en todas las páginas por número, artículo, cliente u operador"/>
                        </WrapPanel>
                        <WrapPanel x:Name="CashFiltersPanel" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Estado de caja" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="CashStatusBox" Width="110" Height="34" SelectedIndex="0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="Abiertas"/><ComboBoxItem Content="Cerradas"/></ComboBox>
                        </WrapPanel>
                        <WrapPanel x:Name="InventoryFiltersPanel" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Producto" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="InventorySearchBox" Width="190" Height="34" Padding="7" ToolTip="Filtrar existencias por código o nombre" TextChanged="InventorySearch_TextChanged"/>
                        </WrapPanel>
                        <WrapPanel x:Name="ProductSalesFiltersPanel" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Producto" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="ProductSalesSearchBox" Width="190" Height="34" Padding="7" ToolTip="Filtrar resultados por código o nombre" TextChanged="ProductSalesSearch_TextChanged"/>
                        </WrapPanel>
                        <Button Content="Consultar reporte" Width="135" Height="34" Margin="10,0,0,0" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="RunSelectedReport_Click"/>
                        <Button Content="Exportar CSV" Width="115" Height="34" Margin="8,0,0,0" Click="ExportReport_Click"/>
                    </WrapPanel>
                    <TabControl x:Name="ReportTabs" Grid.Row="2" SelectionChanged="ReportTabs_SelectionChanged">
                        <TabItem Header="Ventas por día">
                            <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="SalesSummary" Foreground="#173F78" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Text="Selecciona el período y pulsa Consultar."/>
                                <DataGrid x:Name="SalesReportGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Day, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="120"/><DataGridTextColumn Header="Ventas" Binding="{Binding Count}" Width="130"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="180"/>
                                </DataGrid.Columns></DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Ventas detalladas">
                            <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SalesDetailPrevious" Content="‹ Anterior" Padding="10,5" Click="SalesDetailPrevious_Click"/><TextBlock x:Name="SalesDetailPageLabel" Text="Página 1" Margin="10,0" VerticalAlignment="Center"/><Button x:Name="SalesDetailNext" Content="Siguiente ›" Padding="10,5" Click="SalesDetailNext_Click"/></StackPanel><TextBlock x:Name="SalesDetailSummary" Text="Consulta para ver cada venta y sus artículos." Foreground="#173F78" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                <DataGrid x:Name="SalesDetailGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionChanged="SalesDetail_SelectionChanged"><DataGrid.Columns>
                                    <DataGridTextColumn Header="N.º venta" Binding="{Binding SaleNumber}" Width="95"/><DataGridTextColumn Header="Fecha y hora" Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="165"/><DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Responsable" Binding="{Binding OperatorName}" Width="130"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="150"/><DataGridTextColumn Header="Bruto venta" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="110"/><DataGridTextColumn Header="Devuelto venta" Binding="{Binding ReturnedAmount, StringFormat={}{0:N2}}" Width="110"/><DataGridTextColumn Header="Neto venta" Binding="{Binding NetTotal, StringFormat={}{0:N2}}" Width="110"/><DataGridTextColumn Header="Moneda de venta" Binding="{Binding Currency}" Width="115"/><DataGridTextColumn Header="N.º artículos" Binding="{Binding Lines.Count}" Width="95"/>
                                </DataGrid.Columns></DataGrid>
                                <DockPanel Grid.Row="2" Margin="0,8"><Button x:Name="SaleReturnButton" DockPanel.Dock="Right" Content="Registrar devolución" Padding="12,6" IsEnabled="False" Click="SaleReturn_Click"/><TextBlock x:Name="SaleDetailTitle" Text="Selecciona una venta para ver artículos y pagos." Foreground="#173F78" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
                                <DataGrid x:Name="SaleLinesGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding HasReturnedUnits}" Value="True"><Setter Property="Background" Value="#FFFFE7B3"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                                    <DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="100"/><DataGridTextColumn Header="Producto" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="90"/><DataGridTextColumn Header="Devueltos" Binding="{Binding ReturnedQuantity, StringFormat={}{0:0.###}}" Width="90"/><DataGridTextColumn Header="Pendientes" Binding="{Binding ReturnableQuantity, StringFormat={}{0:0.###}}" Width="95"/><DataGridTextColumn Header="Estado de devolución" Binding="{Binding ReturnStatusLabel}" Width="160"/><DataGridTextColumn Header="Nivel" Binding="{Binding PriceTier}" Width="85"/><DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100"/><DataGridTextColumn Header="Impuesto" Binding="{Binding TaxTreatmentLabel}" Width="150"/><DataGridTextColumn Header="Impuesto cobrado" Binding="{Binding TaxAmount, StringFormat={}{0:N2}}" Width="115"/><DataGridTextColumn Header="Importe" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="110"/><DataGridTextColumn Header="Moneda original" Binding="{Binding OriginalCurrency}" Width="115"/></DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Cajas">
                            <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="CashReportSummary" Text="Turnos de caja y arqueos en USD y VES." Foreground="#173F78" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid x:Name="CashReportGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionChanged="CashReport_SelectionChanged"><DataGrid.Columns>
                                    <DataGridTextColumn Header="Apertura" Binding="{Binding OpenedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/><DataGridTextColumn Header="Cierre" Binding="{Binding ClosedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/><DataGridTextColumn Header="Responsable" Binding="{Binding OperatorName}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="85"/><DataGridTextColumn Header="USD inicial" Binding="{Binding OpeningUsd, StringFormat={}{0:N2}}" Width="100"/><DataGridTextColumn Header="USD esperado" Binding="{Binding ExpectedUsd, StringFormat={}{0:N2}}" Width="105"/><DataGridTextColumn Header="USD contado" Binding="{Binding CountedUsd, StringFormat={}{0:N2}}" Width="105"/><DataGridTextColumn Header="Dif. USD" Binding="{Binding VarianceUsd, StringFormat={}{0:N2}}" Width="100"/><DataGridTextColumn Header="VES inicial" Binding="{Binding OpeningVes, StringFormat={}{0:N2}}" Width="100"/><DataGridTextColumn Header="VES esperado" Binding="{Binding ExpectedVes, StringFormat={}{0:N2}}" Width="110"/><DataGridTextColumn Header="VES contado" Binding="{Binding CountedVes, StringFormat={}{0:N2}}" Width="105"/><DataGridTextColumn Header="Dif. VES" Binding="{Binding VarianceVes, StringFormat={}{0:N2}}" Width="100"/>
                                </DataGrid.Columns></DataGrid>
                                <Grid Grid.Row="2" Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Cobros y reintegros por método" FontWeight="Bold" Foreground="#173F78"/><TextBlock Grid.Column="1" Text="Movimientos de efectivo" FontWeight="Bold" Foreground="#173F78" Margin="8,0,0,0"/></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <DataGrid x:Name="CashSessionDetailsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Operación" Binding="{Binding Operation}" Width="95"/><DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="*"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="65"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="105"/></DataGrid.Columns></DataGrid>
                                    <DataGrid x:Name="CashMovementsGrid" Grid.Column="1" Margin="8,0,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Movimiento de caja" Binding="{Binding DirectionLabel}" Width="120"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="65"/><DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="95"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Existencias por producto">
                            <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="InventorySummary" Foreground="#173F78" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Text="Consulta para ver existencias y valor al precio de venta."/>
                                <DataGrid x:Name="InventoryReportGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="130"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Existencia" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="120"/><DataGridTextColumn Header="Precio unitario" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="150"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="95"/><DataGridTextColumn Header="Valor del inventario" Binding="{Binding RetailValue, StringFormat={}{0:N2}}" Width="170"/>
                                </DataGrid.Columns></DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Ventas por producto">
                            <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="ProductSalesSummary" Foreground="#173F78" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Text="Consulta para ver cantidades y montos netos de devoluciones."/>
                                <DataGrid x:Name="ProductSalesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="120"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="75"/><DataGridTextColumn Header="Vendidas" Binding="{Binding SoldQuantity, StringFormat={}{0:0.###}}" Width="95"/><DataGridTextColumn Header="Devueltas" Binding="{Binding ReturnedQuantity, StringFormat={}{0:0.###}}" Width="95"/><DataGridTextColumn Header="Neto unidades" Binding="{Binding NetQuantity, StringFormat={}{0:0.###}}" Width="100"/><DataGridTextColumn Header="Bruto" Binding="{Binding GrossAmount, StringFormat={}{0:N2}}" Width="115"/><DataGridTextColumn Header="Devuelto" Binding="{Binding ReturnedAmount, StringFormat={}{0:N2}}" Width="115"/><DataGridTextColumn Header="Neto" Binding="{Binding NetAmount, StringFormat={}{0:N2}}" Width="115"/>
                                </DataGrid.Columns></DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <TextBlock x:Name="ReportStatus" Grid.Row="3" Foreground="#52677F" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Operadores y permisos">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="OperatorsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*"/><DataGridTextColumn Header="Rol" Binding="{Binding RoleLabel}" Width="160"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding Active}" Width="90"/><DataGridTextColumn Header="Creado" Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd/MM/yyyy}}" Width="130"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Row="1" Background="White" Padding="12" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="OperatorNameBox" Height="36" Padding="7" ToolTip="Usuario"/><PasswordBox x:Name="OperatorPinBox" Grid.Column="1" Height="36" Padding="7" Margin="8,0,0,0" ToolTip="PIN de 4 a 12 dígitos"/><ComboBox x:Name="OperatorRoleBox" Grid.Column="2" Height="36" SelectedIndex="0" Margin="8,0,0,0"><ComboBoxItem Content="Cajero" Tag="Cashier"/><ComboBoxItem Content="Supervisor" Tag="Supervisor"/><ComboBoxItem Content="Administrador" Tag="Administrator"/></ComboBox><Button Grid.Column="3" Content="Crear" Width="75" Margin="8,0,0,0" Click="CreateOperator_Click"/><Button Grid.Column="4" Content="Cambiar rol" Width="105" Margin="8,0,0,0" Click="ChangeRole_Click"/><Button Grid.Column="5" Content="Permisos" Width="90" Margin="8,0,0,0" Click="ManagePermissions_Click"/><Button Grid.Column="6" Content="Activar / desactivar" Width="145" Margin="8,0,0,0" Click="ToggleOperator_Click"/>
                    </Grid></Border>
                    <TextBlock x:Name="OperatorStatus" Grid.Row="2" Foreground="#52677F" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Auditoría">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding OccurredAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="190"/><DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="200"/><DataGridTextColumn Header="Responsable" Binding="{Binding ActorId}" Width="250"/><DataGridTextColumn Header="Detalle" Binding="{Binding Payload}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="AuditStatus" Grid.Row="1" Foreground="#52677F" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Módulos">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Instala paquetes oficiales firmados. El servidor crea un respaldo, aplica migraciones compatibles y solicita reinicio antes de activar." TextWrapping="Wrap" Foreground="#52677F" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="White" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="ID interno del módulo" FontWeight="SemiBold"/><TextBlock Text="Se obtiene del ZIP" FontSize="11" Foreground="#52677F"/></StackPanel><TextBox x:Name="ModuleIdBox" Grid.Column="1" Height="34" Padding="7" ToolTip="Se completa automáticamente al elegir un solo ZIP. Para Almacenes y traslados, el ID es warehouses."/><Button Grid.Column="2" Content="Elegir paquete(s) ZIP…" Margin="8,0,0,0" Padding="12,0" Click="ChooseModulePackages_Click"/>
                        <TextBlock x:Name="ModulePackageFilesLabel" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="#52677F" Text="Selecciona el ZIP del módulo. El nombre del archivo no es el ID." TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ModulePackageIdentityLabel" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,0" Foreground="#173F78" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid></Border>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Plan validado, compatibilidad y orden de dependencias" FontWeight="Bold" Foreground="#173F78" Margin="0,0,0,6"/><DataGrid x:Name="ModulePlanGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Módulo" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="80"/><DataGridTextColumn Header="Código" Binding="{Binding RuntimeLabel}" Width="105"/><DataGridTextColumn Header="Terminales" Binding="{Binding TerminalCompatibility.StatusLabel}" Width="130"/><DataGridTextColumn Header="Sin versión" Binding="{Binding TerminalCompatibility.UnreportedTerminalCount}" Width="85"/><DataGridTextColumn Header="Versiones incompatibles" Binding="{Binding TerminalCompatibility.IncompatibleVersionsLabel}" Width="160"/><DataGridTextColumn Header="Publicador" Binding="{Binding SignerKeyId}" Width="120"/><DataGridTextColumn Header="Migraciones" Binding="{Binding Migrations.Count}" Width="95"/><DataGridTextColumn Header="Licencia" Binding="{Binding Entitlement}" Width="120"/></DataGrid.Columns></DataGrid></Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8"><Button x:Name="ValidateModuleButton" Content="Validar paquete" MinWidth="140" Height="36" Margin="0,0,8,0" Click="ValidateModule_Click"/><Button x:Name="InstallModuleButton" Content="Instalar módulo" MinWidth="140" Height="36" Margin="0,0,8,0" IsEnabled="False" Click="InstallModule_Click"/><Button x:Name="RestartModuleHostButton" Content="Reiniciar servidor y cargar módulos" MinWidth="230" Height="36" IsEnabled="False" ToolTip="Disponible en la computadora que ejecuta el servidor POS." Click="RestartModuleHost_Click"/></StackPanel>
                    <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Módulos registrados en el servidor" FontWeight="Bold" Foreground="#173F78" Margin="0,0,0,6"/><DataGrid x:Name="InstalledModulesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionChanged="InstalledModulesGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Módulo" Binding="{Binding ModuleId}" Width="*"/><DataGridTextColumn Header="Versión" Binding="{Binding Version}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="180"/><DataGridTextColumn Header="Diagnóstico" Binding="{Binding ActivationDetail}" Width="240"/><DataGridTextColumn Header="Instalado" Binding="{Binding InstalledAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="170"/><DataGridTextColumn Header="SHA-256 del respaldo" Binding="{Binding BackupSha256}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="ActivateModuleButton" Content="Reactivar módulo seleccionado" MinWidth="220" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="ActivateModule_Click"/><Button x:Name="DeactivateModuleButton" Content="Desactivar módulo seleccionado" MinWidth="220" Height="34" IsEnabled="False" Click="DeactivateModule_Click"/></StackPanel></Grid>
                    <TextBlock x:Name="ModuleStatus" Grid.Row="5" Foreground="#52677F" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
