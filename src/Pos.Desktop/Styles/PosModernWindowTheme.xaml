<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PosWindow.Navy" Color="#102D50"/>
    <SolidColorBrush x:Key="PosWindow.Primary" Color="#0867D5"/>
    <SolidColorBrush x:Key="PosWindow.PrimaryHover" Color="#0755A6"/>
    <SolidColorBrush x:Key="PosWindow.Success" Color="#159447"/>
    <SolidColorBrush x:Key="PosWindow.Danger" Color="#B91C1C"/>
    <SolidColorBrush x:Key="PosWindow.Background" Color="#F2F5F9"/>
    <SolidColorBrush x:Key="PosWindow.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PosWindow.Text" Color="#132D4F"/>
    <SolidColorBrush x:Key="PosWindow.Muted" Color="#52677F"/>
    <SolidColorBrush x:Key="PosWindow.Border" Color="#D5DFEB"/>
    <SolidColorBrush x:Key="PosWindow.Selected" Color="#E6F1FF"/>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource PosWindow.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosWindow.Primary}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PosWindow.Primary}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#E9EEF4"/><Setter TargetName="Surface" Property="BorderBrush" Value="#CFD8E3"/><Setter Property="Foreground" Value="#7A8797"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PosWindow.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PosWindow.Primary}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PosWindow.Primary}"/>
    </Style>
    <Style x:Key="PosWindow.SuccessButton" TargetType="Button" BasedOn="{StaticResource PosWindow.PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource PosWindow.Success}"/><Setter Property="BorderBrush" Value="{StaticResource PosWindow.Success}"/>
    </Style>
    <Style x:Key="PosWindow.HeaderButton" TargetType="Button" BasedOn="{StaticResource PosWindow.PrimaryButton}">
        <Setter Property="Background" Value="#174982"/><Setter Property="BorderBrush" Value="#2B5C95"/><Setter Property="MinHeight" Value="48"/>
    </Style>
    <Style x:Key="PosWindow.DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource PosWindow.Danger}"/><Setter Property="BorderBrush" Value="#F0C8C8"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/><Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#B8C8DB"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/><Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#B8C8DB"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/><Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#B8C8DB"/><Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/><Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource PosWindow.Border}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E6ECF2"/>
        <Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="AlternationCount" Value="2"/><Setter Property="RowHeight" Value="44"/>
        <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserResizeRows" Value="False"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EEF3F8"/><Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource PosWindow.Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="44"/><Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/>
        <Setter Property="BorderBrush" Value="#E4EAF1"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource PosWindow.Selected}"/><Setter Property="Foreground" Value="{StaticResource PosWindow.Text}"/><Setter Property="BorderBrush" Value="{StaticResource PosWindow.Primary}"/><Setter Property="BorderThickness" Value="3,0,0,1"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PosWindow.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,10"/>
        <Setter Property="Foreground" Value="{StaticResource PosWindow.Muted}"/>
    </Style>
</ResourceDictionary>
