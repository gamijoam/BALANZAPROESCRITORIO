<Window x:Class="Pos.Desktop.PausedSalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ventas pausadas" Width="1080" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F2F5F9" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="18,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Ventas pausadas" Foreground="White" FontSize="23" FontWeight="Bold"/>
                <TextBlock Margin="0,4,0,0" Text="Ventas guardadas en esta terminal. Revisa los artículos antes de retomarlas." Foreground="#D7E3F2" FontSize="13"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <DataGrid x:Name="PausedSalesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="White" BorderBrush="#D7DFEA" FontSize="13" SelectionChanged="PausedSalesGrid_SelectionChanged"
                      AutomationProperties.Name="Lista de ventas pausadas">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pausada" Binding="{Binding PausedAtDisplay}" Width="150"/>
                    <DataGridTextColumn Header="Operador" Binding="{Binding OperatorName}" Width="125"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="165"/>
                    <DataGridTextColumn Header="Resumen" Binding="{Binding Summary}" Width="*"/>
                    <DataGridTextColumn Header="Total al pausar" Binding="{Binding TotalDisplay}" Width="145"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyState" Text="No hay ventas pausadas en esta terminal." HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="#63758B" FontSize="16" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,10" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailsText" Text="Selecciona una venta para ver sus artículos, nota y cambios detectados."
                           TextWrapping="Wrap" Foreground="#334A65" FontSize="13" AutomationProperties.Name="Detalle de la venta pausada"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#52667E" FontSize="12" TextWrapping="Wrap" Margin="2,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Actualizar" Width="100" Height="42" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                <Button x:Name="DiscardButton" Content="Descartar" Width="105" Height="42" Margin="0,0,8,0" IsEnabled="False" Click="DiscardButton_Click"/>
                <Button x:Name="ResumeButton" Content="Retomar venta" Width="150" Height="42" Style="{StaticResource PosWindow.PrimaryButton}"
                        BorderThickness="0" FontWeight="SemiBold" IsEnabled="False" Click="ResumeButton_Click"/>
                <Button Content="Cerrar" Width="90" Height="42" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
