<Window Language="es-VE" x:Class="Pos.Desktop.ProductDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ficha del producto" Width="1500" Height="850" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="18,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ficha del producto" Foreground="White" FontSize="23" FontWeight="Bold"/>
                    <TextBlock x:Name="TitleProductLabel" Foreground="#D7E3F2" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Existencia en unidad base" FontWeight="SemiBold" Foreground="#D7E3F2" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StockSummaryLabel" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Background="White" BorderBrush="#D5DFEB">
            <TabItem Header="Datos y precios">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,12"><TextBlock Text="SKU / código" FontWeight="SemiBold"/><TextBox x:Name="SkuBox" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Nombre del producto" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,12"><TextBlock Text="Unidad base del inventario" FontWeight="SemiBold"/><ComboBox x:Name="BaseUnitBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayLabel" IsEnabled="False"/><TextBlock Text="La unidad base queda fija para proteger el historial del inventario. Configura otras formas de venta en Presentaciones." Foreground="#52677F" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Tratamiento de impuesto" FontWeight="SemiBold"/><ComboBox x:Name="TaxTreatmentBox" Height="38" Margin="0,4,0,0">
                            <ComboBoxItem Content="Gravado 16 %" Tag="Taxable16"/><ComboBoxItem Content="Gravado 8 %" Tag="Taxable8"/>
                            <ComboBoxItem Content="Gravado 0 %" Tag="Taxable0"/><ComboBoxItem Content="Exento" Tag="Exempt"/>
                            <ComboBoxItem Content="Pendiente de clasificar" Tag="Unclassified"/>
                        </ComboBox></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,10,12"><TextBlock x:Name="MinimumStockLabel" Text="Aviso de bajo stock" FontWeight="SemiBold"/><TextBox x:Name="MinimumStockBox" Height="38" Padding="8" Margin="0,4,0,0"/><TextBlock Text="0 desactiva el aviso." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Estado del producto" FontWeight="SemiBold"/><TextBlock x:Name="ActiveLabel" Height="38" VerticalAlignment="Center" Foreground="#132D4F"/></StackPanel>
                        <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Background="#F4F7FB" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="12,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Foto del producto" FontWeight="SemiBold" Foreground="#132D4F" Margin="0,0,0,8"/>
                                <Grid Grid.Row="1" MinHeight="150">
                                    <Image x:Name="ProductImagePreview" Stretch="Uniform" MaxHeight="190" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ProductImagePlaceholder" Text="Sin foto" Foreground="#52677F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="ImageStatusLabel" Grid.Row="2" Foreground="#52677F" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="Cambiar foto" Height="38" Margin="0,0,4,0" Click="UploadImage_Click" Style="{StaticResource PosWindow.PrimaryButton}"/>
                                    <Button x:Name="RemoveImageButton" Grid.Column="1" Content="Quitar" Height="38" Margin="4,0,0,0" Click="RemoveImage_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="PRECIOS DE VENTA" Foreground="#132D4F" FontWeight="Bold" FontSize="15" Margin="0,8,0,8"/>
                        <Grid Grid.Row="4" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,12"><TextBlock Text="Precio 1 · principal" FontWeight="SemiBold"/><TextBox x:Name="Price1Box" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,12"><TextBlock Text="Precio 2 · opcional" FontWeight="SemiBold"/><TextBox x:Name="Price2Box" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,12"><TextBlock Text="Precio 3 · opcional" FontWeight="SemiBold"/><TextBox x:Name="Price3Box" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Si cambias un precio, indica el motivo para guardarlo en el historial." Foreground="#52677F" TextWrapping="Wrap"/>
                        <TextBox x:Name="PriceReasonBox" Grid.Row="6" Grid.ColumnSpan="2" Height="42" Padding="8" Margin="0,6,0,12" AutomationProperties.Name="Motivo del cambio de precio"/>
                        <Border Grid.Row="8" Grid.ColumnSpan="2" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Costo promedio" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UnitCostLabel" Foreground="#132D4F" Margin="0,5,0,7"/>
                                    <Button x:Name="InitializeCostButton" Content="Asignar costo inicial" Height="38" Click="InitializeCost_Click" AutomationProperties.Name="Asignar costo inicial del inventario" ToolTip="Disponible si el producto tiene existencia y aún no tiene un costo registrado."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ajustar existencia" FontWeight="SemiBold" Foreground="#132D4F"/>
                                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock x:Name="StockAdjustmentAmountLabel" Text="Cantidad (+/−)" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="StockAdjustmentAmountBox" Text="1" Height="38" Padding="7" AutomationProperties.Name="Cantidad a sumar o descontar"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Motivo (opcional)" FontSize="11" FontWeight="SemiBold" ToolTip="Si lo dejas vacío, se guardará como “Ajuste manual de inventario”."/><TextBox x:Name="StockAdjustmentReasonBox" Height="38" Padding="7" AutomationProperties.Name="Motivo opcional del ajuste de existencia" ToolTip="Si lo dejas vacío, se guardará como “Ajuste manual de inventario”."/></StackPanel>
                                        <Button x:Name="ApplyStockAdjustmentButton" Grid.Column="2" Content="Aplicar" Height="38" Padding="14,4" Margin="4,18,0,0" Click="ApplyStockAdjustment_Click" Style="{StaticResource PosWindow.PrimaryButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="Los costos se actualizan al recibir compras. El stock, los ajustes y las compras siempre usan la unidad base." Foreground="#52677F" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="SaveDetailsButton" Content="Guardar datos" Width="140" Height="42" Click="SaveDetails_Click" Style="{StaticResource PosWindow.PrimaryButton}"/>
                            <Button x:Name="ToggleActiveButton" Content="Desactivar producto" Width="155" Height="42" Margin="8,0,0,0" Click="ToggleActive_Click" Style="{StaticResource PosWindow.DangerButton}"/>
                            <Button Content="Historial" Width="120" Height="42" Margin="8,0,0,0" Click="History_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Formas de venta">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="¿Cómo se vende este producto?" FontSize="17" FontWeight="Bold" Foreground="#132D4F"/>
                        <TextBlock Text="Cada forma indica cuántas unidades del inventario descuenta. Ejemplo: 1 Par = 2 Unidades." Foreground="#52677F" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="BaseUnitSummaryLabel" Foreground="#52677F" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="PresentationsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="PresentationsGrid_SelectionChanged" RowHeaderWidth="0" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Se vende como" Binding="{Binding UnitName}" Width="*"/>
                            <DataGridTextColumn Header="Cada forma contiene" Binding="{Binding ConversionLabel}" Width="220"/>
                            <DataGridTextColumn Header="Precio 1" Binding="{Binding Price1Label}" Width="140"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,12,0,6">
                        <TextBlock x:Name="PresentationEditorTitle" Text="Agregar forma de venta" FontWeight="Bold" Foreground="#132D4F"/>
                        <TextBlock Text="Selecciona la forma y define su contenido. Los precios y el código se guardan al pulsar Agregar o Guardar cambios." Foreground="#52677F" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Forma de venta" FontSize="11" FontWeight="SemiBold"/>
                            <ComboBox x:Name="PresentationUnitBox" Height="36" DisplayMemberPath="Name" SelectionChanged="PresentationUnitBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="ConversionFactorPanel" Grid.Column="1" Margin="4,0,10,0" Visibility="Collapsed">
                            <TextBlock x:Name="ConversionFactorLabel" Text="Contenido" FontSize="11" FontWeight="SemiBold"/>
                            <DockPanel Height="36">
                                <TextBox x:Name="ConversionFactorBox" Height="36" Width="110" Padding="7" TextChanged="ConversionFactorBox_TextChanged"/>
                                <TextBlock x:Name="BaseUnitFactorLabel" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#52677F"/>
                            </DockPanel>
                            <TextBlock x:Name="ConversionHintLabel" FontSize="10" Foreground="#52677F" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Agregar tipo" Height="40" Padding="10,4" Margin="4,18,6,0" Click="CreateUnit_Click"/>
                        <Button x:Name="SavePresentationButton" Grid.Column="3" Content="Agregar" Height="40" Padding="16,4" Margin="4,18,6,0" Click="SavePresentation_Click" Style="{StaticResource PosWindow.PrimaryButton}"/>
                        <Button x:Name="DeactivatePresentationButton" Grid.Column="4" Content="Retirar" Height="40" Padding="12,4" Margin="4,18,0,0" Click="DeactivatePresentation_Click" IsEnabled="False"/>
                        <Button x:Name="CancelPresentationEditButton" Grid.Column="5" Content="Cancelar" Height="40" Padding="10,4" Margin="6,18,0,0" Click="CancelPresentationEdit_Click" Visibility="Collapsed"/>
                    </Grid>
                    <Expander x:Name="PresentationAdvancedOptions" Grid.Row="4" Header="Precio de esta forma y código de barras (opcional)" IsExpanded="False" Margin="0,10,0,0">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Deja el precio vacío para calcularlo con el precio de la unidad base × el contenido de esta forma. Escribe un importe si quieres cobrar un precio especial por Par, Cartón o Caja." Foreground="#52677F" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="1" Margin="0,0,8,0"><TextBlock Text="Precio 1 de esta forma" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationPrice1Box" Height="34" Padding="6"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0"><TextBlock Text="Precio 2 de esta forma" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationPrice2Box" Height="34" Padding="6"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0"><TextBlock Text="Precio 3 de esta forma" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationPrice3Box" Height="34" Padding="6"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Código que identifica esta forma al escanear (opcional)" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationBarcodeBox" Height="34" Padding="6"/></StackPanel>
                        </Grid>
                    </Expander>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Foreground="#52677F" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cerrar" Width="110" Height="42" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
