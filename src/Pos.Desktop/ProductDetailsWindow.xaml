<Window Language="es-VE" x:Class="Pos.Desktop.ProductDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ficha del producto" Width="1320" Height="850" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FICHA DEL PRODUCTO" Foreground="#173F78" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="TitleProductLabel" Foreground="#52677F" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Existencia en unidad base" FontWeight="SemiBold" Foreground="#52677F" HorizontalAlignment="Right"/>
                <TextBlock x:Name="StockSummaryLabel" FontSize="18" FontWeight="Bold" Foreground="#173F78" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Background="White" BorderBrush="#D7DFEA">
            <TabItem Header="Datos y precios">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,12"><TextBlock Text="SKU / código" FontWeight="SemiBold"/><TextBox x:Name="SkuBox" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Nombre del producto" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,12"><TextBlock Text="Unidad base del inventario" FontWeight="SemiBold"/><ComboBox x:Name="BaseUnitBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayLabel" IsEnabled="False"/><TextBlock Text="La unidad base queda fija para proteger el historial del inventario. Configura otras formas de venta en Presentaciones." Foreground="#63758B" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Tratamiento de impuesto" FontWeight="SemiBold"/><ComboBox x:Name="TaxTreatmentBox" Height="38" Margin="0,4,0,0">
                            <ComboBoxItem Content="Gravado 16 %" Tag="Taxable16"/><ComboBoxItem Content="Gravado 8 %" Tag="Taxable8"/>
                            <ComboBoxItem Content="Gravado 0 %" Tag="Taxable0"/><ComboBoxItem Content="Exento" Tag="Exempt"/>
                            <ComboBoxItem Content="Pendiente de clasificar" Tag="Unclassified"/>
                        </ComboBox></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,10,12"><TextBlock x:Name="MinimumStockLabel" Text="Aviso de bajo stock" FontWeight="SemiBold"/><TextBox x:Name="MinimumStockBox" Height="38" Padding="8" Margin="0,4,0,0"/><TextBlock Text="0 desactiva el aviso." Foreground="#63758B" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="Estado del producto" FontWeight="SemiBold"/><TextBlock x:Name="ActiveLabel" Height="38" VerticalAlignment="Center" Foreground="#173F78"/></StackPanel>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="PRECIOS DE VENTA" Foreground="#173F78" FontWeight="Bold" FontSize="15" Margin="0,8,0,8"/>
                        <Grid Grid.Row="4" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,12"><TextBlock Text="Precio 1 · principal" FontWeight="SemiBold"/><TextBox x:Name="Price1Box" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,12"><TextBlock Text="Precio 2 · opcional" FontWeight="SemiBold"/><TextBox x:Name="Price2Box" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,12"><TextBlock Text="Precio 3 · opcional" FontWeight="SemiBold"/><TextBox x:Name="Price3Box" Height="38" Padding="8" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Si cambias un precio, indica el motivo para guardarlo en el historial." Foreground="#63758B" TextWrapping="Wrap"/>
                        <TextBox x:Name="PriceReasonBox" Grid.Row="6" Grid.ColumnSpan="2" Height="42" Padding="8" Margin="0,6,0,12" AutomationProperties.Name="Motivo del cambio de precio"/>
                        <TextBlock Grid.Row="7" Text="Costo promedio" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UnitCostLabel" Grid.Row="7" Grid.Column="1" Foreground="#173F78" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Foto del producto" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border Width="62" Height="62" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Background="#F5F7FA">
                                <Image x:Name="ProductImagePreview" Stretch="UniformToFill"/>
                            </Border>
                            <Button Content="Subir o cambiar foto" Height="34" Padding="12,4" Click="UploadImage_Click"/>
                            <Button x:Name="RemoveImageButton" Content="Quitar foto" Height="34" Padding="12,4" Margin="8,0,0,0" Click="RemoveImage_Click"/>
                            <TextBlock x:Name="ImageStatusLabel" Foreground="#63758B" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="Los costos se actualizan al recibir compras. El stock, los ajustes y las compras siempre usan la unidad base." Foreground="#63758B" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="SaveDetailsButton" Content="Guardar datos" Width="140" Height="38" Background="#2858A2" Foreground="White" FontWeight="SemiBold" Click="SaveDetails_Click"/>
                            <Button x:Name="ToggleActiveButton" Content="Desactivar producto" Width="155" Height="38" Margin="8,0,0,0" Click="ToggleActive_Click"/>
                            <Button Content="Historial de movimientos" Width="190" Height="38" Margin="8,0,0,0" Click="History_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Unidades y presentaciones">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Presentaciones de venta" FontSize="17" FontWeight="Bold" Foreground="#173F78"/>
                        <TextBlock Text="El factor indica cuántas unidades base descuenta una venta. Se configura para este producto; el precio vacío se calcula usando el precio base y el factor." Foreground="#63758B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="PresentationsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="PresentationsGrid_SelectionChanged" RowHeaderWidth="0" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Presentación" Binding="{Binding Label}" Width="*"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnitName}" Width="130"/>
                            <DataGridTextColumn Header="Factor a unidad base" Binding="{Binding ConversionFactor, StringFormat={}{0:0.###}}" Width="150"/>
                            <DataGridTextColumn Header="Precio 1" Binding="{Binding Price1, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="Precio 2" Binding="{Binding Price2, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="Precio 3" Binding="{Binding Price3, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="Código de barras" Binding="{Binding Barcode}" Width="150"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Nueva presentación o edición" FontWeight="Bold" Foreground="#173F78" Margin="0,12,0,6"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Nombre visible" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationLabelBox" Height="34" Padding="6"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0"><TextBlock Text="Unidad" FontSize="11" FontWeight="SemiBold"/><ComboBox x:Name="PresentationUnitBox" Height="34" DisplayMemberPath="DisplayLabel"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0"><TextBlock Text="Factor" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="ConversionFactorBox" Text="1" Height="34" Padding="6"/></StackPanel>
                        <StackPanel Grid.Column="3" Margin="4,0"><TextBlock Text="Precio 1 (vacío = auto)" FontSize="10" FontWeight="SemiBold"/><TextBox x:Name="PresentationPrice1Box" Height="34" Padding="6"/></StackPanel>
                        <StackPanel Grid.Column="4" Margin="4,0"><TextBlock Text="Precio 2" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationPrice2Box" Height="34" Padding="6"/></StackPanel>
                        <StackPanel Grid.Column="5" Margin="4,0,0,0"><TextBlock Text="Precio 3" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationPrice3Box" Height="34" Padding="6"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Código de barras de esta presentación (opcional)" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PresentationBarcodeBox" Height="34" Padding="6"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button Content="Crear unidad" Width="110" Height="36" Margin="0,0,6,0" Click="CreateUnit_Click"/>
                            <Button Content="Nueva" Width="72" Height="36" Margin="0,0,6,0" Click="NewPresentation_Click"/>
                            <Button x:Name="SavePresentationButton" Content="Guardar" Width="95" Height="36" Margin="0,0,6,0" Background="#2858A2" Foreground="White" Click="SavePresentation_Click"/>
                            <Button x:Name="DeactivatePresentationButton" Content="Desactivar" Width="100" Height="36" Click="DeactivatePresentation_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="4,10,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Foreground="#52677F" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cerrar" Width="110" Height="40" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
