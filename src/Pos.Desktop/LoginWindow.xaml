<Window Language="es-VE" x:Class="Pos.Desktop.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Width="430" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F1F4F8">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PUNTO DE VENTA" Foreground="#173F78" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Conéctate al servicio e inicia tu turno." Foreground="#63758B" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Dirección del servicio" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="BaseAddressBox" Text="http://localhost:5155" Height="38" Padding="8" FontSize="15"/>
            <TextBlock Text="Usuario" FontWeight="SemiBold" Margin="0,14,0,5"/>
            <TextBox x:Name="UsernameBox" Height="38" Padding="8" FontSize="15"/>
            <TextBlock Text="PIN" FontWeight="SemiBold" Margin="0,14,0,5"/>
            <PasswordBox x:Name="PinBox" Height="38" Padding="8" FontSize="15"/>
            <TextBlock x:Name="ErrorLabel" Foreground="#B43B42" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
        <Button Grid.Row="2" Content="Iniciar sesión" IsDefault="True" Height="46" Background="#2858A2" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="Login_Click"/>
    </Grid>
</Window>

