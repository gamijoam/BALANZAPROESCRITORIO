<Window x:Class="Pos.Desktop.InstallationSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar punto de venta" Width="720" Height="650" MinWidth="640" MinHeight="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource PosWindow.Background}"
        AutomationProperties.Name="Asistente de instalación del punto de venta">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#102D50" CornerRadius="9" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Configurar esta terminal" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Elige si esta computadora trabajará sola o se conectará a otra caja." Foreground="#D7E3F2" FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,14" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <RadioButton x:Name="StandaloneOption" GroupName="InstallMode" IsChecked="True" Checked="Mode_Changed"
                         Padding="14" Margin="0,0,0,10" FontSize="16" FontWeight="SemiBold"
                         AutomationProperties.Name="PC independiente">
                <Border BorderBrush="#C8D6E8" BorderThickness="1" CornerRadius="6" Background="White" Padding="14">
                    <StackPanel>
                        <TextBlock Text="PC independiente" Foreground="#132D4F" FontWeight="Bold"/>
                        <TextBlock Text="Esta computadora ejecuta el servicio, usa su propia base PostgreSQL y abre el POS local." Foreground="#52677F" FontSize="13" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </RadioButton>
            <RadioButton x:Name="ServerOption" GroupName="InstallMode" Checked="Mode_Changed"
                         Padding="14" Margin="0,0,0,10" FontSize="16" FontWeight="SemiBold"
                         AutomationProperties.Name="Servidor POS con caja local">
                <Border BorderBrush="#C8D6E8" BorderThickness="1" CornerRadius="6" Background="White" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Servidor POS + caja local" Foreground="#132D4F" FontWeight="Bold"/>
                        <TextBlock Text="Esta será la caja principal. El POS prepara la conexión segura y muestra la IP para las otras cajas." Foreground="#52677F" FontSize="13" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </RadioButton>
            <RadioButton x:Name="ClientOption" GroupName="InstallMode" Checked="Mode_Changed"
                         Padding="14" Margin="0,0,0,10" FontSize="16" FontWeight="SemiBold"
                         AutomationProperties.Name="Terminal cliente conectada a un servidor HTTPS">
                <Border BorderBrush="#C8D6E8" BorderThickness="1" CornerRadius="6" Background="White" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Terminal cliente" Foreground="#132D4F" FontWeight="Bold"/>
                        <TextBlock Text="Escribe la IP de la caja principal. Luego cada operador inicia sesión con su usuario y PIN habitual." Foreground="#52677F" FontSize="13" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </RadioButton>
            <TextBlock x:Name="ServerAddressLabel" Text="IP de la caja principal" FontWeight="SemiBold" Margin="0,8,0,5"/>
            <TextBox x:Name="ServerUrlBox" Height="40" Padding="9" FontSize="15" IsEnabled="False"
                     AutomationProperties.Name="IP o nombre de la caja principal"/>
            <TextBlock x:Name="ConnectionHint" Text="La caja principal y esta computadora deben estar conectadas a la misma red local. El puerto 5155 se configura automáticamente." Foreground="#52677F" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Border x:Name="FirstTrustNotice" Background="#FFF3D6" BorderBrush="#E7C77A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="La primera vez, Windows pedirá permiso para habilitar el acceso en redes privadas. En cada caja cliente confirmarás una vez la identidad del servidor." Foreground="#755619" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="#B43B42" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="38"/>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Salir" Width="110" Height="42" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="ContinueButton" Content="Continuar" Width="150" Height="42" Background="#0867D5" Foreground="White" FontWeight="Bold" Click="Continue_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
