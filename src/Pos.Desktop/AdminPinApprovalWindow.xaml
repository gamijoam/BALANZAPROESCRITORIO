<Window x:Class="Pos.Desktop.AdminPinApprovalWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorización de administrador" Width="430" Height="360" MinWidth="400" MinHeight="340" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PosWindow.Background}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12"><TextBlock Text="Se requiere autorización" FontSize="21" FontWeight="Bold" Foreground="White"/></Border>
        <TextBlock x:Name="ActionLabel" Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource PosWindow.Muted}"/>
        <TextBlock Grid.Row="2" Text="Usuario administrador" FontWeight="SemiBold" Margin="0,18,0,5"/>
        <TextBox x:Name="UsernameBox" Grid.Row="3" Height="38" Padding="8"/>
        <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="PIN de administrador" FontWeight="SemiBold" Margin="0,0,0,5"/><PasswordBox x:Name="PinBox" Height="38" Padding="8"/><TextBlock x:Name="ErrorLabel" Foreground="#B32D3A" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Width="100" Height="42" Margin="0,0,8,0" IsCancel="True"/><Button Content="Autorizar" Width="120" Height="42" Style="{StaticResource PosWindow.PrimaryButton}" IsDefault="True" Click="Authorize_Click"/></StackPanel>
    </Grid>
</Window>
