<Window Language="es-VE" x:Class="Pos.Desktop.CustomerEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar cliente" Width="560" Height="560" MinWidth="520" MinHeight="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F2F5F9">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12">
            <StackPanel><TextBlock Text="Editar cliente" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="CustomerNameLabel" Foreground="#D7E3F2" FontSize="14" Margin="0,4,0,0"/></StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="Nombre completo" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="NameBox" Height="42" Padding="9" FontSize="16"/></StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Documento" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="DocumentBox" Height="42" Padding="9" FontSize="16"/></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Teléfono" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="PhoneBox" Height="42" Padding="9" FontSize="16"/></StackPanel>
        <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="Límite de crédito (USD)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="LimitBox" Height="42" Padding="9" FontSize="16"/></StackPanel>
        <TextBlock x:Name="StatusLabel" Grid.Row="5" Foreground="#A3313A" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="110" Height="42" Margin="0,0,10,0" FontSize="15" IsCancel="True"/>
            <Button Content="Guardar cambios" Width="160" Height="42" Style="{StaticResource PosWindow.PrimaryButton}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
