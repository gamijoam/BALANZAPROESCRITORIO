<Window Language="es-VE" x:Class="Pos.Desktop.CustomersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes y créditos" Width="1280" Height="740" MinWidth="1120" MinHeight="640" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="CustomerFooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12" Margin="0,0,0,14">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Clientes y créditos" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Busca un cliente, revisa su crédito o asígnalo a la venta." Foreground="#D7E3F2" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="320" Height="44" Padding="10" FontSize="16" VerticalContentAlignment="Center" ToolTip="Nombre, documento o teléfono. Enter busca; ↑/↓ recorre resultados; F2 vuelve a la búsqueda; Esc cierra." KeyDown="Search_KeyDown"
                         TabIndex="0" AutomationProperties.Name="Buscar cliente por nombre, documento o teléfono" AutomationProperties.AutomationId="CustomerSearch"/>
                <Button Content="_Buscar" Width="100" Height="44" Margin="8,0,0,0" Style="{StaticResource PosWindow.PrimaryButton}" Click="Search_Click" TabIndex="1" AutomationProperties.Name="Buscar clientes"/>
                <Button Content="_Limpiar" Width="80" Height="44" Margin="8,0,0,0" FontSize="15" Click="ClearSearch_Click" TabIndex="2" AutomationProperties.Name="Limpiar búsqueda de clientes"/>
            </StackPanel>
        </Grid>
        </Border>

        <DataGrid x:Name="CustomersGrid" Grid.Row="1" SelectionChanged="CustomersGrid_SelectionChanged" PreviewKeyDown="CustomersGrid_PreviewKeyDown" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" RowHeight="48" FontSize="16" Background="White" BorderBrush="#D5DFEB"
                  TabIndex="3" AutomationProperties.Name="Resultados de clientes" AutomationProperties.AutomationId="CustomerResults">
            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource PosWindow.BaseDataGridColumnHeader}"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,9"/><Setter Property="Height" Value="44"/></Style></DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="1.2*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="1.25*"/>
                <DataGridTextColumn Header="Límite (USD)" Binding="{Binding CreditLimit, StringFormat={}{0:N2}}" Width="1.1*"/>
                <DataGridTextColumn Header="Saldo (USD)" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="1.05*"/>
                <DataGridTextColumn Header="Equivalente (VES)" Binding="{Binding BalanceVesEquivalent, StringFormat={}{0:N2}}" Width="1.2*"/>
                <DataGridTextColumn Header="Disponible (USD)" Binding="{Binding AvailableCredit, StringFormat={}{0:N2}}" Width="1.15*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,14,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.ColumnSpan="5" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="CustomerFormTitle" Text="Nuevo cliente" FontSize="19" FontWeight="Bold" Foreground="#132D4F"/>
                        <TextBlock Text="El saldo se registra en USD; la referencia en bolívares usa la tasa vigente." FontSize="14" Foreground="#52677F" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button x:Name="SaveCustomerButton" DockPanel.Dock="Right" Content="_Crear cliente" Width="145" Height="40" FontSize="15" Background="#0867D5" Foreground="White" FontWeight="SemiBold" Click="Create_Click" TabIndex="8" AutomationProperties.Name="Crear cliente"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,7,0"><TextBlock Text="Nombre completo" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="NameBox" Height="42" Padding="8" FontSize="16" TabIndex="4"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="7,0"><TextBlock Text="Documento" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="DocumentBox" Height="42" Padding="8" FontSize="16" TabIndex="5"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="7,0"><TextBlock Text="Teléfono" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="PhoneBox" Height="42" Padding="8" FontSize="16" TabIndex="6"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="7,0"><TextBlock Text="Límite de crédito (USD)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="LimitBox" Height="42" Padding="8" FontSize="16" TabIndex="7"/></StackPanel>
                    <Border Grid.Column="4" Margin="7,21,0,0" Background="#EAF0F8" CornerRadius="5" Padding="8" VerticalAlignment="Center"><TextBlock Text="Cuenta: USD" FontSize="15" FontWeight="Bold" Foreground="#132D4F" VerticalAlignment="Center"/></Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="StatusLabel" Grid.Row="0" Foreground="#52677F" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <UniformGrid Grid.Row="1" Columns="3">
                <Button x:Name="EditCustomerButton" Style="{StaticResource CustomerFooterButton}" Content="_Editar cliente" Click="EditCustomer_Click" IsEnabled="False" TabIndex="9" AutomationProperties.Name="Editar cliente seleccionado"/>
                <Button x:Name="DeleteCustomerButton" Style="{StaticResource CustomerFooterButton}" Content="Elimi_nar cliente" Background="#A3313A" Foreground="White" Click="DeleteCustomer_Click" IsEnabled="False" TabIndex="10" AutomationProperties.Name="Eliminar cliente seleccionado"/>
                <Button x:Name="ReceivablesButton" Style="{StaticResource CustomerFooterButton}" Content="Cuenta de crédito / a_bonos" Click="Receivables_Click" IsEnabled="False" TabIndex="11" AutomationProperties.Name="Abrir cuenta y abonos del cliente"/>
                <Button Style="{StaticResource CustomerFooterButton}" Content="Venta _sin cliente" Click="General_Click" TabIndex="12" AutomationProperties.Name="Continuar venta sin cliente"/>
                <Button Style="{StaticResource CustomerFooterButton}" Content="Ce_rrar" Click="Cancel_Click" TabIndex="13" AutomationProperties.Name="Cerrar clientes"/>
                <Button x:Name="UseCustomerButton" Style="{StaticResource CustomerFooterButton}" Content="_Usar cliente" Background="#0867D5" Foreground="White" FontWeight="Bold" Click="Select_Click" IsEnabled="False" TabIndex="14" AutomationProperties.Name="Asignar cliente seleccionado a la venta"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
