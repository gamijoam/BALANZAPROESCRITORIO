<Window Language="es-VE" x:Class="Pos.Desktop.CustomersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes y crédito" Width="930" Height="680" MinWidth="790" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="CLIENTES Y FIADOS" Foreground="#173F78" FontSize="24" FontWeight="Bold"/><TextBlock Text="Consulta clientes y asígnalos a la venta actual." Foreground="#63758B" Margin="0,4,0,0"/></StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="250" Height="38" Padding="8" VerticalContentAlignment="Center"/><Button Content="Buscar" Width="90" Margin="8,0,0,0" Click="Search_Click"/></StackPanel>
        </DockPanel>
        <DataGrid x:Name="CustomersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" Background="White">
            <DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="170"/><DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="140"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="80"/><DataGridTextColumn Header="Límite de fiado" Binding="{Binding CreditLimit, StringFormat={}{0:N2}}" Width="140"/></DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,8">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <TextBlock Text="Nuevo cliente" FontSize="16" FontWeight="Bold" Grid.ColumnSpan="5" Margin="0,0,0,8"/>
                <TextBox x:Name="NameBox" Grid.Row="1" Height="36" Padding="7" ToolTip="Nombre"/>
                <TextBox x:Name="DocumentBox" Grid.Row="1" Grid.Column="1" Height="36" Padding="7" Margin="8,0,0,0" ToolTip="Documento"/>
                <TextBox x:Name="PhoneBox" Grid.Row="1" Grid.Column="2" Height="36" Padding="7" Margin="8,0,0,0" ToolTip="Teléfono"/>
                <ComboBox x:Name="CurrencyBox" Grid.Row="1" Grid.Column="3" Height="36" SelectedIndex="0" Margin="8,0,0,0"><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox>
                <TextBox x:Name="LimitBox" Grid.Row="1" Grid.Column="4" Text="0" Height="36" Padding="7" Margin="8,0,0,0" ToolTip="Límite de crédito"/>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3"><TextBlock x:Name="StatusLabel" Foreground="#52677F" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cuenta / abono" Width="120" Height="40" Margin="0,0,8,0" Click="Receivables_Click"/><Button Content="Venta general" Width="110" Height="40" Margin="0,0,8,0" Click="General_Click"/><Button Content="Cerrar" Width="80" Height="40" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Usar cliente" Width="120" Height="40" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Select_Click"/><Button Content="Crear" Width="80" Height="40" Margin="8,0,0,0" Click="Create_Click"/></StackPanel>
        </DockPanel>
    </Grid>
</Window>

