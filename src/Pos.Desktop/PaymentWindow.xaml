<Window Language="es-VE" x:Class="Pos.Desktop.PaymentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pos.Desktop"
        Title="Cobrar venta" Width="570" Height="520" MinHeight="430" WindowStartupLocation="CenterOwner" Background="#F1F4F8">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#E74D54" CornerRadius="8" Padding="16,12">
            <StackPanel><TextBlock Text="TOTAL A COBRAR" Foreground="#FFE8E8" FontWeight="SemiBold"/><TextBlock x:Name="TotalLabel" Foreground="White" FontSize="32" FontWeight="Bold"/></StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,18,0,10">
            <DockPanel Margin="0,0,0,8"><TextBlock x:Name="PaymentTitle" Text="Formas de pago" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><Button x:Name="AddPaymentButton" DockPanel.Dock="Right" Content="＋ Agregar pago" Padding="12,7" Click="AddPayment_Click"/></DockPanel>
            <DataGrid x:Name="PaymentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="150" RowHeight="42">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Método" Width="*" ItemsSource="{x:Static local:PaymentWindow.PaymentMethods}" SelectedItemBinding="{Binding Method, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn Header="Moneda" Width="85" ItemsSource="{x:Static local:PaymentWindow.Currencies}" SelectedItemBinding="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Monto" Width="150" Binding="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTemplateColumn Header="" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" FontSize="17" Foreground="#B43B42" Click="RemovePayment_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
            <TextBlock Text="Pagado:" Foreground="#63758B" FontSize="15" VerticalAlignment="Center"/>
            <TextBlock x:Name="PaidLabel" FontSize="18" FontWeight="Bold" Margin="8,0,18,0" VerticalAlignment="Center"/>
            <TextBlock Text="Pendiente:" Foreground="#63758B" FontSize="15" VerticalAlignment="Center"/>
            <TextBlock x:Name="DueLabel" FontSize="18" FontWeight="Bold" Foreground="#B43B42" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="ErrorLabel" Foreground="#B43B42" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" Width="95" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="Confirmar venta" Width="145" Height="42" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Confirm_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

