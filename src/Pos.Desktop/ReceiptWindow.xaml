<Window Language="es-VE" x:Class="Pos.Desktop.ReceiptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprobante de venta" Width="480" Height="680" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#F2F5F9" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cerrar" Width="100" Height="42" Margin="0,0,10,0" Click="Close_Click"/>
            <Button Content="Imprimir…" Width="120" Height="42" Click="Print_Click" Style="{StaticResource PosWindow.PrimaryButton}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Border x:Name="ReceiptPaper" Background="White" Padding="24" BorderBrush="#D7DFEA" BorderThickness="1"/></ScrollViewer>
    </DockPanel>
</Window>

