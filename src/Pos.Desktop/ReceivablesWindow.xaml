<Window Language="es-VE" x:Class="Pos.Desktop.ReceivablesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta por cobrar" Width="820" Height="600" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="CustomerTitle" Foreground="#173F78" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="BalanceLabel" Foreground="#63758B" Margin="0,5,0,0"/></StackPanel>
        <DataGrid x:Name="EntriesGrid" Grid.Row="1" Margin="0,12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding OccurredAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="160"/><DataGridTextColumn Header="Tipo" Binding="{Binding EntryType}" Width="110"/><DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="2" Background="White" Padding="12" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Abono" FontWeight="SemiBold"/><TextBox x:Name="AmountBox" Height="36" Padding="7"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Motivo" FontWeight="SemiBold"/><TextBox x:Name="ReasonBox" Height="36" Padding="7"/></StackPanel><Button Grid.Column="2" Content="Registrar abono" Width="140" Height="38" Background="#2858A2" Foreground="White" FontWeight="Bold" VerticalAlignment="Bottom" Click="Payment_Click"/></Grid></Border>
        <DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="StatusLabel" Foreground="#52677F" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Cerrar" Width="90" Height="38" Click="Close_Click"/></DockPanel>
    </Grid>
</Window>

