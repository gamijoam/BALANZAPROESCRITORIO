<Window Language="es-VE" x:Class="Pos.Desktop.ReceivablesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta de crédito" Width="1040" Height="680" MinWidth="900" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CUENTA DE CRÉDITO" Foreground="#173F78" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="CustomerTitle" Foreground="#52677F" FontSize="17" Margin="0,4,0,0"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
            <Border Background="#FFFFFF" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="SALDO PENDIENTE (USD)" Foreground="#63758B" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="BalanceLabel" FontSize="23" FontWeight="Bold" Foreground="#B43B42" Margin="0,5,0,0"/><TextBlock x:Name="BalanceVesLabel" Text="Equivalente en VES: —" FontSize="14" Foreground="#52677F" Margin="0,4,0,0"/></StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="7" Padding="14" Margin="4,0">
                <StackPanel><TextBlock Text="LÍMITE DE CRÉDITO (USD)" Foreground="#63758B" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="CreditLimitLabel" FontSize="23" FontWeight="Bold" Foreground="#173F78" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="7" Padding="14" Margin="8,0,0,0">
                <StackPanel><TextBlock Text="CRÉDITO DISPONIBLE (USD)" Foreground="#63758B" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="AvailableCreditLabel" FontSize="23" FontWeight="Bold" Foreground="#2E8B57" Margin="0,5,0,0"/></StackPanel>
            </Border>
        </UniformGrid>
        <DataGrid x:Name="EntriesGrid" Grid.Row="2" Margin="0,14,0,12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" MinRowHeight="48" FontSize="14" Background="White" BorderBrush="#D7DFEA">
            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="7"/><Setter Property="Height" Value="38"/></Style></DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding DateLabel}" Width="140"/>
                <DataGridTextColumn Header="Movimiento" Binding="{Binding MovementLabel}" Width="130"/>
                <DataGridTextColumn Header="Referencia" Binding="{Binding ReferenceLabel}" Width="135"/>
                <DataGridTextColumn Header="Artículos · valor histórico USD" Binding="{Binding SaleItemsLabel}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="5,3"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Importe del movimiento" Binding="{Binding AmountLabel}" Width="165"/>
                <DataGridTextColumn Header="Saldo después" Binding="{Binding ResultingBalanceLabel}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="7" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Registrar abono" FontSize="19" FontWeight="Bold" Foreground="#173F78"/>
                    <TextBlock Text="  ·  Se permiten pagos parciales hasta cubrir el saldo." FontSize="14" Foreground="#63758B" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="AmountFieldLabel" Text="Monto del abono" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><DockPanel><TextBox x:Name="AmountBox" Height="42" Padding="8" FontSize="16" TextChanged="AmountBox_TextChanged"/><ComboBox x:Name="PaymentCurrencyBox" Width="78" Height="42" Margin="6,0,0,0" FontSize="15" SelectedIndex="0" SelectionChanged="PaymentCurrencyBox_SelectionChanged"><ComboBoxItem Content="USD"/><ComboBoxItem Content="VES"/></ComboBox></DockPanel><TextBlock x:Name="PaymentPreviewLabel" Text="Se descontará del saldo en USD." FontSize="12" Foreground="#52677F" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Referencia (opcional)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="ReferenceBox" Height="42" Padding="8" FontSize="16" MaxLength="250" ToolTip="Número de transferencia u otra referencia del pago"/></StackPanel>
                    <Button x:Name="RecordPaymentButton" Grid.Column="2" Content="Registrar abono" Height="42" Margin="0,23,0,0" Background="#2858A2" Foreground="White" FontSize="15" FontWeight="Bold" Click="Payment_Click"/>
                </Grid>
            </Grid>
        </Border>
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="#52677F" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button DockPanel.Dock="Right" Content="Cerrar" Width="100" Height="42" FontSize="14" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
