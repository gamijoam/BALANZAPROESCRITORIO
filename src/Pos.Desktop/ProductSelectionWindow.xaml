<Window x:Class="Pos.Desktop.ProductSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar producto" Language="es-VE" Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#EEF2F7" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleLabel" FontSize="22" FontWeight="Bold" Foreground="#173F78"/>
        <TextBlock Grid.Row="1" Text="Usa ↑ y ↓ para elegir un producto. Presiona Enter para agregarlo o Esc para cancelar."
                   Foreground="#63758B" Margin="0,5,0,12"/>
        <Grid Grid.Row="2" Background="#152B45" Height="42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Código" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Grid.Column="2" Text="Descripción" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Grid.Column="3" Text="Moneda" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Grid.Column="4" Text="Existencia" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0"/>
            <TextBlock Grid.Column="5" Text="Precio" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0"/>
        </Grid>
        <ListBox x:Name="ProductsList" Grid.Row="3" ItemsSource="{Binding}" FontSize="15" BorderBrush="#D7DFEA" BorderThickness="1" Background="White"
                 SelectionMode="Single" SelectionChanged="ProductsList_SelectionChanged" AutomationProperties.Name="Resultados de productos" AutomationProperties.AutomationId="ProductSearchResults">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#172B45"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#E5EAF1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="#2E64B7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Product.StockQuantity}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Product.IsTaxClassified}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.62"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="88" Margin="6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" Background="#EEF2F7" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding ImageSource}" Stretch="Uniform" Margin="2">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding ImagePlaceholderText}" Foreground="#63758B" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Product.Sku}" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,4">
                            <TextBlock Text="{Binding Product.Name}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/>
                            <TextBlock Text="{Binding SaleUnitsSummary}" Foreground="#63758B" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Product.Currency}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding StockLabel}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding Product.PriceLabel}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" HorizontalAlignment="Right" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <TextBlock Text="Se vende como" FontWeight="SemiBold" Foreground="#173F78" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PresentationBox" MinWidth="320" Height="38" SelectionChanged="PresentationBox_SelectionChanged" AutomationProperties.Name="Presentación para vender">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLabel}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="↑ / ↓  Mover    ·    Enter  Agregar    ·    Esc  Cancelar" Foreground="#63758B"/><TextBlock x:Name="SelectionStatusText" Foreground="#B43B42" FontWeight="SemiBold"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Width="110" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="AddProductButton" Content="Agregar producto" Width="170" Height="42" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Select_Click" IsEnabled="False"
                        AutomationProperties.AutomationId="AddSelectedProduct"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
