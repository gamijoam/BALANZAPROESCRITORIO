<Window x:Class="Pos.Desktop.ProductSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar producto" Language="es-VE" Width="760" Height="520" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#EEF2F7" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleLabel" FontSize="22" FontWeight="Bold" Foreground="#173F78"/>
        <TextBlock Grid.Row="1" Text="Usa ↑ y ↓ para moverte; Enter agrega el producto seleccionado." Foreground="#63758B" Margin="0,5,0,12"/>
        <ListBox x:Name="ProductsList" Grid.Row="2" ItemsSource="{Binding}" FontSize="15" BorderBrush="#D7DFEA" BorderThickness="1" Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Sku}" FontWeight="Bold" Foreground="#2858A2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding PriceLabel}" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="110" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Agregar producto" Width="160" Height="40" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Select_Click"/>
        </StackPanel>
    </Grid>
</Window>
