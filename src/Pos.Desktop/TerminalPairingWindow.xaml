<Window x:Class="Pos.Desktop.TerminalPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorizar caja local" Width="500" Height="430" MinWidth="460" MinHeight="390"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F1F4F8"
        AutomationProperties.Name="Emparejar la caja local con el servidor POS">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="AUTORIZAR CAJA LOCAL" Foreground="#173F78" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="El servidor necesita autorizar esta caja antes de permitir el inicio de sesión." Foreground="#63758B" FontSize="14" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18">
            <TextBlock Text="Usuario administrador" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox" Height="40" Padding="9" FontSize="15"
                     AutomationProperties.Name="Usuario administrador"/>
            <TextBlock Text="PIN de administrador" FontWeight="SemiBold" Margin="0,14,0,5"/>
            <PasswordBox x:Name="PinBox" Height="40" Padding="9" FontSize="15"
                         AutomationProperties.Name="PIN de administrador"/>
            <TextBlock x:Name="ErrorText" Foreground="#B43B42" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="38"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="110" Height="42" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="PairButton" Content="Autorizar caja" Width="150" Height="42" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Pair_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
