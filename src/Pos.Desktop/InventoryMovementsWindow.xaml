<Window x:Class="Pos.Desktop.InventoryMovementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de inventario" Width="1300" Height="780" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="HISTORIAL DEL PRODUCTO" FontSize="22" FontWeight="Bold" Foreground="#173F78" />
            <TextBlock x:Name="ProductLabel" Margin="0,3,0,0" Foreground="#52677F" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Las cantidades negativas descuentan; las positivas reponen existencias."
                       Margin="0,3,0,0" Foreground="#63758B" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl x:Name="HistoryTabs" Grid.Row="1" SelectionChanged="HistoryTabs_SelectionChanged">
            <TabItem Header="Ajustes y ventas">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="MovementsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              EnableRowVirtualization="True" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0"
                              Background="White" BorderBrush="#D7DFEA" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha local" Binding="{Binding OccurredAtLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="155" />
                            <DataGridTextColumn x:Name="MovementChangeColumn" Header="Cambio" Binding="{Binding QuantityDelta, StringFormat={}{0:+0.###;-0.###;0}}" Width="120" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" />
                            <DataGridTextColumn Header="Operador" Binding="{Binding OperatorLabel}" Width="165" />
                            <DataGridTextColumn Header="Terminal (ID)" Binding="{Binding TerminalId}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PageStatus" VerticalAlignment="Center" Foreground="#52677F" Text="Cargando movimientos…" />
                        <Button x:Name="PreviousPageButton" Grid.Column="1" Content="‹ Anterior" Width="100" Height="34" Margin="8,0,0,0" Click="PreviousPage_Click" IsEnabled="False" />
                        <Button x:Name="NextPageButton" Grid.Column="2" Content="Siguiente ›" Width="100" Height="34" Margin="8,0,0,0" Click="NextPage_Click" IsEnabled="False" />
                        <Button Grid.Column="3" Content="Cerrar" Width="90" Height="34" Margin="8,0,0,0" IsCancel="True" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="TransfersTab" Header="Traslados" Visibility="Collapsed">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="TransfersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              EnableRowVirtualization="True" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0"
                              Background="White" BorderBrush="#D7DFEA" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha local" Binding="{Binding OccurredAtLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="155" />
                            <DataGridTextColumn Header="Movimiento" Binding="{Binding MovementType}" Width="110" />
                            <DataGridTextColumn x:Name="TransferChangeColumn" Header="Cambio" Binding="{Binding QuantityDelta, StringFormat={}{0:+0.###;-0.###;0}}" Width="110" />
                            <DataGridTextColumn Header="Ruta del traslado" Binding="{Binding WarehouseRoute}" Width="*" />
                            <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="130" />
                            <DataGridTextColumn Header="Operador" Binding="{Binding OperatorLabel}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TransferPageStatus" VerticalAlignment="Center" Foreground="#52677F" Text="Selecciona esta pestaña para cargar los traslados." />
                        <Button x:Name="PreviousTransferPageButton" Grid.Column="1" Content="‹ Anterior" Width="100" Height="34" Margin="8,0,0,0" Click="PreviousTransferPage_Click" IsEnabled="False" />
                        <Button x:Name="NextTransferPageButton" Grid.Column="2" Content="Siguiente ›" Width="100" Height="34" Margin="8,0,0,0" Click="NextTransferPage_Click" IsEnabled="False" />
                        <Button Grid.Column="3" Content="Cerrar" Width="90" Height="34" Margin="8,0,0,0" IsCancel="True" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
