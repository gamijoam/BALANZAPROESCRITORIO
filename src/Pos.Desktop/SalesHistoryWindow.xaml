<Window x:Class="Pos.Desktop.SalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de ventas" Language="es-VE" Width="1320" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#EEF2F7" FontSize="14">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="HISTORIAL DE VENTAS" Foreground="#173F78" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Consulta ventas, pagos y devoluciones." Foreground="#63758B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Desde" FontWeight="SemiBold" Margin="0,0,0,4"/><DatePicker x:Name="FromDatePicker" Width="140" Height="34"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Hasta" FontWeight="SemiBold" Margin="0,0,0,4"/><DatePicker x:Name="ToDatePicker" Width="140" Height="34"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Moneda" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox x:Name="CurrencyPicker" Width="110" Height="34" SelectedIndex="0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Buscar venta, cliente o producto" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBox x:Name="SearchBox" Width="300" Height="34" Padding="8" ToolTip="Número, cliente, código o descripción" TextChanged="SearchBox_TextChanged"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Método de pago" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox x:Name="PaymentMethodFilterBox" Width="150" Height="34" SelectedIndex="0"><ComboBoxItem Content="Todos los métodos"/><ComboBoxItem Content="Efectivo"/><ComboBoxItem Content="Punto de venta"/><ComboBoxItem Content="Transferencia"/><ComboBoxItem Content="Pago móvil"/><ComboBoxItem Content="Crédito"/></ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Operador" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBox x:Name="OperatorFilterBox" Width="140" Height="34" Padding="8" ToolTip="Nombre o parte del nombre del operador"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,0,0,4"/><ComboBox x:Name="SaleStatusFilterBox" Width="165" Height="34" SelectedIndex="0"><ComboBoxItem Content="Todos los estados"/><ComboBoxItem Content="Confirmada"/><ComboBoxItem Content="Devuelta parcialmente"/><ComboBoxItem Content="Devuelta"/></ComboBox></StackPanel>
                <Button Content="Consultar" Width="115" Height="34" VerticalAlignment="Bottom" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Search_Click"/>
                <Button Content="Limpiar filtros" Padding="10,5" Height="34" VerticalAlignment="Bottom" Click="ClearFilters_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="0.48*" MinHeight="190"/><RowDefinition Height="0.52*" MinHeight="220"/></Grid.RowDefinitions>
            <Border x:Name="SalesListPanel" Grid.Row="0" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="PreviousPageButton" Content="‹ Anterior" Padding="10,5" Click="PreviousPage_Click"/>
                            <TextBlock x:Name="PageLabel" Text="Página 1" Margin="8,0" VerticalAlignment="Center"/>
                            <Button x:Name="NextPageButton" Content="Siguiente ›" Padding="10,5" Click="NextPage_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SalesSummary" Text="Consulta un período para mostrar las ventas." Foreground="#173F78" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DataGrid x:Name="SalesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SalesGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.º venta" Binding="{Binding Number}" Width="100"/>
                            <DataGridTextColumn Header="Fecha y hora" Binding="{Binding LocalDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*" MinWidth="150"/>
                            <DataGridTemplateColumn Header="Total y referencia" Width="190">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReferenceLabel}" Foreground="#52677F" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Monedas recibidas" Width="185">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PaymentsLabel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="155"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="SaleDetailsPanel" Grid.Row="1" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="PrintReceiptButton" Content="Reimprimir comprobante" Width="190" Height="36" Margin="0,0,8,0" IsEnabled="False" Click="PrintReceipt_Click"/>
                            <Button x:Name="ReturnSaleButton" Content="Registrar devolución" Width="180" Height="36" Background="#2858A2" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="ReturnSale_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="ARTÍCULOS DE LA VENTA" Foreground="#173F78" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="SaleSelectionSummary" Text="Selecciona una venta para ver sus artículos." Foreground="#63758B" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="PreviewLinesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="150"/>
                            <DataGridTextColumn Header="Artículo" Binding="{Binding DisplayDescription}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="100"/>
                            <DataGridTextColumn Header="Devuelto" Binding="{Binding ReturnedQuantity, StringFormat={}{0:0.###}}" Width="100"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="PaymentDetailsPanel" Grid.Row="2" Background="#F4F7FB" Padding="8" CornerRadius="4" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="FORMAS DE PAGO" Foreground="#173F78" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ReceiptPayments" TextWrapping="Wrap" Foreground="#52677F"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Cerrar" Width="110" Height="40" DockPanel.Dock="Right" Click="Close_Click"/>
            <TextBlock x:Name="StatusText" Foreground="#52677F" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
