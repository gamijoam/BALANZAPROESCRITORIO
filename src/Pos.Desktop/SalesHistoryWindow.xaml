<Window x:Class="Pos.Desktop.SalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de ventas" Language="es-VE" Width="1420" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#F2F5F9" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="18,10" Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ventas" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Consulta ventas, pagos, comprobantes y devoluciones." Foreground="#D7E3F2" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Buscar ventas" Foreground="{StaticResource PosWindow.Text}" FontSize="15" FontWeight="Bold" Margin="0,0,0,9"/>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Desde" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><DatePicker x:Name="FromDatePicker" Width="145" Height="40"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Hasta" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><DatePicker x:Name="ToDatePicker" Width="145" Height="40"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Moneda" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><ComboBox x:Name="CurrencyPicker" Width="118" Height="40" SelectedIndex="0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Venta, cliente o producto" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><TextBox x:Name="SearchBox" Width="255" Height="40" Padding="9" ToolTip="Número, cliente, código o descripción" TextChanged="SearchBox_TextChanged"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Forma de pago" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><ComboBox x:Name="PaymentMethodFilterBox" Width="155" Height="40" SelectedIndex="0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="Efectivo"/><ComboBoxItem Content="Punto de venta"/><ComboBoxItem Content="Transferencia"/><ComboBoxItem Content="Pago móvil"/><ComboBoxItem Content="Crédito"/></ComboBox></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Operador" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><TextBox x:Name="OperatorFilterBox" Width="145" Height="40" Padding="9" ToolTip="Nombre o parte del nombre del operador"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Estado" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><ComboBox x:Name="SaleStatusFilterBox" Width="176" Height="40" SelectedIndex="0"><ComboBoxItem Content="Todos los estados"/><ComboBoxItem Content="Confirmada"/><ComboBoxItem Content="Devuelta parcialmente"/><ComboBoxItem Content="Devuelta"/></ComboBox></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <Button Content="Consultar" MinWidth="112" Height="42" Margin="0,0,8,0" Style="{StaticResource PosWindow.PrimaryButton}" Click="Search_Click"/>
                        <Button Content="Limpiar" MinWidth="100" Height="42" Click="ClearFilters_Click"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="0.48*" MinHeight="190"/><RowDefinition Height="0.52*" MinHeight="220"/></Grid.RowDefinitions>
            <Border x:Name="SalesListPanel" Grid.Row="0" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,9">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PreviousPageButton" Content="‹ Anterior" MinWidth="105" Height="42" Click="PreviousPage_Click"/>
                            <TextBlock x:Name="PageLabel" Text="Página 1" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource PosWindow.Muted}"/>
                            <Button x:Name="NextPageButton" Content="Siguiente ›" MinWidth="105" Height="42" Click="NextPage_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Resultados" Foreground="{StaticResource PosWindow.Text}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="SalesSummary" Text="Consulta un período para mostrar las ventas." Foreground="{StaticResource PosWindow.Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="SalesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SalesGrid_SelectionChanged" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.º venta" Binding="{Binding Number}" Width="105"/>
                            <DataGridTextColumn Header="Fecha y hora" Binding="{Binding LocalDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="155"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*" MinWidth="150"/>
                            <DataGridTemplateColumn Header="Total y referencia" Width="195"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReferenceLabel}" Foreground="#52677F" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Pagos" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PaymentsLabel}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="SaleDetailsPanel" Grid.Row="1" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,9">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="PrintReceiptButton" Content="Imprimir comprobante" MinWidth="190" Height="42" Margin="0,0,8,0" IsEnabled="False" Click="PrintReceipt_Click"/>
                            <Button x:Name="ReturnSaleButton" Content="Registrar devolución" MinWidth="190" Height="42" Style="{StaticResource PosWindow.PrimaryButton}" IsEnabled="False" Click="ReturnSale_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Detalle de la venta" Foreground="{StaticResource PosWindow.Text}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="SaleSelectionSummary" Text="Selecciona una venta para ver sus artículos." Foreground="{StaticResource PosWindow.Muted}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="PreviewLinesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="150"/>
                            <DataGridTextColumn Header="Artículo" Binding="{Binding DisplayDescription}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="105"/>
                            <DataGridTextColumn Header="Devuelto" Binding="{Binding ReturnedQuantity, StringFormat={}{0:0.###}}" Width="105"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="PaymentDetailsPanel" Grid.Row="2" Background="#F4F7FB" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,9,0,0">
                        <StackPanel><TextBlock Text="Formas de pago" Foreground="{StaticResource PosWindow.Text}" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/><TextBlock x:Name="ReceiptPayments" TextWrapping="Wrap" Foreground="{StaticResource PosWindow.Muted}"/></StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <Button Content="Cerrar" MinWidth="110" Height="42" DockPanel.Dock="Right" Click="Close_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource PosWindow.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
