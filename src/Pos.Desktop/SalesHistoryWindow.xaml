<Window x:Class="Pos.Desktop.SalesHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de ventas" Language="es-VE" Width="1540" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="18,10" Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Historial de ventas" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Consulta comprobantes, artículos, pagos y devoluciones." Foreground="#D7E3F2" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Buscar ventas" Foreground="{StaticResource PosWindow.Text}" FontSize="15" FontWeight="Bold" Margin="0,0,0,9"/>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Desde" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><DatePicker x:Name="FromDatePicker" Width="145" Height="40"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Hasta" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><DatePicker x:Name="ToDatePicker" Width="145" Height="40"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Moneda" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><ComboBox x:Name="CurrencyPicker" Width="118" Height="40" SelectedIndex="0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Venta, cliente o producto" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><TextBox x:Name="SearchBox" Width="235" Height="40" Padding="9" ToolTip="Número, cliente, código o descripción" TextChanged="SearchBox_TextChanged"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Forma de pago" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><ComboBox x:Name="PaymentMethodFilterBox" Width="145" Height="40" SelectedIndex="0"><ComboBoxItem Content="Todas" Tag=""/><ComboBoxItem Content="Efectivo" Tag="Efectivo"/><ComboBoxItem Content="Punto de venta" Tag="Punto de venta"/><ComboBoxItem Content="Transferencia" Tag="Transferencia"/><ComboBoxItem Content="Pago móvil" Tag="Pago móvil"/><ComboBoxItem Content="Crédito" Tag="Crédito"/></ComboBox></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Operador" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><TextBox x:Name="OperatorFilterBox" Width="130" Height="40" Padding="9" ToolTip="Nombre o parte del nombre del operador"/></StackPanel>
                    <StackPanel Margin="0,0,9,5"><TextBlock Text="Estado" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/><ComboBox x:Name="SaleStatusFilterBox" Width="170" Height="40" SelectedIndex="0"><ComboBoxItem Content="Todos los estados"/><ComboBoxItem Content="Confirmada"/><ComboBoxItem Content="Devuelta parcialmente"/><ComboBoxItem Content="Devuelta"/></ComboBox></StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <Button Content="Consultar" MinWidth="105" Height="40" Margin="0,0,8,0" Style="{StaticResource PosWindow.PrimaryButton}" Click="Search_Click"/>
                        <Button Content="Limpiar" MinWidth="90" Height="40" Click="ClearFilters_Click"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*" MinWidth="620"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*" MinWidth="390"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,9">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PreviousPageButton" Content="‹ Anterior" MinWidth="100" Height="40" Click="PreviousPage_Click"/>
                            <TextBlock x:Name="PageLabel" Text="Página 1" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource PosWindow.Muted}"/>
                            <Button x:Name="NextPageButton" Content="Siguiente ›" MinWidth="100" Height="40" Click="NextPage_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ventas encontradas" Foreground="{StaticResource PosWindow.Text}" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="SalesSummary" Text="Consulta un período para mostrar las ventas." Foreground="{StaticResource PosWindow.Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="SalesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SalesGrid_SelectionChanged" MouseDoubleClick="SalesGrid_MouseDoubleClick" HeadersVisibility="Column" AutomationProperties.Name="Ventas encontradas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.º venta" Binding="{Binding Number}" Width="105"/>
                            <DataGridTextColumn Header="Fecha y hora" Binding="{Binding LocalDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*" MinWidth="125"/>
                            <DataGridTemplateColumn Header="Total y referencia" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReferenceLabel}" Foreground="#52677F" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,10" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Detalle de la venta" Foreground="{StaticResource PosWindow.Text}" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="SaleSelectionSummary" Text="Selecciona una venta." Foreground="{StaticResource PosWindow.Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="PrintReceiptButton" Content="Comprobante" MinWidth="112" Height="40" Margin="0,0,6,0" IsEnabled="False" Click="PrintReceipt_Click" ToolTip="Abrir vista del comprobante"/>
                            <Button x:Name="ReturnSaleButton" Content="Devolución" MinWidth="105" Height="40" Style="{StaticResource PosWindow.PrimaryButton}" IsEnabled="False" Click="ReturnSale_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#F4F7FB" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CLIENTE" Foreground="{StaticResource PosWindow.Muted}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="SaleCustomerText" Text="—" Foreground="{StaticResource PosWindow.Text}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,1,12,5"/>
                                <TextBlock x:Name="SaleOperatorText" Text="Operador: —" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SaleDateText" Text="Fecha: —" Foreground="{StaticResource PosWindow.Muted}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="SaleStatusText" Text="—" Foreground="{StaticResource PosWindow.Primary}" FontSize="12" FontWeight="Bold" TextAlignment="Right"/>
                                <TextBlock x:Name="SaleTotalText" Text="—" Foreground="{StaticResource PosWindow.Navy}" FontSize="21" FontWeight="Bold" TextAlignment="Right" Margin="0,4,0,0"/>
                                <TextBlock x:Name="SaleReferenceText" Text="" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" TextAlignment="Right"/>
                                <TextBlock x:Name="SaleNetText" Text="" Foreground="{StaticResource PosWindow.Text}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Artículos" Foreground="{StaticResource PosWindow.Text}" FontSize="14" FontWeight="Bold" Margin="2,2,0,7"/>
                        <DataGrid x:Name="PreviewLinesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" AutomationProperties.Name="Artículos de la venta seleccionada">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Artículo" Width="*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="3,2"><TextBlock Text="{Binding DisplayDescription}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Sku}" Foreground="{StaticResource PosWindow.Muted}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cant." Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="58"/>
                                <DataGridTextColumn Header="Dev." Binding="{Binding ReturnedQuantity, StringFormat={}{0:0.###}}" Width="58"/>
                                <DataGridTextColumn Header="P. unit" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="72"/>
                                <DataGridTextColumn Header="Importe" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Row="3" Background="#F4F7FB" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="Formas de pago" Foreground="{StaticResource PosWindow.Text}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ReceiptPayments" Text="Selecciona una venta para consultar sus pagos." TextWrapping="Wrap" Foreground="{StaticResource PosWindow.Muted}" MaxHeight="58"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <Button Content="Cerrar" MinWidth="110" Height="42" DockPanel.Dock="Right" Click="Close_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource PosWindow.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
