<Window Language="es-VE" x:Class="Pos.Desktop.InventoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario" Width="1540" Height="900" MinWidth="1080" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="18,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Inventario" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="InventorySummary" Foreground="#D7E3F2" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋  Nuevo producto" MinWidth="168" Margin="0,0,9,0" Style="{StaticResource PosWindow.SuccessButton}" Click="NewProduct_Click" AutomationProperties.Name="Crear producto nuevo"/>
                    <Button Content="↻  Actualizar" MinWidth="128" Style="{StaticResource PosWindow.HeaderButton}" Click="Refresh_Click" AutomationProperties.Name="Actualizar inventario"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,9">
            <StackPanel>
                <TextBlock Text="Buscar y filtrar productos" Foreground="{StaticResource PosWindow.Text}" FontSize="15" FontWeight="Bold" Margin="0,0,0,9"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBox x:Name="FilterQueryBox" Width="300" Height="42" Margin="0,0,8,0" Padding="12,8" VerticalContentAlignment="Center" ToolTip="Buscar por SKU o nombre" KeyDown="FilterQuery_KeyDown" AutomationProperties.Name="Buscar por SKU o nombre"/>
                    <ComboBox x:Name="StatusFilter" Width="132" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por estado"><ComboBoxItem Content="Activos"/><ComboBoxItem Content="Inactivos"/><ComboBoxItem Content="Todos"/></ComboBox>
                    <ComboBox x:Name="CurrencyFilter" Width="142" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por moneda"><ComboBoxItem Content="Moneda: todas"/><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox>
                    <ComboBox x:Name="StockFilter" Width="168" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por existencia"><ComboBoxItem Content="Existencia: todas"/><ComboBoxItem Content="Con existencia"/><ComboBoxItem Content="Agotados"/><ComboBoxItem Content="Bajo mínimo"/></ComboBox>
                    <ComboBox x:Name="ImageFilter" Width="132" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por foto"><ComboBoxItem Content="Foto: todas"/><ComboBoxItem Content="Con foto"/><ComboBoxItem Content="Sin foto"/></ComboBox>
                    <Button Content="Aplicar filtros" Height="42" Margin="0,0,8,0" Style="{StaticResource PosWindow.PrimaryButton}" Click="ApplyFilters_Click" AutomationProperties.Name="Aplicar filtros"/>
                    <Button Content="Limpiar" Height="42" Click="ClearFilters_Click" AutomationProperties.Name="Limpiar filtros"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="8,3" Margin="0,0,0,9">
            <WrapPanel x:Name="InventoryExtensionsPanel" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock DockPanel.Dock="Right" Text="Doble clic para abrir la ficha" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Productos" Foreground="{StaticResource PosWindow.Text}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="InventoryGrid" Grid.Row="1" SelectionChanged="InventoryGrid_SelectionChanged" MouseDoubleClick="InventoryGrid_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                              SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" AutomationProperties.Name="Productos del inventario">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="125"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Existencia" Binding="{Binding QuantityLabel}" Width="125"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="105"/>
                            <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="78"/>
                            <DataGridTextColumn Header="Impuesto" Binding="{Binding TaxTreatmentLabel}" Width="145"/>
                            <DataGridTextColumn Header="Foto" Binding="{Binding ImageStatusLabel}" Width="70"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding ActiveStatusLabel}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ProductDetailsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Border Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Producto seleccionado" Foreground="{StaticResource PosWindow.Text}" FontSize="16" FontWeight="Bold"/>
                        <StackPanel Grid.Row="1" Margin="0,8,0,10">
                            <TextBlock x:Name="SelectedProductName" Text="Selecciona un producto" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SelectedProductSku" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" Margin="0,3,0,0"/>
                            <TextBlock x:Name="SelectedProductCost" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" Margin="0,3,0,0"/>
                            <TextBlock x:Name="SelectedProductMinimum" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Background="#F4F7FB" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Image x:Name="ProductImagePreview" Stretch="Uniform" MaxWidth="260" MaxHeight="145" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="6"/>
                                <TextBlock x:Name="ProductImagePlaceholder" Text="La foto del producto aparecerá aquí." Foreground="{StaticResource PosWindow.Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ImageStatusLabel" Grid.Row="3" Foreground="{StaticResource PosWindow.Muted}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                        <Grid Grid.Row="4" Margin="0,2,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="UploadImageButton" Content="Subir o cambiar foto" Margin="0,0,4,0" Style="{StaticResource PosWindow.PrimaryButton}" Click="ProductImage_Click" IsEnabled="False"/>
                            <Button x:Name="RemoveImageButton" Grid.Column="1" Content="Quitar foto" Margin="4,0,0,0" Style="{StaticResource PosWindow.DangerButton}" Click="RemoveImage_Click" IsEnabled="False"/>
                        </Grid>
                        <Grid Grid.Row="5" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="EditProductButton" Content="Abrir ficha" Margin="0,0,4,0" Style="{StaticResource PosWindow.PrimaryButton}" Click="EditProduct_Click" IsEnabled="False" ToolTip="Abre los datos, unidades y presentaciones del producto."/>
                            <Button x:Name="ChangePriceButton" Grid.Column="1" Content="Cambiar precio" Margin="4,0,0,0" Click="ChangePrice_Click" IsEnabled="False"/>
                        </Grid>
                        <Button x:Name="InitializeCostButton" Grid.Row="6" Content="Asignar costo inicial" Margin="0,0,0,7" Click="InitializeCost_Click" IsEnabled="False" AutomationProperties.Name="Asignar costo inicial del inventario" ToolTip="Solo para existencias que todavía no tienen costo promedio."/>
                        <Button x:Name="ToggleProductActiveButton" Grid.Row="7" Content="Desactivar producto" Margin="0,0,0,7" Style="{StaticResource PosWindow.DangerButton}" Click="ToggleProductActive_Click" IsEnabled="False"/>
                        <TextBlock x:Name="TaxTreatmentStatusLabel" Grid.Row="8" Foreground="{StaticResource PosWindow.Muted}" TextWrapping="Wrap" Margin="0,4,0,5"/>
                        <Button x:Name="ChangeTaxTreatmentButton" Grid.Row="9" Content="Asignar impuesto" Click="ChangeTaxTreatment_Click" IsEnabled="False" AutomationProperties.Name="Asignar tratamiento de impuesto al producto"/>
                        <Button Grid.Row="10" Content="Ver historial de movimientos" Margin="0,7,0,0" Click="History_Click"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="155"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Ajustar existencia" Foreground="{StaticResource PosWindow.Text}" FontWeight="Bold" FontSize="15"/><TextBlock Text="Suma o descuenta unidades" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock x:Name="AdjustUnitLabel" Text="Cantidad (+/−)" FontWeight="SemiBold" FontSize="12"/><TextBox x:Name="DeltaBox" Text="1" Height="42" AutomationProperties.Name="Cantidad a sumar o descontar"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Motivo" FontWeight="SemiBold" FontSize="12"/><TextBox x:Name="ReasonBox" Height="42" AutomationProperties.Name="Motivo del ajuste de existencia"/></StackPanel>
                <TextBlock x:Name="StatusLabel" Grid.Column="3" Foreground="{StaticResource PosWindow.Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0"/>
                <Button x:Name="AdjustButton" Grid.Column="4" Content="Aplicar ajuste" Style="{StaticResource PosWindow.PrimaryButton}" Click="Adjust_Click" IsEnabled="False" AutomationProperties.Name="Aplicar ajuste de existencia"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" Text="Selecciona un producto para consultar la foto, modificar datos o ver sus movimientos." Foreground="{StaticResource PosWindow.Muted}" Margin="2,7,0,0" FontSize="12"/>
    </Grid>
</Window>
