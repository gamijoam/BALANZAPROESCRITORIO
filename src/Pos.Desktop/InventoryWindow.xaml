<Window Language="es-VE" x:Class="Pos.Desktop.InventoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario" Width="1540" Height="900" MinWidth="1080" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="18,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Inventario" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="InventorySummary" Foreground="#D7E3F2" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋  Nuevo producto" MinWidth="168" Margin="0,0,9,0" Style="{StaticResource PosWindow.SuccessButton}" Click="NewProduct_Click" AutomationProperties.Name="Crear producto nuevo"/>
                    <Button Content="↻  Actualizar" MinWidth="128" Style="{StaticResource PosWindow.HeaderButton}" Click="Refresh_Click" AutomationProperties.Name="Actualizar inventario"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,9">
            <StackPanel>
                <TextBlock Text="Buscar y filtrar productos" Foreground="{StaticResource PosWindow.Text}" FontSize="15" FontWeight="Bold" Margin="0,0,0,9"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBox x:Name="FilterQueryBox" Width="300" Height="42" Margin="0,0,8,0" Padding="12,8" VerticalContentAlignment="Center" ToolTip="Buscar por SKU o nombre" KeyDown="FilterQuery_KeyDown" AutomationProperties.Name="Buscar por SKU o nombre"/>
                    <ComboBox x:Name="StatusFilter" Width="132" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por estado"><ComboBoxItem Content="Activos"/><ComboBoxItem Content="Inactivos"/><ComboBoxItem Content="Todos"/></ComboBox>
                    <ComboBox x:Name="CurrencyFilter" Width="142" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por moneda"><ComboBoxItem Content="Moneda: todas"/><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox>
                    <ComboBox x:Name="StockFilter" Width="168" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por existencia"><ComboBoxItem Content="Existencia: todas"/><ComboBoxItem Content="Con existencia"/><ComboBoxItem Content="Agotados"/><ComboBoxItem Content="Bajo mínimo"/></ComboBox>
                    <ComboBox x:Name="ImageFilter" Width="132" Height="42" Margin="0,0,8,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por foto"><ComboBoxItem Content="Foto: todas"/><ComboBoxItem Content="Con foto"/><ComboBoxItem Content="Sin foto"/></ComboBox>
                    <Button Content="Aplicar filtros" Height="42" Margin="0,0,8,0" Style="{StaticResource PosWindow.PrimaryButton}" Click="ApplyFilters_Click" AutomationProperties.Name="Aplicar filtros"/>
                    <Button Content="Limpiar" Height="42" Click="ClearFilters_Click" AutomationProperties.Name="Limpiar filtros"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="8,3" Margin="0,0,0,9">
            <WrapPanel x:Name="InventoryExtensionsPanel" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock DockPanel.Dock="Right" Text="Doble clic para abrir la ficha" Foreground="{StaticResource PosWindow.Muted}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Productos" Foreground="{StaticResource PosWindow.Text}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="InventoryGrid" Grid.Row="1" SelectionChanged="InventoryGrid_SelectionChanged" MouseDoubleClick="InventoryGrid_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                              SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" AutomationProperties.Name="Productos del inventario">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="135"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="220"/>
                            <DataGridTextColumn Header="Existencia" Binding="{Binding QuantityLabel}" Width="150"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="115"/>
                            <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="90"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding ActiveStatusLabel}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Foto del producto" Foreground="{StaticResource PosWindow.Text}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="#F4F7FB" BorderBrush="{StaticResource PosWindow.Border}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Image x:Name="ProductImagePreview" Stretch="Uniform" MaxWidth="260" MaxHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="8"/>
                            <TextBlock x:Name="ProductImagePlaceholder" Text="Selecciona un producto para ver su foto." Foreground="{StaticResource PosWindow.Muted}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusLabel" Grid.Row="4" Text="Selecciona un producto; haz doble clic para abrir su ficha completa." Foreground="{StaticResource PosWindow.Muted}" Margin="2,7,0,0" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
</Window>
