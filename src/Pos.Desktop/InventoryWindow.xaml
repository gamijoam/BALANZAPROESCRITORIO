<Window Language="es-VE" x:Class="Pos.Desktop.InventoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario" Width="1500" Height="850" MinWidth="1060" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,9">
            <StackPanel><TextBlock Text="INVENTARIO" Foreground="#173F78" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="InventorySummary" Foreground="#63758B" Margin="0,3,0,0"/></StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Nuevo producto" Width="135" Height="36" Margin="0,0,8,0" Click="NewProduct_Click" AutomationProperties.Name="Crear producto nuevo"/>
                <Button Content="Actualizar" Width="100" Height="36" Click="Refresh_Click" AutomationProperties.Name="Actualizar inventario"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="FilterQueryBox" Height="34" Padding="7" VerticalContentAlignment="Center" ToolTip="Buscar por SKU o nombre" KeyDown="FilterQuery_KeyDown" AutomationProperties.Name="Buscar por SKU o nombre"/>
            <ComboBox x:Name="StatusFilter" Grid.Column="1" Height="34" Margin="7,0,0,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por estado"><ComboBoxItem Content="Activos"/><ComboBoxItem Content="Inactivos"/><ComboBoxItem Content="Todos"/></ComboBox>
            <ComboBox x:Name="CurrencyFilter" Grid.Column="2" Height="34" Margin="7,0,0,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por moneda"><ComboBoxItem Content="Moneda: todas"/><ComboBoxItem Content="VES"/><ComboBoxItem Content="USD"/></ComboBox>
            <ComboBox x:Name="StockFilter" Grid.Column="3" Height="34" Margin="7,0,0,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por existencia"><ComboBoxItem Content="Existencia: todas"/><ComboBoxItem Content="Con existencia"/><ComboBoxItem Content="Agotados"/><ComboBoxItem Content="Bajo mínimo"/></ComboBox>
            <ComboBox x:Name="ImageFilter" Grid.Column="4" Height="34" Margin="7,0,0,0" SelectedIndex="0" AutomationProperties.Name="Filtrar por foto"><ComboBoxItem Content="Foto: todas"/><ComboBoxItem Content="Con foto"/><ComboBoxItem Content="Sin foto"/></ComboBox>
            <Button Grid.Column="5" Content="Filtrar" Width="75" Height="34" Margin="7,0,0,0" Click="ApplyFilters_Click" Background="#2858A2" Foreground="White" AutomationProperties.Name="Aplicar filtros"/>
            <Button Grid.Column="6" Content="Limpiar" Width="75" Height="34" Margin="7,0,0,0" Click="ClearFilters_Click" AutomationProperties.Name="Limpiar filtros"/>
        </Grid>
        <WrapPanel x:Name="InventoryExtensionsPanel" Grid.Row="2" Margin="0,0,0,7" VerticalAlignment="Center"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="InventoryGrid" SelectionChanged="InventoryGrid_SelectionChanged" MouseDoubleClick="InventoryGrid_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                      SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" Background="White" BorderBrush="#D7DFEA" FontSize="14" AutomationProperties.Name="Productos del inventario">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Existencia" Binding="{Binding QuantityLabel}" Width="115"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="72"/>
                    <DataGridTextColumn Header="Impuesto" Binding="{Binding TaxTreatmentLabel}" Width="130"/>
                    <DataGridTextColumn Header="Foto" Binding="{Binding ImageStatusLabel}" Width="62"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding ActiveStatusLabel}" Width="82"/>
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer x:Name="ProductDetailsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Border Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="7" Padding="12" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="PRODUCTO SELECCIONADO" Foreground="#173F78" FontSize="15" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Margin="0,4,0,7">
                        <TextBlock x:Name="SelectedProductName" Text="Selecciona un producto" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SelectedProductSku" Foreground="#63758B" FontSize="12" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SelectedProductCost" Foreground="#63758B" FontSize="12" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SelectedProductMinimum" Foreground="#63758B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#F2F5F9" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Image x:Name="ProductImagePreview" Stretch="Uniform" MaxWidth="260" MaxHeight="100" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="5"/>
                            <TextBlock x:Name="ProductImagePlaceholder" Text="Selecciona un producto para consultar su foto." Foreground="#63758B" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ImageStatusLabel" Grid.Row="3" Text="" Foreground="#52677F" TextWrapping="Wrap" Margin="0,5,0,5"/>
                    <Grid Grid.Row="4" Margin="0,2,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="UploadImageButton" Content="Subir/cambiar foto" Height="32" Margin="0,0,4,0" Background="#2858A2" Foreground="White" FontWeight="SemiBold" Click="ProductImage_Click" IsEnabled="False"/>
                        <Button x:Name="RemoveImageButton" Grid.Column="1" Content="Quitar foto" Height="32" Margin="4,0,0,0" Click="RemoveImage_Click" IsEnabled="False"/>
                    </Grid>
                    <Grid Grid.Row="5" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="EditProductButton" Content="Ficha completa" Height="32" Margin="0,0,4,0" Click="EditProduct_Click" IsEnabled="False" ToolTip="Abre los datos, unidades y presentaciones del producto."/>
                        <Button x:Name="ChangePriceButton" Grid.Column="1" Content="Cambiar precio" Height="32" Margin="4,0,0,0" Click="ChangePrice_Click" IsEnabled="False"/>
                    </Grid>
                    <Button x:Name="InitializeCostButton" Grid.Row="6" Content="Asignar costo inicial" Height="32" Margin="0,2,0,4" Click="InitializeCost_Click" IsEnabled="False" AutomationProperties.Name="Asignar costo inicial del inventario"
                            ToolTip="Solo para existencias que todavía no tienen costo promedio."/>
                    <Button x:Name="ToggleProductActiveButton" Grid.Row="7" Content="Desactivar producto" Height="32" Click="ToggleProductActive_Click" IsEnabled="False"/>
                    <TextBlock x:Name="TaxTreatmentStatusLabel" Grid.Row="8" Foreground="#52677F" TextWrapping="Wrap" Margin="0,5,0,4"/>
                    <Button x:Name="ChangeTaxTreatmentButton" Grid.Row="9" Content="Asignar impuesto" Height="32" Margin="0,3,0,0" Click="ChangeTaxTreatment_Click" IsEnabled="False" AutomationProperties.Name="Asignar tratamiento de impuesto al producto"/>
                    <Button Grid.Row="10" Content="Historial de movimientos" Height="32" Margin="0,7,0,0" Click="History_Click" AutomationProperties.Name="Ver historial de movimientos"/>
                </Grid>
            </Border>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="4" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="145"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="AJUSTE DE EXISTENCIA" Foreground="#173F78" FontWeight="Bold"/><TextBlock Text="+ repone · − descuenta" Foreground="#63758B" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock x:Name="AdjustUnitLabel" Text="Cantidad (+/−)" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="DeltaBox" Text="1" Height="32" Padding="6" AutomationProperties.Name="Cantidad a sumar o descontar"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Motivo del ajuste" FontWeight="SemiBold" FontSize="11"/><TextBox x:Name="ReasonBox" Height="32" Padding="6" AutomationProperties.Name="Motivo del ajuste de existencia"/></StackPanel>
                <TextBlock x:Name="StatusLabel" Grid.Column="3" Foreground="#52677F" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/>
                <Button x:Name="AdjustButton" Grid.Column="4" Content="Aplicar ajuste" Height="36" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Adjust_Click" IsEnabled="False" AutomationProperties.Name="Aplicar ajuste de existencia"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" Text="Selecciona un producto para ver sus datos y movimientos." Foreground="#63758B" Margin="0,6,0,0"/>
    </Grid>
</Window>
