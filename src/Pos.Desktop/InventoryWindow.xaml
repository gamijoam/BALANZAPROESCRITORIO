<Window Language="es-VE" x:Class="Pos.Desktop.InventoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario" Width="1000" Height="690" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="INVENTARIO" Foreground="#173F78" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="InventorySummary" Foreground="#63758B" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Foto del seleccionado" Width="150" Height="38" Margin="0,0,8,0" Click="ProductImage_Click"/><Button Content="Nuevo producto" Width="125" Height="38" Margin="0,0,8,0" Click="NewProduct_Click"/><Button Content="Actualizar" Width="105" Height="38" Click="Refresh_Click"/></StackPanel></DockPanel>
        <DataGrid x:Name="InventoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0" Background="White">
            <DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="150"/><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Existencia" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="130"/><DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="130"/><DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="85"/></DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Ajuste firmado" FontWeight="SemiBold"/><TextBox x:Name="DeltaBox" Text="1" Height="34" Padding="6"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Motivo" FontWeight="SemiBold"/><TextBox x:Name="ReasonBox" Height="34" Padding="6"/></StackPanel>
                <TextBlock x:Name="StatusLabel" Grid.Column="2" Foreground="#52677F" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0"/>
                <Button Grid.Column="3" Content="Historial" Width="95" Height="40" Margin="6,0" Click="History_Click"/>
                <Button Grid.Column="4" Content="Precio" Width="85" Height="40" Margin="6,0" Click="ChangePrice_Click"/>
                <Button Grid.Column="5" Content="Aplicar ajuste" Width="130" Height="40" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Adjust_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

