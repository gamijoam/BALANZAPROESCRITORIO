<Window x:Class="Pos.Desktop.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar conexión local" Width="540" Height="600" MinWidth="500" MinHeight="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F1F4F8">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CONFIGURACIÓN INICIAL" Foreground="#173F78" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="Indica los datos de una cuenta PostgreSQL con acceso a esta base. Se guardarán cifrados para este usuario de Windows." Foreground="#63758B" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,18">
            <TextBlock Text="Servidor" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="HostBox" Text="127.0.0.1" Height="38" Padding="8" FontSize="15"/>
            <TextBlock Text="Puerto" FontWeight="SemiBold" Margin="0,12,0,5"/>
            <TextBox x:Name="PortBox" Text="5432" Height="38" Padding="8" FontSize="15"/>
            <TextBlock Text="Base de datos" FontWeight="SemiBold" Margin="0,12,0,5"/>
            <TextBox x:Name="DatabaseBox" Text="pos_dev" Height="38" Padding="8" FontSize="15"/>
            <TextBlock Text="Usuario PostgreSQL" FontWeight="SemiBold" Margin="0,12,0,5"/>
            <TextBox x:Name="UsernameBox" Text="pos_app" Height="38" Padding="8" FontSize="15"/>
            <TextBlock Text="Contraseña PostgreSQL" FontWeight="SemiBold" Margin="0,12,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="38" Padding="8" FontSize="15"/>
            <TextBlock Text="La contraseña debe pertenecer al usuario indicado arriba. Si el usuario es pos_app, no uses la contraseña del administrador postgres." Foreground="#63758B" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="#B43B42" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="38"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="110" Height="42" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Guardar y conectar" Width="160" Height="42" Background="#2858A2" Foreground="White" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
