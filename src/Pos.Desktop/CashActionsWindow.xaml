<Window x:Class="Pos.Desktop.CashActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caja" Language="es-VE" Width="480" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Pos.Desktop;component/Styles/PosModernWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PosWindow.Navy}" CornerRadius="9" Padding="16,12"><StackPanel><TextBlock Text="Caja abierta" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="SessionInfo" Foreground="#D7E3F2" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Elige qué deseas hacer con este turno:" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Button Content="Registrar entrada o salida de dinero" Height="48" Click="Movement_Click"/>
            <Button Content="Cerrar turno y hacer arqueo" Height="48" Margin="0,10,0,0" Background="#B91C1C" Foreground="White" BorderBrush="#B91C1C" Click="CloseCash_Click"/>
        </StackPanel>
        <Button Grid.Row="2" Content="Volver a la venta" Width="140" Height="40" HorizontalAlignment="Right" Click="Cancel_Click"/>
    </Grid>
</Window>
