<Window Language="es-VE" x:Class="Pos.Desktop.ProductEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar producto" Width="480" Height="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#102D50" CornerRadius="9" Padding="16,11"><TextBlock Text="Editar producto" Foreground="White" FontSize="21" FontWeight="Bold"/></Border>
        <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="SKU / código" FontWeight="SemiBold"/><TextBox x:Name="SkuBox" Height="38" Padding="8"/></StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Nombre del producto" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="38" Padding="8"/></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Avisar cuando queden (unidades)" FontWeight="SemiBold"/><TextBox x:Name="MinimumStockBox" Height="38" Padding="8"/><TextBlock Text="0 desactiva el aviso para este producto." Foreground="#52677F" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        <TextBlock x:Name="StatusLabel" Grid.Row="4" Foreground="#A3313A" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,10"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Height="38" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Guardar cambios" Width="160" Height="42" Background="#0867D5" Foreground="White" FontWeight="SemiBold" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
