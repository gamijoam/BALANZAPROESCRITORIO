<Window Language="es-VE" x:Class="Pos.Desktop.ProductEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar producto" Width="480" Height="310" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="EDITAR PRODUCTO" Foreground="#173F78" FontSize="22" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="SKU / código" FontWeight="SemiBold"/><TextBox x:Name="SkuBox" Height="38" Padding="8"/></StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Nombre del producto" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Height="38" Padding="8"/></StackPanel>
        <TextBlock x:Name="StatusLabel" Grid.Row="3" Foreground="#A3313A" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,10"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="100" Height="38" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Guardar cambios" Width="145" Height="38" Background="#2858A2" Foreground="White" FontWeight="SemiBold" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
