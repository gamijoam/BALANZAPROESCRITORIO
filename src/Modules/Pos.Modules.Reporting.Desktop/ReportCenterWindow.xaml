<Window x:Class="Pos.Modules.Reporting.Desktop.ReportCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reportes avanzados" Language="es-VE" Width="1420" Height="880" WindowState="Maximized"
        MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#EEF2F7"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" x:Name="ResultCountText" Text="0 filas · 0 columnas" Foreground="#63758B" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="REPORTES" Foreground="#173F78" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Consulta, filtra y organiza la información autorizada." Foreground="#63758B" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Reporte" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ComboBox x:Name="ReportPicker" Width="220" Height="34" DisplayMemberPath="Source.Title" SelectionChanged="ReportPicker_SelectionChanged" AutomationProperties.Name="Tipo de reporte"/>
                <TextBlock Text="Desde" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,7,0"/>
                <DatePicker x:Name="FromDate" Width="130" Height="34"/>
                <TextBlock Text="Hasta" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,7,0"/>
                <DatePicker x:Name="ToDate" Width="130" Height="34"/>
                <TextBlock Text="Moneda" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,7,0"/>
                <ComboBox x:Name="CurrencyPicker" Width="105" Height="34" SelectedIndex="0" AutomationProperties.Name="Filtrar por moneda" SelectionChanged="CurrencyPicker_SelectionChanged">
                    <ComboBoxItem Content="Todas"/><ComboBoxItem Content="USD"/><ComboBoxItem Content="VES"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" Width="190" Height="34" MaxLength="256" Padding="7" Margin="12,0,0,0" VerticalContentAlignment="Center"
                         ToolTip="Buscar en los resultados cargados" AutomationProperties.Name="Buscar en el reporte" TextChanged="SearchBox_TextChanged"/>
                <Button Content="Actualizar" Width="100" Height="34" Margin="8,0,0,0" Click="Refresh_Click" AutomationProperties.Name="Actualizar reporte"/>
                <Button Content="CSV" Width="68" Height="34" Margin="8,0,0,0" Click="ExportCsv_Click" AutomationProperties.Name="Exportar CSV"/>
                <Button Content="Excel" Width="72" Height="34" Margin="6,0,0,0" Click="ExportXlsx_Click" AutomationProperties.Name="Exportar Excel XLSX"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <TextBlock Text="Vistas personales" Foreground="#173F78" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <ComboBox x:Name="SavedViewsPicker" Width="190" Height="32" DisplayMemberPath="Name" SelectionChanged="SavedViewsPicker_SelectionChanged" AutomationProperties.Name="Vistas guardadas"/>
                <TextBox x:Name="ViewNameBox" Width="180" Height="32" Padding="6" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="Nombre de la vista que guardarás" AutomationProperties.Name="Nombre de la vista"/>
                <Button Content="Guardar vista" Height="32" Margin="6,0,0,0" Padding="12,0" Click="SaveView_Click" AutomationProperties.Name="Guardar vista personal"/>
                <Button x:Name="DeleteViewButton" Content="Eliminar" Height="32" Margin="6,0,0,0" Padding="12,0" Click="DeleteView_Click" IsEnabled="False" AutomationProperties.Name="Eliminar vista guardada"/>
                <ToggleButton x:Name="ColumnPickerToggle" Content="Columnas" Height="32" Margin="12,0,0,0" Padding="12,0" Checked="ColumnPickerToggle_Changed" Unchecked="ColumnPickerToggle_Changed" AutomationProperties.Name="Elegir columnas visibles"/>
                <Button Content="Diseñar hoja" Height="32" Margin="6,0,0,0" Padding="12,0" Click="PreviewSheet_Click" ToolTip="Personalizar el formato, guardar una plantilla e imprimir" AutomationProperties.Name="Diseñar hoja del reporte"/>
                <TextBlock Text="Puedes cambiar el orden arrastrando los encabezados." Foreground="#63758B" VerticalAlignment="Center" Margin="12,0,2,0"/>
            </DockPanel>
        </Border>

        <Border x:Name="SummaryPanel" Grid.Row="3" Background="#F4F7FA" BorderBrush="#D5DFEB" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="RESUMEN" Foreground="#173F78" FontWeight="Bold" Margin="2,0,0,6"/>
                <ItemsControl x:Name="SummaryItems" AutomationProperties.Name="Resumen del reporte">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="225" Background="White" BorderBrush="#D5DFEB" BorderThickness="1"
                                    CornerRadius="5" Padding="10,8" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="#63758B" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Value}" Foreground="#173F78" FontSize="20"
                                               FontWeight="Bold" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#63758B" FontSize="10"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DataGrid x:Name="ReportGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserReorderColumns="True" CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  RowHeaderWidth="0" HeadersVisibility="Column" SelectionMode="Extended" AutomationProperties.Name="Datos del reporte"/>

        <TextBlock Grid.Row="5" x:Name="StatusText" Foreground="#52677F" Margin="0,9,0,0" TextWrapping="Wrap"/>

        <Popup x:Name="ColumnPickerPopup" Grid.Row="2" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="280" MaxHeight="480" Background="White" BorderBrush="#9BAFC8" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="COLUMNAS VISIBLES" Foreground="#173F78" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ColumnPickerPanel"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="La tabla y las exportaciones usan las columnas marcadas." Foreground="#63758B" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
