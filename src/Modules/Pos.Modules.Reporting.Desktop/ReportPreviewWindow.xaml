<Window x:Class="Pos.Modules.Reporting.Desktop.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista de hoja del reporte" Width="1280" Height="850"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="#EEF2F7">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D5DFEB" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ReportCommerceText" Text="BALANZAPRO" Foreground="#247148"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="ReportTitleText" Text="Reporte" Foreground="#173F78"
                                   FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ReportDetailsText" Foreground="#63758B" Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Imprimir / guardar PDF" Height="38" Padding="16,0"
                            Margin="16,0,0,0" Click="Print_Click" AutomationProperties.Name="Imprimir o guardar el reporte como PDF"
                            ToolTip="En la ventana de impresión puedes elegir Microsoft Print to PDF para guardar el archivo."/>
                </Grid>
                <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
                    <TextBlock Text="Papel" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,7,0"/>
                    <ComboBox x:Name="PaperSizePicker" Width="130" Height="30" SelectedIndex="0"
                              SelectionChanged="PageLayout_Changed" AutomationProperties.Name="Tamaño del papel">
                        <ComboBoxItem Content="Carta" Tag="letter"/>
                        <ComboBoxItem Content="Oficio" Tag="oficio"/>
                        <ComboBoxItem Content="A4" Tag="a4"/>
                    </ComboBox>
                    <TextBlock Text="Orientación" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,7,0"/>
                    <ComboBox x:Name="OrientationPicker" Width="150" Height="30" SelectedIndex="0"
                              SelectionChanged="PageLayout_Changed" AutomationProperties.Name="Orientación de la hoja">
                        <ComboBoxItem Content="Horizontal" Tag="landscape"/>
                        <ComboBoxItem Content="Vertical" Tag="portrait"/>
                    </ComboBox>
                    <TextBlock Text="Puedes ajustar la hoja antes de imprimir." Foreground="#63758B"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="4">
            <FlowDocumentReader x:Name="ReportDocumentViewer" ViewingMode="Page" Background="#DCE3EC"
                                AutomationProperties.Name="Vista paginada del reporte"/>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#52677F" Margin="2,8,2,0"
                   Text="Para crear un PDF, elige Microsoft Print to PDF en la ventana de impresión." TextWrapping="Wrap"/>
    </Grid>
</Window>
