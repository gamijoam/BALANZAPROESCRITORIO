<Window x:Class="Pos.Modules.Finance.Desktop.FinanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compras, proveedores y cuentas por pagar" Width="1360" Height="900"
        MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterOwner"
        Background="#EEF3F8" Loaded="Window_Loaded" Language="es-VE">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F8FC"/><Setter Property="BorderBrush" Value="#D7E0EB"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="18" CornerRadius="8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="COMPRAS Y FINANZAS" FontSize="23" FontWeight="Bold" Foreground="#17395F"/>
                <TextBlock Text="Registra compras, controla lo recibido y consulta las obligaciones con proveedores." Foreground="#61758D" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="FinanceTabs" Grid.Row="1" Background="White" Padding="8">
            <TabItem x:Name="SuppliersTab" Header="Proveedores">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Directorio de proveedores" FontSize="17" FontWeight="SemiBold" Foreground="#17395F" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SupplierCodeBox" Grid.Column="0" MaxLength="32" ToolTip="Código" Margin="0,0,7,0"/>
                        <TextBox x:Name="SupplierNameBox" Grid.Column="1" MaxLength="160" ToolTip="Razón social" Margin="0,0,7,0"/>
                        <TextBox x:Name="SupplierTaxIdBox" Grid.Column="2" MaxLength="80" ToolTip="RIF o documento" Margin="0,0,7,0"/>
                        <TextBox x:Name="SupplierPhoneBox" Grid.Column="3" MaxLength="64" ToolTip="Teléfono" Margin="0,0,7,0"/>
                        <TextBox x:Name="SupplierEmailBox" Grid.Column="4" MaxLength="160" ToolTip="Correo" Margin="0,0,7,0"/>
                        <Button x:Name="CreateSupplierButton" Grid.Column="5" Content="Agregar proveedor" Background="#2E64B7" Foreground="White" Click="CreateSupplier_Click"/>
                    </Grid>
                    <DataGrid x:Name="SupplierGrid" Grid.Row="2" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SupplierGrid_SelectionChanged" AutomationProperties.Name="Proveedores">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="130"/>
                            <DataGridTextColumn Header="Razón social" Binding="{Binding LegalName}" Width="2*"/>
                            <DataGridTextColumn Header="RIF / documento" Binding="{Binding TaxId}" Width="150"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="150"/>
                            <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Actualizar" Click="RefreshSuppliers_Click"/>
                        <Button x:Name="ToggleSupplierButton" Content="Activar / desactivar seleccionado" Click="ToggleSupplier_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="PurchasesTab" Header="Facturas y cuentas por pagar">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Facturas de compra" FontSize="17" FontWeight="SemiBold" Foreground="#17395F" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Actualizar" Click="RefreshPurchases_Click"/>
                            <Button x:Name="EditDraftButton" Content="Editar borrador" Click="EditDraft_Click"/>
                            <Button x:Name="NewDraftButton" Content="Nueva factura" Background="#2E64B7" Foreground="White" Click="NewDraft_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="PurchaseGrid" Grid.Column="0" SelectionChanged="PurchaseGrid_SelectionChanged" AutomationProperties.Name="Facturas de compra">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding IssueDate}" Width="100"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="125"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat=N2}" Width="105"/>
                                <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D7E0EB"/>
                        <GroupBox Grid.Column="2" Header="Detalle de la factura seleccionada" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="76"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                                <TextBlock x:Name="PurchaseSummaryLabel" Grid.Row="0" Text="Selecciona una factura para ver su detalle y operaciones." Foreground="#61758D" TextWrapping="Wrap" Margin="3,2,3,7"/>
                                <DataGrid x:Name="PurchaseDetailsGrid" Grid.Row="1" AutomationProperties.Name="Líneas de factura">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="90"/>
                                        <DataGridTextColumn Header="Artículo" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat=N3}" Width="85"/>
                                        <DataGridTextColumn Header="Recibido" Binding="{Binding ReceivedQuantity, StringFormat=N3}" Width="85"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PaymentHistoryLabel" Grid.Row="2" Foreground="#61758D" TextWrapping="Wrap" Margin="3,7,3,0"/>
                                <DataGrid x:Name="PaymentsGrid" Grid.Row="3" SelectionChanged="RelatedSelectionChanged" AutomationProperties.Name="Abonos de la factura seleccionada">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding PaidAtUtc, StringFormat=g}" Width="130"/>
                                        <DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="65"/>
                                        <DataGridTextColumn Header="Medio" Binding="{Binding Method}" Width="*"/>
                                        <DataGridTextColumn Header="Anulado" Binding="{Binding ReversedAtUtc, StringFormat=g}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ReceiptsGrid" Grid.Row="4" SelectionChanged="RelatedSelectionChanged" AutomationProperties.Name="Recepciones de la factura seleccionada">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Recibido" Binding="{Binding Header.CreatedAtUtc, StringFormat=g}" Width="145"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Header.StatusLabel}" Width="105"/>
                                        <DataGridTextColumn Header="Clave" Binding="{Binding Header.IdempotencyKey}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                    <GroupBox x:Name="DraftEditor" Grid.Row="2" Header="Borrador de compra · el inventario y la deuda cambian al contabilizar / recibir" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DraftSupplierPicker" Grid.Column="0" DisplayMemberPath="LegalName" ToolTip="Proveedor" Margin="0,0,7,0"/>
                                    <ComboBox x:Name="DraftDocumentTypePicker" Grid.Column="1" Width="112" SelectedIndex="0" Margin="0,0,7,0">
                                        <ComboBoxItem Content="Factura" Tag="Invoice"/><ComboBoxItem Content="Nota débito" Tag="DebitNote"/>
                                    </ComboBox>
                                    <TextBox x:Name="DraftDocumentNumberBox" Grid.Column="2" MaxLength="80" ToolTip="Número de documento" Margin="0,0,7,0"/>
                                    <TextBox x:Name="DraftControlNumberBox" Grid.Column="3" MaxLength="80" ToolTip="Número de control (opcional)" Margin="0,0,7,0"/>
                                    <ComboBox x:Name="DraftCurrencyPicker" Grid.Column="4" Width="84" SelectedIndex="0" SelectionChanged="DraftCurrencyPicker_SelectionChanged" Margin="0,0,7,0"><ComboBoxItem Content="USD"/><ComboBoxItem Content="VES"/></ComboBox>
                                    <TextBox x:Name="DraftExchangeRateBox" Grid.Column="5" Text="1" ToolTip="Tasa USD/VES de la factura"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Emisión" VerticalAlignment="Center" Margin="0,0,7,0"/><DatePicker x:Name="DraftIssueDatePicker" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2" Text="Vence" VerticalAlignment="Center" Margin="12,0,7,0"/><DatePicker x:Name="DraftDueDatePicker" Grid.Column="3"/>
                                    <TextBlock Grid.Column="4" Text="Flete facturado" VerticalAlignment="Center" Margin="12,0,7,0"/><TextBox x:Name="DraftFreightBox" Grid.Column="5" Text="0" TextChanged="DraftFreightBox_TextChanged"/>
                                    <ComboBox x:Name="DraftPaymentTermPicker" Grid.Column="7" SelectedIndex="0" Margin="8,0,0,0"><ComboBoxItem Content="Crédito" Tag="Credit"/><ComboBoxItem Content="Contado" Tag="Immediate"/></ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="85"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DraftProductPicker" Grid.Column="0" DisplayMemberPath="Name" IsEditable="True" ToolTip="Busca y selecciona un producto" Margin="0,0,7,0"/>
                                    <Button x:Name="SearchProductsButton" Grid.Column="1" Content="Buscar artículos" Click="SearchProducts_Click" Margin="0,0,7,0"/>
                                    <TextBox x:Name="DraftQuantityBox" Grid.Column="2" Text="1" ToolTip="Cantidad" Margin="0,0,6,0"/>
                                    <TextBox x:Name="DraftUnitPriceBox" Grid.Column="3" ToolTip="Precio unitario de factura" Margin="0,0,6,0"/>
                                    <TextBox x:Name="DraftDiscountBox" Grid.Column="4" Text="0" ToolTip="Descuento total de línea" Margin="0,0,6,0"/>
                                    <TextBox x:Name="DraftTaxBox" Grid.Column="5" Text="0" ToolTip="Impuesto de esta línea" Margin="0,0,6,0"/>
                                    <CheckBox x:Name="DraftTaxRecoverableCheck" Grid.Column="6" Content="Impuesto recuperable" IsChecked="True" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Button Grid.Column="7" Content="Agregar línea" Click="AddDraftLine_Click"/>
                                </Grid>
                                <DataGrid x:Name="DraftLinesGrid" Height="126" IsReadOnly="True" AutomationProperties.Name="Artículos de la factura en borrador">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="110"/>
                                        <DataGridTextColumn Header="Artículo" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat=N3}" Width="100"/>
                                        <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat=N2}" Width="105"/>
                                        <DataGridTextColumn Header="Descuento" Binding="{Binding Discount, StringFormat=N2}" Width="105"/>
                                        <DataGridTextColumn Header="Impuesto" Binding="{Binding Tax, StringFormat=N2}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DraftTotalLabel" Grid.Column="0" Text="Total: 0,00" FontSize="15" FontWeight="Bold" Foreground="#17395F" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveDraftButton" Grid.Column="1" Content="Guardar borrador" Click="SaveDraft_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                        <Button x:Name="PostSelectedPurchaseButton" Content="Contabilizar factura seleccionada" Click="PostPurchase_Click"/>
                        <Button x:Name="ReceiveSelectedPurchaseButton" Content="Registrar recepción" Click="ReceivePurchase_Click"/>
                        <Button x:Name="PaySelectedPurchaseButton" Content="Registrar abono" Click="PayPurchase_Click"/>
                        <Button x:Name="ReverseReceiptButton" Content="Reversar recepción seleccionada" Click="ReverseReceipt_Click"/>
                        <Button x:Name="ReversePaymentButton" Content="Reversar abono seleccionado" Click="ReversePayment_Click"/>
                        <Button x:Name="ReversePurchaseButton" Content="Reversar factura" Click="ReversePurchase_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="SummaryTab" Header="Resumen preliminar">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><TextBlock Text="Cuentas por pagar" FontSize="18" FontWeight="SemiBold" Foreground="#17395F" VerticalAlignment="Center"/><Button Content="Actualizar resumen" DockPanel.Dock="Right" Click="RefreshSummary_Click"/></DockPanel>
                    <DataGrid x:Name="SummaryGrid" Grid.Row="1" AutomationProperties.Name="Resumen preliminar de cuentas por pagar">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="120"/>
                            <DataGridTextColumn Header="Saldo pendiente" Binding="{Binding Amount, StringFormat=N2}" Width="200"/>
                            <DataGridTextColumn Header="Facturas pendientes" Binding="{Binding Invoices}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="FinanceStatus" Grid.Row="2" Text="Listo." Foreground="#61758D" Margin="4,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
