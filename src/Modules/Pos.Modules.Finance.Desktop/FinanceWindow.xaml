<Window x:Class="Pos.Modules.Finance.Desktop.FinanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compras, proveedores y cuentas por pagar" Width="1480" Height="900"
        MinWidth="1080" MinHeight="680" WindowState="Maximized" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#EEF3F8" Loaded="Window_Loaded" Language="es-VE">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F8FC"/><Setter Property="BorderBrush" Value="#D7E0EB"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="18" CornerRadius="8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="COMPRAS Y FINANZAS" FontSize="23" FontWeight="Bold" Foreground="#17395F"/>
                <TextBlock Text="Registra compras, controla lo recibido y consulta las obligaciones con proveedores." Foreground="#61758D" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="FinanceTabs" Grid.Row="1" Background="White" Padding="8">
            <TabItem x:Name="SuppliersTab" Header="Proveedores">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Directorio de proveedores" FontSize="17" FontWeight="SemiBold" Foreground="#17395F"/>
                        <TextBlock Text="Completa los datos identificados debajo. El código y el nombre son obligatorios." Foreground="#61758D" Margin="0,3,0,0"/>
                    </StackPanel>
                    <GroupBox Grid.Row="1" Header="Datos del proveedor" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Columns="3">
                                <StackPanel Margin="4"><TextBlock x:Name="SupplierCodeLabel" Text="Código del proveedor" Margin="0,0,0,4"/><TextBox x:Name="SupplierCodeBox" MaxLength="32" ToolTip="Identificador corto, por ejemplo PROV-001"/></StackPanel>
                                <StackPanel Margin="4"><TextBlock x:Name="SupplierNameLabel" Text="Nombre o razón social" Margin="0,0,0,4"/><TextBox x:Name="SupplierNameBox" MaxLength="160" ToolTip="Nombre legal o comercial del proveedor"/></StackPanel>
                                <StackPanel Margin="4"><TextBlock x:Name="SupplierTaxIdLabel" Text="RIF o documento" Margin="0,0,0,4"/><TextBox x:Name="SupplierTaxIdBox" MaxLength="80"/></StackPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Row="1" Columns="3">
                                <StackPanel Margin="4"><TextBlock x:Name="SupplierPhoneLabel" Text="Teléfono" Margin="0,0,0,4"/><TextBox x:Name="SupplierPhoneBox" MaxLength="64"/></StackPanel>
                                <StackPanel Margin="4"><TextBlock x:Name="SupplierEmailLabel" Text="Correo" Margin="0,0,0,4"/><TextBox x:Name="SupplierEmailBox" MaxLength="160"/></StackPanel>
                                <StackPanel Margin="4"><TextBlock x:Name="SupplierAddressLabel" Text="Dirección" Margin="0,0,0,4"/><TextBox x:Name="SupplierAddressBox" MaxLength="300"/></StackPanel>
                            </UniformGrid>
                            <Button x:Name="CreateSupplierButton" Grid.Row="2" Content="Agregar proveedor" HorizontalAlignment="Right" Background="#2E64B7" Foreground="White" Click="CreateSupplier_Click" Margin="4,8,4,0"/>
                        </Grid>
                    </GroupBox>
                    <DataGrid x:Name="SupplierGrid" Grid.Row="2" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SupplierGrid_SelectionChanged" AutomationProperties.Name="Proveedores">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="130"/>
                            <DataGridTextColumn Header="Razón social" Binding="{Binding LegalName}" Width="2*"/>
                            <DataGridTextColumn Header="RIF / documento" Binding="{Binding TaxId}" Width="150"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="150"/>
                            <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Actualizar" Click="RefreshSuppliers_Click"/>
                        <Button x:Name="ToggleSupplierButton" Content="Activar / desactivar seleccionado" Click="ToggleSupplier_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="PurchasesTab" Header="Facturas y cuentas por pagar">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Facturas de compra" FontSize="17" FontWeight="SemiBold" Foreground="#17395F" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Actualizar" Click="RefreshPurchases_Click"/>
                            <Button x:Name="EditDraftButton" Content="Editar borrador" Click="EditDraft_Click"/>
                            <Button x:Name="NewDraftButton" Content="Nueva factura" Background="#2E64B7" Foreground="White" Click="NewDraft_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="PurchaseGrid" Grid.Column="0" SelectionChanged="PurchaseGrid_SelectionChanged" AutomationProperties.Name="Facturas de compra">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding IssueDate}" Width="100"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="Documento" Binding="{Binding DocumentNumber}" Width="125"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="115"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat=N2}" Width="105"/>
                                <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D7E0EB"/>
                        <GroupBox Grid.Column="2" Header="Detalle de la factura seleccionada" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="76"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                                <TextBlock x:Name="PurchaseSummaryLabel" Grid.Row="0" Text="Selecciona una factura para ver su detalle y operaciones." Foreground="#61758D" TextWrapping="Wrap" Margin="3,2,3,7"/>
                                <DataGrid x:Name="PurchaseDetailsGrid" Grid.Row="1" AutomationProperties.Name="Líneas de factura">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="90"/>
                                        <DataGridTextColumn Header="Artículo" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat=0.###}" Width="85"/>
                                        <DataGridTextColumn Header="Recibido" Binding="{Binding ReceivedQuantity, StringFormat=0.###}" Width="85"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="PaymentHistoryLabel" Grid.Row="2" Foreground="#61758D" TextWrapping="Wrap" Margin="3,7,3,0"/>
                                <DataGrid x:Name="PaymentsGrid" Grid.Row="3" SelectionChanged="RelatedSelectionChanged" AutomationProperties.Name="Abonos de la factura seleccionada">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding PaidAtUtc, StringFormat=g}" Width="130"/>
                                        <DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="65"/>
                                        <DataGridTextColumn Header="Medio" Binding="{Binding Method}" Width="*"/>
                                        <DataGridTextColumn Header="Anulado" Binding="{Binding ReversedAtUtc, StringFormat=g}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid x:Name="ReceiptsGrid" Grid.Row="4" SelectionChanged="RelatedSelectionChanged" AutomationProperties.Name="Recepciones de la factura seleccionada">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Recibido" Binding="{Binding Header.CreatedAtUtc, StringFormat=g}" Width="145"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Header.StatusLabel}" Width="105"/>
                                        <DataGridTextColumn Header="Clave" Binding="{Binding Header.IdempotencyKey}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                    <GroupBox x:Name="DraftEditor" Grid.Row="2" Header="Borrador de compra · el inventario y la deuda cambian al contabilizar / recibir" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Datos de la factura" FontSize="15" FontWeight="SemiBold" Foreground="#17395F" Margin="2,0,0,5"/>
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftSupplierLabel" Text="Proveedor" Margin="0,0,0,4"/><ComboBox x:Name="DraftSupplierPicker" DisplayMemberPath="LegalName" ToolTip="Selecciona el proveedor de esta factura"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftDocumentTypeLabel" Text="Tipo de documento" Margin="0,0,0,4"/><ComboBox x:Name="DraftDocumentTypePicker" SelectedIndex="0"><ComboBoxItem Content="Factura" Tag="Invoice"/><ComboBoxItem Content="Nota de débito" Tag="DebitNote"/></ComboBox></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftDocumentNumberLabel" Text="Número de factura" Margin="0,0,0,4"/><TextBox x:Name="DraftDocumentNumberBox" MaxLength="80" ToolTip="Número que aparece en la factura del proveedor"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftControlNumberLabel" Text="Número de control" Margin="0,0,0,4"/><TextBox x:Name="DraftControlNumberBox" MaxLength="80" ToolTip="Dato opcional impreso en el documento"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftCurrencyLabel" Text="Moneda" Margin="0,0,0,4"/><ComboBox x:Name="DraftCurrencyPicker" SelectedIndex="0" SelectionChanged="DraftCurrencyPicker_SelectionChanged"><ComboBoxItem Content="USD"/><ComboBoxItem Content="VES"/></ComboBox></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftExchangeRateLabel" Text="Tasa de cambio" Margin="0,0,0,4"/><TextBox x:Name="DraftExchangeRateBox" Text="1" ToolTip="Bolívares por dólar usados en esta factura"/></StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="4" Margin="0,0,0,6">
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftIssueDateLabel" Text="Fecha de emisión" Margin="0,0,0,4"/><DatePicker x:Name="DraftIssueDatePicker"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftDueDateLabel" Text="Fecha de vencimiento" Margin="0,0,0,4"/><DatePicker x:Name="DraftDueDatePicker"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftFreightLabel" Text="Flete facturado" Margin="0,0,0,4"/><TextBox x:Name="DraftFreightBox" Text="0" TextChanged="DraftFreightBox_TextChanged"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftPaymentTermLabel" Text="Condición de pago" Margin="0,0,0,4"/><ComboBox x:Name="DraftPaymentTermPicker" SelectedIndex="0"><ComboBoxItem Content="Crédito" Tag="Credit"/><ComboBoxItem Content="Contado" Tag="Immediate"/></ComboBox></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Agregar artículo a la factura" FontSize="15" FontWeight="SemiBold" Foreground="#17395F" Margin="2,4,0,5"/>
                                <UniformGrid Columns="4" Margin="0,0,0,8">
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftProductLabel" Text="Artículo" Margin="0,0,0,4"/><DockPanel><Button x:Name="SearchProductsButton" DockPanel.Dock="Right" Content="Buscar" Click="SearchProducts_Click"/><ComboBox x:Name="DraftProductPicker" DisplayMemberPath="Name" IsEditable="True" ToolTip="Busca y selecciona un artículo"/></DockPanel></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftQuantityLabel" Text="Cantidad" Margin="0,0,0,4"/><TextBox x:Name="DraftQuantityBox" Text="1"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftUnitPriceLabel" Text="Precio unitario" Margin="0,0,0,4"/><TextBox x:Name="DraftUnitPriceBox" ToolTip="Precio unitario que indica la factura"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftDiscountLabel" Text="Descuento" Margin="0,0,0,4"/><TextBox x:Name="DraftDiscountBox" Text="0" ToolTip="Descuento total de esta línea"/></StackPanel>
                                    <StackPanel Margin="4"><TextBlock x:Name="DraftTaxLabel" Text="Impuesto" Margin="0,0,0,4"/><TextBox x:Name="DraftTaxBox" Text="0" ToolTip="Importe de impuesto de esta línea"/></StackPanel>
                                    <StackPanel Margin="4" VerticalAlignment="Bottom"><TextBlock Text="Tratamiento del impuesto" Margin="0,0,0,4"/><CheckBox x:Name="DraftTaxRecoverableCheck" Content="Impuesto recuperable" IsChecked="True" VerticalAlignment="Center" Height="34"/></StackPanel>
                                    <StackPanel Margin="4" VerticalAlignment="Bottom"><TextBlock Text="Agregar artículo" Margin="0,0,0,4"/><Button Content="Agregar línea" Click="AddDraftLine_Click"/></StackPanel>
                                </UniformGrid>
                                <DataGrid x:Name="DraftLinesGrid" Height="168" IsReadOnly="True" AutomationProperties.Name="Artículos de la factura en borrador">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="110"/>
                                        <DataGridTextColumn Header="Artículo" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, StringFormat=0.###}" Width="100"/>
                                        <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat=N2}" Width="105"/>
                                        <DataGridTextColumn Header="Descuento" Binding="{Binding Discount, StringFormat=N2}" Width="105"/>
                                        <DataGridTextColumn Header="Impuesto" Binding="{Binding Tax, StringFormat=N2}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DraftTotalLabel" Grid.Column="0" Text="Total: 0,00" FontSize="15" FontWeight="Bold" Foreground="#17395F" VerticalAlignment="Center"/>
                                    <Button x:Name="SaveDraftButton" Grid.Column="1" Content="Guardar borrador" Click="SaveDraft_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,7,0,0">
                        <Button x:Name="PostSelectedPurchaseButton" Content="Contabilizar factura seleccionada" Click="PostPurchase_Click"/>
                        <Button x:Name="ReceiveSelectedPurchaseButton" Content="Registrar recepción" Click="ReceivePurchase_Click"/>
                        <Button x:Name="PaySelectedPurchaseButton" Content="Registrar abono" Click="PayPurchase_Click"/>
                        <Button x:Name="ReverseReceiptButton" Content="Reversar recepción seleccionada" Click="ReverseReceipt_Click"/>
                        <Button x:Name="ReversePaymentButton" Content="Reversar abono seleccionado" Click="ReversePayment_Click"/>
                        <Button x:Name="ReversePurchaseButton" Content="Reversar factura" Click="ReversePurchase_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="SummaryTab" Header="Resumen preliminar">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10"><StackPanel><TextBlock Text="Cuentas por pagar" FontSize="18" FontWeight="SemiBold" Foreground="#17395F"/><TextBlock Text="Cada fila muestra el proveedor, el documento y los abonos que explican el saldo pendiente." Foreground="#61758D" Margin="0,3,0,0"/></StackPanel><Button Content="Actualizar resumen" DockPanel.Dock="Right" Click="RefreshSummary_Click"/></DockPanel>
                    <DataGrid x:Name="SummaryGrid" Grid.Row="1" Margin="0,0,0,12" AutomationProperties.Name="Totales de cuentas por pagar por moneda">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="120"/>
                            <DataGridTextColumn Header="Deuda total pendiente" Binding="{Binding Amount, StringFormat=N2}" Width="220"/>
                            <DataGridTextColumn Header="Facturas pendientes" Binding="{Binding Invoices}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Detalle de cada deuda abierta" FontSize="16" FontWeight="SemiBold" Foreground="#17395F" Margin="0,0,0,8"/>
                    <Grid Grid.Row="3">
                        <DataGrid x:Name="OpenPayablesGrid" AutomationProperties.Name="Detalle de deudas pendientes por proveedor y factura">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="2*"/>
                                <DataGridTextColumn Header="Documento" Binding="{Binding DocumentLabel}" Width="1.5*"/>
                                <DataGridTextColumn Header="Emisión" Binding="{Binding IssueDate}" Width="100"/>
                                <DataGridTextColumn Header="Vence" Binding="{Binding DueDateLabel}" Width="100"/>
                                <DataGridTextColumn Header="Importe" Binding="{Binding InvoiceAmount, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Pagado" Binding="{Binding PaidAmount, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Saldo pendiente" Binding="{Binding Balance, StringFormat=N2}" Width="140"/>
                                <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="75"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="OpenPayablesEmptyLabel" Text="No hay facturas con saldo pendiente." Foreground="#61758D" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="FinanceStatus" Grid.Row="2" Text="Listo." Foreground="#61758D" Margin="4,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
