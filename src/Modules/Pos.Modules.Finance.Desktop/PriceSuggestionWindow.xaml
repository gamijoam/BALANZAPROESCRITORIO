<Window x:Class="Pos.Modules.Finance.Desktop.PriceSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Precios sugeridos" Width="1050" Height="700" MinWidth="820" MinHeight="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{StaticResource PosWindow.Background}" Language="es-VE"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource PosWindow.BaseButton}">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource PosWindow.BaseDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="44"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#D5DFEB"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#102D50" CornerRadius="9" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Precios sugeridos" FontSize="21" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="InvoiceLabel" Text="Factura" Foreground="#D7E3F2" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#E2ECF8" BorderBrush="#CAD9EB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="CostBasisSummary" Text="Costo base: promedio ponderado" FontWeight="SemiBold" Foreground="#132D4F" TextWrapping="Wrap"/>
                <TextBlock x:Name="SuggestionStatus" Text="Calculando propuestas…" TextWrapping="Wrap" Foreground="#52677F" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <DataGrid x:Name="SuggestionsGrid" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SuggestionsGrid_SelectionChanged" AutomationProperties.Name="Propuestas de precio por producto y nivel">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="110"/>
                    <DataGridTextColumn Header="Artículo" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Nivel" Binding="{Binding PriceTierLabel}" Width="95"/>
                    <DataGridTextColumn Header="Costo utilizado" Binding="{Binding CostLabel}" Width="135"/>
                    <DataGridTextColumn Header="Origen del costo" Binding="{Binding CostSourceLabel}" Width="200"/>
                    <DataGridTextColumn Header="Margen" Binding="{Binding MarginLabel}" Width="90"/>
                    <DataGridTextColumn Header="Precio actual" Binding="{Binding CurrentPriceLabel}" Width="140"/>
                    <DataGridTextColumn Header="Precio sugerido" Binding="{Binding SuggestedPriceLabel}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="SuggestionsEmptyLabel" Text="No hay propuestas disponibles para esta factura." Foreground="#52677F" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Selecciona una propuesta y confirma. El servicio comprobará que el costo de inventario y el precio actual no hayan cambiado." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#52677F" Margin="3,0,8,0"/>
            <Button x:Name="CloseButton" Grid.Column="1" Content="Cerrar" IsCancel="True"/>
            <Button x:Name="ApplySuggestionButton" Grid.Column="2" Content="Confirmar precio seleccionado" IsEnabled="False" Click="ApplySuggestion_Click" Background="#0867D5" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
